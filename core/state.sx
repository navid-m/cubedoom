val sdl = use("sdl.sx")

pub extern type Player = {
    x: mut f32
    y: mut f32
    dirX: mut f32
    dirY: mut f32
    planeX: mut f32
    planeY: mut f32
    w: mut f32
    h: mut f32
    speed: mut f32
    rotSpeed: mut f32
}

pub extern type Enemy = {
    x: mut f32
    y: mut f32
    health: mut i32
    alive: mut i32
    shootTimer: mut f32
}

pub extern type Bullet = {
    x: mut f32
    y: mut f32
    dx: mut f32
    dy: mut f32
    alive: mut i32
    isPlayer: mut i32
    animTime: mut f32
    damage: mut i32
    weapon: mut i32
}

pub type WallTexture = {
    tex: mut ref void
    w: mut i32
    h: mut i32
}

pub type TextureSize = {
    w: mut i32
    h: mut i32
}

pub type SpawnPoint = {
    x: mut f32
    y: mut f32
}

pub type BrushBounds = {
    minX: mut f32
    minY: mut f32
    minZ: mut f32
    maxX: mut f32
    maxY: mut f32
    maxZ: mut f32
    hasFace: mut bool
    texture: [128]u8
}

pub type Tree = {
    x: mut f32
    y: mut f32
    scale: mut f32
}

pub type HealthPickup = {
    x: mut f32
    y: mut f32
    active: mut i32
    respawn: mut f32
    bob: mut f32
}

pub type XpOrb = {
    x: mut f32
    y: mut f32
    value: mut i32
    active: mut i32
    phase: mut f32
}

pub type Progress = {
    magic: mut u32
    version: mut u32
    checksum: mut u32
    bestWave: mut i32
    xp: mut i32
    totalXp: mut i32
    shotgun: mut i32
    plasma: mut i32
    healthLevel: mut i32
    damageLevel: mut i32
    fireRateLevel: mut i32
    speedLevel: mut i32
}

pub type Star = {
    angle: mut f32
    altitude: mut f32
    brightness: mut f32
    phase: mut f32
}

pub type Billboard = {
    kind: mut i32
    index: mut i32
    distance: mut f32
}

pub type WallSpan = {
    active: mut i32
    start_x: mut i32
    end_x: mut i32
    cell_x: mut i32
    cell_y: mut i32
    side: mut i32
    face_sign: mut i32
}

pub type ColumnInfo = {
    top: mut f32
    bottom: mut f32
    tex: mut f32
    shade: mut u8
}

pub type Game = {
    map: mut [32][32]i32
    wallTextures: mut [3]WallTexture
    enemySpawns: mut [10]SpawnPoint
    player: mut Player
    playerHealth: mut i32
