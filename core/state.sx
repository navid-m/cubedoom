pub fn game() mut ref Game = {
    return @addr(gameData)
}

pub fn get_enemy(i: i32) mut ref Enemy = {
    return trust @ptradd(gameData.enemies_buf, (i as usize) * @sizeof(Enemy)) as mut ref Enemy
}

pub fn get_bullet(i: i32) mut ref Bullet = {
    return trust @ptradd(gameData.bullets_buf, (i as usize) * @sizeof(Bullet)) as mut ref Bullet
}

pub fn wall_texture(index: i32) mut ref WallTexture = {
    return trust @ptradd(
        gameData.wallTextures as ref WallTexture,
        (index as usize) * @sizeof(WallTexture)
    ) as mut ref WallTexture
}

pub fn enemy_spawn(index: i32) mut ref SpawnPoint = {
    return trust @ptradd(
        gameData.enemySpawns as ref SpawnPoint,
        (index as usize) * @sizeof(SpawnPoint)
    ) as mut ref SpawnPoint
}

pub fn column_info(index: i32) mut ref ColumnInfo = {
    return trust @ptradd(
        gameData.g_columns,
        (index as usize) * @sizeof(ColumnInfo)
    ) as mut ref ColumnInfo
}

pub fn vertex_at(index: i32) mut ref sdl.SDL_Vertex = {
    return trust @ptradd(
        gameData.g_vertices,
        (index as usize) * @sizeof(sdl.SDL_Vertex)
    ) as mut ref sdl.SDL_Vertex
}

pub fn write_index(index: i32, value: i32) void = trust {
    @store32(
        @ptradd(gameData.g_indices, (index as usize) * @sizeof(i32)) as ref u32,
        value as u32
    )
}

pub fn tree_at(index: i32) mut ref Tree = {
    return trust @ptradd(
        gameData.trees as ref Tree,
        (index as usize) * @sizeof(Tree)
    ) as mut ref Tree
}

pub fn pickup_at(index: i32) mut ref HealthPickup = {
    return trust @ptradd(
        gameData.healthPickups as ref HealthPickup,
        (index as usize) * @sizeof(HealthPickup)
    ) as mut ref HealthPickup
}

pub fn xp_orb_at(index: i32) mut ref XpOrb = {
    return trust @ptradd(
        gameData.xpOrbs as ref XpOrb,
        (index as usize) * @sizeof(XpOrb)
    ) as mut ref XpOrb
}

pub fn star_at(index: i32) mut ref Star = {
    return trust @ptradd(
        gameData.stars as ref Star,
        (index as usize) * @sizeof(Star)
    ) as mut ref Star
}

pub fn billboard_at(list: ref Billboard, index: i32) mut ref Billboard = {
    return trust @ptradd(
        list as ref Billboard,
        (index as usize) * @sizeof(Billboard)
    ) as mut ref Billboard
}
