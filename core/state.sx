    shotgunReloadStage: mut i32
    relativeMouseMode: mut i32
    quitRequested: mut bool
    g_shootShotgunSound: mut ref void
    g_shootPlasmaSound: mut ref void
    g_switchMachineSound: mut ref void
    g_switchShotgunSound: mut ref void
    g_switchPlasmaSound: mut ref void
    g_reloadShotgun1Sound: mut ref void
    g_reloadShotgun2Sound: mut ref void
    g_jumpSound: mut ref void
    g_xpSound: mut ref void
    g_buySound: mut ref void
