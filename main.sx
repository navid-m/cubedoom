fn get_enemy(i: i32) mut ref Enemy = {
    return trust @ptradd(enemies_buf, (i as usize) * @sizeof(Enemy)) as mut ref Enemy
}

fn get_bullet(i: i32) mut ref Bullet = {
    return trust @ptradd(bullets_buf, (i as usize) * @sizeof(Bullet)) as mut ref Bullet
}

fn wall_texture(index: i32) mut ref WallTexture = {
    return trust @ptradd(
        wallTextures as ref WallTexture,
        (index as usize) * @sizeof(WallTexture)
    ) as mut ref WallTexture
}

fn enemy_spawn(index: i32) mut ref SpawnPoint = {
    return trust @ptradd(
        enemySpawns as ref SpawnPoint,
        (index as usize) * @sizeof(SpawnPoint)
    ) as mut ref SpawnPoint
}

fn tree_at(index: i32) mut ref Tree = {
    return trust @ptradd(trees as ref Tree, (index as usize) * @sizeof(Tree)) as mut ref Tree
}

fn pickup_at(index: i32) mut ref HealthPickup = {
    return trust @ptradd(
        healthPickups as ref HealthPickup,
        (index as usize) * @sizeof(HealthPickup)
    ) as mut ref HealthPickup
}

fn star_at(index: i32) mut ref Star = {
    return trust @ptradd(stars as ref Star, (index as usize) * @sizeof(Star)) as mut ref Star
}

fn billboard_at(list: ref Billboard, index: i32) mut ref Billboard = {
    return trust @ptradd(
        list as ref Billboard,
        (index as usize) * @sizeof(Billboard)
    ) as mut ref Billboard
}

fn rand_next() u32 = {
    rng = rng * 1664525 as u32 + 1013904223 as u32
    return rng
}

fn rand_unit() f32 = {
    return ((rand_next() % 10000) as f32) / 10000.0
}

fn play_sound(sound: ref void) void = {
    if sound != none {
        trust Mix_PlayChannel(-1 as i32, sound, 0 as i32)
    }
}

fn rotate_player(angle: f32) void = trust {
    val oldDirX: f32 = player.dirX
    player.dirX = player.dirX * cosf(angle) - player.dirY * sinf(angle)
    player.dirY = oldDirX * sinf(angle) + player.dirY * cosf(angle)

    val oldPlaneX: f32 = player.planeX
    player.planeX = player.planeX * cosf(angle) - player.planeY * sinf(angle)
    player.planeY = oldPlaneX * sinf(angle) + player.planeY * cosf(angle)
}

fn try_move_player(dx: f32, dy: f32) void = {
    val moveY0: i32 = ((player.y + 4.0) / (TILE_SIZE as f32)) as i32
    val moveX0: i32 = ((player.x + 4.0 + dx) / (TILE_SIZE as f32)) as i32
    if map_at(moveX0, moveY0) == 0 {
        player.x += dx
    }

    val moveY1: i32 = ((player.y + 4.0 + dy) / (TILE_SIZE as f32)) as i32
    val moveX1: i32 = ((player.x + 4.0) / (TILE_SIZE as f32)) as i32
    if map_at(moveX1, moveY1) == 0 {
        player.y += dy
    }
}

fn map_at(x: i32, y: i32) i32 = {
    if x < 0 || x >= MAP_SIZE || y < 0 || y >= MAP_SIZE {
        return 1
    }
    return trust @load32(@ptradd(
            map as ref i32,
            ((y * MAP_SIZE + x) as usize) * @sizeof(i32)
        ) as ref u32) as i32
}

fn map_set(x: i32, y: i32, value: i32) void = {
    if x < 0 || x >= MAP_SIZE || y < 0 || y >= MAP_SIZE {
        return
    }
    trust @store32(
        @ptradd(map as ref i32, ((y * MAP_SIZE + x) as usize) * @sizeof(i32)) as ref u32,
        value as u32
    )
}

fn is_space(c: u8) bool = {
    return c == 32 || c == 9 || c == 10 || c == 13
}

fn first_non_space(line: ref u8) i64 = trust {
    val i: mut i64 = 0
    for {
        val c: u8 = @load8(@ptradd(line, i as usize))
        if c == 0 || !is_space(c) {
            return i
        }
        i++
    }
    return i
}

fn skip_spaces(line: ref u8, pos: i64) i64 = trust {
    val i: mut i64 = pos
    for {
        val c: u8 = @load8(@ptradd(line, i as usize))
        if c == 0 || !is_space(c) {
            break
        }
        i++
    }
    return i
}

fn read_number(line: ref u8, pos: mut ref i64) f32 = trust {
    val i: mut i64 = @deref(pos)
    for {
        val c: u8 = @load8(@ptradd(line, i as usize))
        if c == 0 {
            break
        }
        if c == 45 || c == 43 || (c >= 48 && c <= 57) {
            break
        }
        i++
    }

    val start: i64 = i
    val first: u8 = @load8(@ptradd(line, i as usize))
    if first == 45 || first == 43 {
        i++
    }
    for {
        val c: u8 = @load8(@ptradd(line, i as usize))
        if (c >= 48 && c <= 57) || c == 46 {
            i++
        } else {
            break
        }
    }

    @deref(pos) = i
    val length: i64 = i - start
    if length <= 0 {
        return 0.0
    }

    val buffer: mut [64]u8 = @zeroed
    @memcpy(buffer as ref void, @ptradd(line, start as usize), length as usize)
    @store8(@ptradd(buffer as ref u8, length as usize), 0)

    match fmt.string_to_f64(buffer as ref u8) {
        ok value => {
            return value as f32
        }
        err _ => {
            return 0.0
        }
    }
}

fn read_quoted(line: ref u8, pos: mut ref i64, out: ref u8, capacity: i64) bool = trust {
    val i: mut i64 = skip_spaces(line, @deref(pos))
    if @load8(@ptradd(line, i as usize)) != 34 {
        return false
    }
    i++
    val start: i64 = i
    for {
        val c: u8 = @load8(@ptradd(line, i as usize))
        if c == 0 || c == 34 {
            break
        }
        i++
    }

    val length: i64 = i - start
    val count: mut i64 = length
    if count > capacity - 1 {
        count = capacity - 1
    }
    if count > 0 {
        @memcpy(out as ref void, @ptradd(line, start as usize), count as usize)
    }
    @store8(@ptradd(out, count as usize), 0)
    @deref(pos) = i
    if @load8(@ptradd(line, i as usize)) == 34 {
        @deref(pos) = i + 1
    }
    return true
}

fn read_token(line: ref u8, pos: mut ref i64, out: ref u8, capacity: i64) bool = trust {
    val i: mut i64 = skip_spaces(line, @deref(pos))
    val start: i64 = i
    for {
        val c: u8 = @load8(@ptradd(line, i as usize))
        if c == 0 || is_space(c) {
            break
        }
        i++
    }

    val length: i64 = i - start
    val count: mut i64 = length
    if count > capacity - 1 {
        count = capacity - 1
    }
    if count > 0 {
        @memcpy(out as ref void, @ptradd(line, start as usize), count as usize)
    }
    @store8(@ptradd(out, count as usize), 0)
    @deref(pos) = i
    return true
}

fn copy_text(dst: ref u8, capacity: i64, src: ref u8) void = trust {
    val length: i64 = str.len_raw(src)
    val count: mut i64 = length
    if count > capacity - 1 {
        count = capacity - 1
    }
    if count > 0 {
        @memcpy(dst as ref void, src as ref void, count as usize)
    }
    @store8(@ptradd(dst, count as usize), 0)
}

fn after_third_close_paren(line: ref u8) i64 = trust {
    val closeCount: mut i32 = 0
    val i: mut i64 = 0
    for {
        val c: u8 = @load8(@ptradd(line, i as usize))
        if c == 0 {
            return i
        }
        if c == 41 {
            closeCount++
            if closeCount == 3 {
                return i + 1
            }
        }
        i++
    }
    return i
}

fn texture_id(name: ref u8) i32 = {
    if str.str_eql(name, "quake/tech08_2") {
        return 1
    }
    if str.str_eql(name, "quake/dung01_1") {
        return 2
    }
    if str.str_eql(name, "quake/tech07_2") {
        return 3
    }
    return 1
}

fn brush_reset(bounds: mut ref BrushBounds) void = trust {
    bounds.minX = 1.0e30
    bounds.minY = 1.0e30
    bounds.minZ = 1.0e30
    bounds.maxX = -1.0e30
    bounds.maxY = -1.0e30
    bounds.maxZ = -1.0e30
    bounds.hasFace = false
    @memset(@addr(bounds.texture) as ref void, 0, 128 as usize)
}

fn parse_face(line: ref u8, bounds: mut ref BrushBounds) void = trust {
    val pos: mut i64 = 0
    for point = 0, point < 3, point++ {
        val x: f32 = read_number(line, @addr(pos))
        val y: f32 = read_number(line, @addr(pos))
        val z: f32 = read_number(line, @addr(pos))

        if x < bounds.minX {
            bounds.minX = x
        }
        if y < bounds.minY {
            bounds.minY = y
        }
        if z < bounds.minZ {
            bounds.minZ = z
        }
        if x > bounds.maxX {
            bounds.maxX = x
        }
        if y > bounds.maxY {
            bounds.maxY = y
        }
        if z > bounds.maxZ {
            bounds.maxZ = z
        }
    }

    bounds.hasFace = true
    if @load8(bounds.texture as ref u8) == 0 {
        val texturePos: mut i64 = after_third_close_paren(line)
        read_token(line, @addr(texturePos), bounds.texture as ref u8, 128 as i64)
    }
}

fn finish_brush(bounds: ref BrushBounds) void = trust {
    if !bounds.hasFace {
        return
    }
    if bounds.minZ > 4.0 || bounds.maxZ < 96.0 {
        return
    }

    val id: i32 = texture_id(bounds.texture as ref u8)
    val x0: i32 = (bounds.minX / (TILE_SIZE as f32)) as i32
    val y0: i32 = (bounds.minY / (TILE_SIZE as f32)) as i32
    val x1: i32 = (bounds.maxX / (TILE_SIZE as f32)) as i32
    val y1: i32 = (bounds.maxY / (TILE_SIZE as f32)) as i32

    for y = y0, y < y1, y++ {
        for x = x0, x < x1, x++ {
            map_set(x, y, id)
        }
    }
}

fn parse_property(
    line: ref u8,
    class_name: ref u8,
    originX: mut ref f32,
    originY: mut ref f32,
    originZ: mut ref f32,
    hasOrigin: mut ref bool,
    entityAngle: mut ref f32
) void = trust {
    val pos: mut i64 = 0
    val key: [64]u8 = @zeroed
    val value: [256]u8 = @zeroed

    if !read_quoted(line, @addr(pos), key as ref u8, 64 as i64) {
        return
    }
    if !read_quoted(line, @addr(pos), value as ref u8, 256 as i64) {
        return
    }

    if str.str_eql(key as ref u8, "classname") {
        copy_text(class_name, 64 as i64, value as ref u8)
    } elif str.str_eql(key as ref u8, "origin") {
        val valuePos: mut i64 = 0
        @deref(originX) = read_number(value as ref u8, @addr(valuePos))
        @deref(originY) = read_number(value as ref u8, @addr(valuePos))
        @deref(originZ) = read_number(value as ref u8, @addr(valuePos))
        @deref(hasOrigin) = true
    } elif str.str_eql(key as ref u8, "angle") {
        val valuePos: mut i64 = 0
        @deref(entityAngle) = read_number(value as ref u8, @addr(valuePos))
    }
}

fn finish_entity(
    class_name: ref u8,
    hasOrigin: bool,
    originX: f32,
    originY: f32,
    entityAngle: f32
) void = trust {
    if !hasOrigin {
        return
    }

    if str.str_eql(class_name, "info_player_start") {
        spawnX = originX
        spawnY = originY
        spawnAngle = entityAngle
        spawnFound = true
    } elif str.raw_starts_with(class_name, "monster_") {
        if enemySpawnCount < MAX_ENEMIES {
            val spawn: mut ref SpawnPoint = enemy_spawn(enemySpawnCount)
            spawn.x = originX
            spawn.y = originY
            enemySpawnCount++
        }
    }
}

fn find_spawn() void = trust {
    for y = 1, y < MAP_SIZE - 1, y++ {
        for x = 1, x < MAP_SIZE - 1, x++ {
            if map_at(x, y) == 0 {
                spawnX = (x as f32) * (TILE_SIZE as f32) + (TILE_SIZE as f32) * 0.5
                spawnY = (y as f32) * (TILE_SIZE as f32) + (TILE_SIZE as f32) * 0.5
                spawnFound = true
                return
            }
        }
    }
}

fn load_map() bool = trust {
    val handle = fs.open(MAP_PATH, "rb")
    match handle {
        none => {
            return false
        }
        some file => {
            val line: [2048]u8 = @zeroed
            val class_name: mut [64]u8 = @zeroed
            val bounds: mut BrushBounds = @zeroed
            val depth: mut i32 = 0
            val originX: mut f32 = 0.0
            val originY: mut f32 = 0.0
            val originZ: mut f32 = 0.0
            val entityAngle: mut f32 = 0.0
            val hasOrigin: mut bool = false

            spawnFound = false
            enemySpawnCount = 0

            for fs.read_line(file, line as ref u8, 2048 as i64) {
                val start: i64 = first_non_space(line as ref u8)
                val c: u8 = @load8(@ptradd(line as ref u8, start as usize))

                if c == 0 || c == 47 {
                    continue
                }

                if c == 123 {
                    depth++
                    if depth == 1 {
                        @memset(class_name as ref void, 0, 64 as usize)
                        originX = 0.0
                        originY = 0.0
                        originZ = 0.0
                        entityAngle = 0.0
                        hasOrigin = false
                    } elif depth == 2 {
                        brush_reset(@addr(bounds))
                    }
                } elif c == 125 {
                    if depth == 2 {
                        finish_brush(@addr(bounds))
                    } elif depth == 1 {
                        finish_entity(
                            class_name as ref u8,
                            hasOrigin,
                            originX,
                            originY,
                            entityAngle
                        )
                    }
                    if depth > 0 {
                        depth--
                    }
                } elif c == 40 {
                    if depth == 2 {
                        parse_face(line as ref u8, @addr(bounds))
                    }
                } elif c == 34 {
                    if depth == 1 {
                        parse_property(
                            line as ref u8,
                            class_name as ref u8,
                            @addr(originX),
                            @addr(originY),
                            @addr(originZ),
                            @addr(hasOrigin),
                            @addr(entityAngle)
                        )
                    }
                }
            }

            fs.close(file)
            if !spawnFound {
                find_spawn()
            }
            @print("cubedoom: loaded {s} with {d} enemy spawns\n", {MAP_PATH, enemySpawnCount})
            return true
        }
    }
}

fn apply_spawn() void = trust {
    player.x = spawnX - player.w * 0.5
    player.y = spawnY - player.h * 0.5

    val radians: f32 = spawnAngle * PI / 180.0
    player.dirX = cosf(radians)
    player.dirY = sinf(radians)
    player.planeX = -player.dirY * 0.66
    player.planeY = player.dirX * 0.66
}

fn init_enemies() void = trust {
    for i = 0, i < MAX_ENEMIES, i++ {
        val enemy: mut ref Enemy = get_enemy(i)
        if i < enemySpawnCount {
            val spawn: ref SpawnPoint = enemy_spawn(i)
            enemy.x = spawn.x - 4.0
            enemy.y = spawn.y - 4.0
            enemy.health = 3
            enemy.alive = 1
            enemy.shootTimer = 1.5 + (i as f32) * 0.35
        } else {
            enemy.x = 0.0
            enemy.y = 0.0
            enemy.health = 0
            enemy.alive = 0
            enemy.shootTimer = 0.0
        }
    }
}

fn player_shoot() void = {
    if shootCooldown > 0.0 {
        return
    }
    shootCooldown = SHOOT_COOLDOWN_VAL
    muzzleFlashTimer = 0.14
    play_sound(g_shootSound)

    val pCX: f32 = player.x + 4.0
    val pCY: f32 = player.y + 4.0

    val bi: mut i32 = 0
    for bi < MAX_BULLETS {
        val blt: mut ref Bullet = get_bullet(bi)
        if blt.alive == 0 {
            blt.x = pCX
            blt.y = pCY
            blt.dx = player.dirX * BULLET_SPEED
            blt.dy = player.dirY * BULLET_SPEED
            blt.alive = 1
            blt.isPlayer = 1
            blt.animTime = 0.0
            break
        }
        bi++
    }
}

fn update_enemies(dt: f32) void = {
    val pCX: f32 = player.x + 4.0
    val pCY: f32 = player.y + 4.0

    val ei: mut i32 = 0
    for ei < MAX_ENEMIES {
        val e: mut ref Enemy = get_enemy(ei)
        if e.alive != 0 {
            val dx: f32 = pCX - (e.x + 4.0)
            val dy: f32 = pCY - (e.y + 4.0)
            val dist: f32 = trust sqrtf(dx * dx + dy * dy)

            if dist > 80.0 && dist < 2000.0 {
                val nx: f32 = dx / dist
                val ny: f32 = dy / dist
                val newX: f32 = e.x + nx * ENEMY_SPEED * dt
                val newY: f32 = e.y + ny * ENEMY_SPEED * dt

                val tx: i32 = ((newX + 4.0) / (TILE_SIZE as f32)) as i32
                val ty: i32 = ((e.y + 4.0) / (TILE_SIZE as f32)) as i32
                if map_at(tx, ty) == 0 {
                    e.x = newX
                }

                val tx2: i32 = ((e.x + 4.0) / (TILE_SIZE as f32)) as i32
                val ty2: i32 = ((newY + 4.0) / (TILE_SIZE as f32)) as i32
                if map_at(tx2, ty2) == 0 {
                    e.y = newY
                }
            }

            e.shootTimer -= dt
            if e.shootTimer <= 0.0 {
                e.shootTimer = ENEMY_SHOOT_INTERVAL + (ei as f32) * 0.3

                val bi: mut i32 = 0
                for bi < MAX_BULLETS {
                    val blt: mut ref Bullet = get_bullet(bi)
                    if blt.alive == 0 {
                        val bdx: f32 = pCX - (e.x + 4.0)
                        val bdy: f32 = pCY - (e.y + 4.0)
                        val bdist: f32 = trust sqrtf(bdx * bdx + bdy * bdy)
                        if bdist > 0.0 {
                            blt.x = e.x + 4.0
                            blt.y = e.y + 4.0
                            blt.dx = (bdx / bdist) * BULLET_SPEED
                            blt.dy = (bdy / bdist) * BULLET_SPEED
                            blt.alive = 1
                            blt.isPlayer = 0
                            blt.animTime = 0.0
                            play_sound(g_enemyShootSound)
                        }
                        break
                    }
                    bi++
                }
            }
        }
        ei++
    }
}

fn update_bullets(dt: f32) void = {
    val pCX: f32 = player.x + 4.0
    val pCY: f32 = player.y + 4.0
    val bi: mut i32 = 0

    for bi < MAX_BULLETS {
        val blt: mut ref Bullet = get_bullet(bi)
        if blt.alive != 0 {
            blt.x += blt.dx * dt
            blt.y += blt.dy * dt
            blt.animTime += dt

            val tx: i32 = (blt.x / (TILE_SIZE as f32)) as i32
            val ty: i32 = (blt.y / (TILE_SIZE as f32)) as i32
            val hitWall: mut i32 = 0
            if map_at(tx, ty) != 0 {
                hitWall = 1
            }

            if hitWall != 0 {
                blt.alive = 0
            } elif blt.isPlayer == 0 {
                val pdx: f32 = blt.x - pCX
                val pdy: f32 = blt.y - pCY
                if pdx * pdx + pdy * pdy < 400.0 {
                    playerHealth -= 10
                    blt.alive = 0
                    if playerHealth < 0 {
                        playerHealth = 0
                    }
                    hitFlashTimer = 0.2
                    play_sound(g_hurtSound)
                }
            } else {
                val ei: mut i32 = 0
                for ei < MAX_ENEMIES {
                    val e: mut ref Enemy = get_enemy(ei)
                    if e.alive != 0 {
                        val edx: f32 = (e.x + 4.0) - blt.x
                        val edy: f32 = (e.y + 4.0) - blt.y
                        val edist: f32 = trust sqrtf(edx * edx + edy * edy)
                        if edist < 20.0 {
                            e.health -= 1
                            if e.health <= 0 {
                                e.alive = 0
                            }
                            blt.alive = 0
                            play_sound(g_hitSound)
                            break
                        }
                    }
                    ei++
                }
            }
        }
        bi++
    }
}

fn billboard_texture(kind: i32) ref void = {
    if kind == 2 {
        return g_treeTex
    }
    if kind == 3 {
        return g_healthTex
    }
    if kind == 4 || kind == 5 {
        return g_bulletTex
    }
    return g_enemyTex
}

fn billboard_src(
    kind: i32,
    x: mut ref i32,
    y: mut ref i32,
    w: mut ref i32,
    h: mut ref i32
) void = trust {
    if kind == 2 {
        @deref(x) = 187
        @deref(y) = 4
        @deref(w) = 222
        @deref(h) = 319
    } elif kind == 3 {
        @deref(x) = 50
        @deref(y) = 30
        @deref(w) = 240
        @deref(h) = 280
    } elif kind == 4 || kind == 5 {
        @deref(x) = 0
        @deref(y) = 0
        @deref(w) = bulletTexW / 4
        @deref(h) = bulletTexH
    } else {
        @deref(x) = 55
        @deref(y) = 40
        @deref(w) = 180
        @deref(h) = 275
    }
}

fn fill_circle(cx: i32, cy: i32, radius: i32, r: u8, g: u8, b: u8, a: u8) void = {
    if radius < 1 {
        return
    }
    trust SDL_SetRenderDrawColor(g_renderer, r, g, b, a)
    for dy = -radius, dy <= radius, dy++ {
        val inner: f32 = (radius * radius - dy * dy) as f32
        val dx: i32 = (trust sqrtf(inner)) as i32
        g_aux_rect.x = cx - dx
        g_aux_rect.y = cy + dy
        g_aux_rect.w = dx * 2 + 1
        g_aux_rect.h = 1
        trust SDL_RenderFillRect(g_renderer, g_aux_rect)
    }
}

fn draw_glow(cx: i32, cy: i32, radius: i32, r: u8, g: u8, b: u8, alpha: u8) void = {
    if radius < 1 {
        return
    }
    trust SDL_SetRenderDrawBlendMode(g_renderer, 2 as i32)
    for layer = 0, layer < 4, layer++ {
        val layerRadius: i32 = radius - (radius * layer) / 5
        val layerAlpha: u8 = ((alpha as i32) * (4 - layer) / 4) as u8
        fill_circle(cx, cy, layerRadius, r, g, b, layerAlpha)
    }
    trust SDL_SetRenderDrawBlendMode(g_renderer, 1 as i32)
}

fn draw_flare_chain(x: i32, y: i32, strength: f32) void = {
    val centerX: i32 = SCREEN_WIDTH / 2
    val centerY: i32 = SCREEN_HEIGHT / 2
    val dx: i32 = centerX - x
    val dy: i32 = centerY - y

    for step = 0, step < 4, step++ {
        val factor: f32 = 0.22 + (step as f32) * 0.27
        val fx: i32 = x + ((dx as f32) * factor) as i32
        val fy: i32 = y + ((dy as f32) * factor) as i32
        val radius: i32 = 17 - step * 3
        val alpha: u8 = ((strength * (68.0 - (step as f32) * 11.0)) as i32) as u8
        draw_glow(fx, fy, radius, 255 as u8, 190 as u8, 105 as u8, alpha)
    }
}

fn normalize_angle(angle: f32) f32 = {
    val value: mut f32 = angle
    for {
        if value > PI {
            value -= 2.0 * PI
        } elif value < -PI {
            value += 2.0 * PI
        } else {
            break
        }
    }
    return value
}

fn draw_sky(horizon: f32, time: f32) void = {
    val bottom: mut i32 = horizon as i32
    if bottom < 0 {
        bottom = 0
    }
    if bottom > SCREEN_HEIGHT {
        bottom = SCREEN_HEIGHT
    }

    if bottom > 0 {
        for band = 0, band < 20, band++ {
            val t: f32 = (band as f32) / 19.0
            val r: u8 = (7.0 + 24.0 * t) as u8
            val g: u8 = (9.0 + 17.0 * t) as u8
            val b: u8 = (26.0 + 28.0 * t) as u8
            trust SDL_SetRenderDrawColor(g_renderer, r, g, b, 255 as u8)
            val y0: i32 = bottom * band / 20
            val y1: i32 = bottom * (band + 1) / 20
            g_aux_rect.x = 0
            g_aux_rect.y = y0
            g_aux_rect.w = SCREEN_WIDTH
            g_aux_rect.h = y1 - y0
            trust SDL_RenderFillRect(g_renderer, g_aux_rect)
        }
    }

    val yaw: f32 = trust atan2f(player.dirY, player.dirX)
    trust SDL_SetRenderDrawBlendMode(g_renderer, 1 as i32)
    for index = 0, index < starCount, index++ {
        val star: ref Star = star_at(index)
        val relative: f32 = normalize_angle(star.angle - yaw)
        if trust fabsf(relative) < FOV_HALF + 0.12 {
            val sx: i32 = SCREEN_WIDTH / 2 + ((relative / FOV_HALF) * (SCREEN_WIDTH as f32 / 2.0)) as i32
            val sy: i32 = bottom - ((star.altitude * (bottom as f32)) as i32)
            val twinkle: f32 = 0.62 + 0.38 * trust sinf(time * 2.0 + star.phase)
            val brightness: u8 = (star.brightness * twinkle) as u8
            val size: mut i32 = 1
            if star.brightness > 205.0 {
                size = 2
            }
            trust SDL_SetRenderDrawColor(g_renderer, brightness, brightness, 255 as u8, 220 as u8)
            g_aux_rect.x = sx
            g_aux_rect.y = sy
            g_aux_rect.w = size
            g_aux_rect.h = size
            trust SDL_RenderFillRect(g_renderer, g_aux_rect)
        }
    }

    val sunAngle: f32 = 2.15
    val sunAltitude: f32 = 0.76
    val sunRelative: f32 = normalize_angle(sunAngle - yaw)
    if trust fabsf(sunRelative) < FOV_HALF + 0.25 {
        val sunX: i32 = SCREEN_WIDTH / 2 + ((sunRelative / FOV_HALF) * (SCREEN_WIDTH as f32 / 2.0)) as i32
        val sunY: i32 = bottom - ((sunAltitude * (bottom as f32)) as i32)
        draw_glow(sunX, sunY, 48, 255 as u8, 210 as u8, 140 as u8, 70 as u8)
        draw_glow(sunX, sunY, 18, 255 as u8, 245 as u8, 210 as u8, 150 as u8)
        draw_flare_chain(sunX, sunY, 0.65)
    }

    trust SDL_SetRenderDrawBlendMode(g_renderer, 0 as i32)
}

fn draw_ground(horizon: f32) void = {
    val top: mut i32 = horizon as i32
    if top < 0 {
        top = 0
    }
    if top >= SCREEN_HEIGHT {
        return
    }

    for band = 0, band < 18, band++ {
        val t: f32 = (band as f32) / 17.0
        val r: u8 = (48.0 - 32.0 * t) as u8
        val g: u8 = (44.0 - 29.0 * t) as u8
        val b: u8 = (41.0 - 27.0 * t) as u8
        trust SDL_SetRenderDrawColor(g_renderer, r, g, b, 255 as u8)
        val y0: i32 = top + (SCREEN_HEIGHT - top) * band / 18
        val y1: i32 = top + (SCREEN_HEIGHT - top) * (band + 1) / 18
        g_aux_rect.x = 0
        g_aux_rect.y = y0
        g_aux_rect.w = SCREEN_WIDTH
        g_aux_rect.h = y1 - y0
        trust SDL_RenderFillRect(g_renderer, g_aux_rect)
    }
}

fn init_sky() void = {
    starCount = MAX_STARS
    for index = 0, index < MAX_STARS, index++ {
        val star: mut ref Star = star_at(index)
        star.angle = rand_unit() * 2.0 * PI
        star.altitude = 0.06 + rand_unit() * 0.88
        star.brightness = 90.0 + rand_unit() * 165.0
        star.phase = rand_unit() * 2.0 * PI
    }
}

fn cell_has_enemy(cx: i32, cy: i32) bool = {
    for index = 0, index < enemySpawnCount, index++ {
        val spawn: ref SpawnPoint = enemy_spawn(index)
        if ((spawn.x / (TILE_SIZE as f32)) as i32) == cx {
            if ((spawn.y / (TILE_SIZE as f32)) as i32) == cy {
                return true
            }
        }
    }
    return false
}

fn cell_near_spawn(cx: i32, cy: i32) bool = {
    val spawnCellX: i32 = (spawnX / (TILE_SIZE as f32)) as i32
    val spawnCellY: i32 = (spawnY / (TILE_SIZE as f32)) as i32
    val dx: i32 = cx - spawnCellX
    val dy: i32 = cy - spawnCellY
    return dx * dx + dy * dy < 25
}

fn cell_has_tree(cx: i32, cy: i32) bool = {
    for index = 0, index < treeCount, index++ {
        val tree: ref Tree = tree_at(index)
        if ((tree.x / (TILE_SIZE as f32)) as i32) == cx {
            if ((tree.y / (TILE_SIZE as f32)) as i32) == cy {
                return true
            }
        }
    }
    return false
}

fn cell_near_pickup(count: i32, cx: i32, cy: i32) bool = {
    for index = 0, index < count, index++ {
        val pickup: ref HealthPickup = pickup_at(index)
        val dx: i32 = cx - ((pickup.x / (TILE_SIZE as f32)) as i32)
        val dy: i32 = cy - ((pickup.y / (TILE_SIZE as f32)) as i32)
        if dx * dx + dy * dy < 16 {
            return true
        }
    }
    return false
}

fn init_trees() void = {
    treeCount = 0
    for y = 1, y < MAP_SIZE - 1, y++ {
        for x = 1, x < MAP_SIZE - 1, x++ {
            if treeCount >= MAX_TREES {
                return
            }
            if map_at(x, y) == 0 && !cell_near_spawn(x, y) && !cell_has_enemy(x, y) {
                if rand_next() % 100 < 7 {
                    val tree: mut ref Tree = tree_at(treeCount)
                    tree.x = (x as f32) * (TILE_SIZE as f32) + 32.0 + (rand_unit() * 20.0 - 10.0)
                    tree.y = (y as f32) * (TILE_SIZE as f32) + 32.0 + (rand_unit() * 20.0 - 10.0)
                    tree.scale = 0.8 + rand_unit() * 0.45
                    treeCount++
                }
            }
        }
    }
}

fn init_pickups() void = {
    for index = 0, index < MAX_HEALTH_PICKUPS, index++ {
        val pickup: mut ref HealthPickup = pickup_at(index)
        pickup.active = 0
        pickup.respawn = 0.0
        pickup.bob = rand_unit() * 2.0 * PI

        val attempts: mut i32 = 0
        for attempts < 400 {
            val x: i32 = (rand_next() % ((MAP_SIZE - 2) as u32)) as i32 + 1
            val y: i32 = (rand_next() % ((MAP_SIZE - 2) as u32)) as i32 + 1
            if map_at(
                x,
                y
            ) == 0 && !cell_near_spawn(
                x,
                y
            ) && !cell_has_enemy(x, y) && !cell_has_tree(x, y) && !cell_near_pickup(index, x, y) {
                pickup.x = (x as f32) * (TILE_SIZE as f32) + 32.0
                pickup.y = (y as f32) * (TILE_SIZE as f32) + 32.0
                pickup.active = 1
                break
            }
            attempts++
        }
    }
}

fn update_pickups(dt: f32) void = {
    val pCX: f32 = player.x + 4.0
    val pCY: f32 = player.y + 4.0

    for index = 0, index < MAX_HEALTH_PICKUPS, index++ {
        val pickup: mut ref HealthPickup = pickup_at(index)
        if pickup.active != 0 {
            val dx: f32 = pickup.x - pCX
            val dy: f32 = pickup.y - pCY
            if dx * dx + dy * dy < 784.0 {
                playerHealth += 25
                if playerHealth > 100 {
                    playerHealth = 100
                }
                pickup.active = 0
                pickup.respawn = 16.0
                play_sound(g_pickupSound)
            }
        } else {
            pickup.respawn -= dt
            if pickup.respawn <= 0.0 {
                pickup.active = 1
            }
        }
    }
}

fn add_billboard(
    list: ref Billboard,
    count: mut ref i32,
    kind: i32,
    index: i32,
    px: f32,
    py: f32
) void = trust {
    if @deref(count) >= MAX_BILLBOARDS {
        return
    }
    val billboard: mut ref Billboard = billboard_at(list, @deref(count))
    val dx: f32 = px - (player.x + 4.0)
    val dy: f32 = py - (player.y + 4.0)
    billboard.kind = kind
    billboard.index = index
    billboard.distance = dx * dx + dy * dy
    @deref(count) = @deref(count) + 1
}

fn render_billboards() void = trust {
    val list: mut [64]Billboard = @zeroed
    val count: mut i32 = 0

    for index = 0, index < MAX_ENEMIES, index++ {
        val enemy: ref Enemy = get_enemy(index)
        if enemy.alive != 0 {
            add_billboard(
                list as ref Billboard,
                @addr(count),
                1,
                index,
                enemy.x + 4.0,
                enemy.y + 4.0
            )
        }
    }

    for index = 0, index < treeCount, index++ {
        val tree: ref Tree = tree_at(index)
        add_billboard(list as ref Billboard, @addr(count), 2, index, tree.x, tree.y)
    }

    for index = 0, index < MAX_HEALTH_PICKUPS, index++ {
        val pickup: ref HealthPickup = pickup_at(index)
        if pickup.active != 0 {
            add_billboard(list as ref Billboard, @addr(count), 3, index, pickup.x, pickup.y)
        }
    }

    for index = 0, index < MAX_BULLETS, index++ {
        val bullet: ref Bullet = get_bullet(index)
        if bullet.alive != 0 {
            val kind: mut i32 = 4
            if bullet.isPlayer != 0 {
                kind = 5
            }
            add_billboard(list as ref Billboard, @addr(count), kind, index, bullet.x, bullet.y)
        }
    }

    for i = 0, i < count - 1, i++ {
        val farthest: mut i32 = i
        for j = i + 1, j < count, j++ {
            if billboard_at(
                list as ref Billboard,
                j
            ).distance > billboard_at(list as ref Billboard, farthest).distance {
                farthest = j
            }
        }
        if farthest != i {
            val a: mut ref Billboard = billboard_at(list as ref Billboard, i)
            val b: mut ref Billboard = billboard_at(list as ref Billboard, farthest)
            val aKind: i32 = a.kind
            val aIndex: i32 = a.index
            val aDistance: f32 = a.distance
            a.kind = b.kind
            a.index = b.index
            a.distance = b.distance
            b.kind = aKind
            b.index = aIndex
            b.distance = aDistance
        }
    }

    val pCX: f32 = player.x + 4.0
    val pCY: f32 = player.y + 4.0
    val det: f32 = player.planeX * player.dirY - player.dirX * player.planeY
    if det == 0.0 {
        return
    }
    val invDet: f32 = 1.0 / det
    val horizon: f32 = (SCREEN_HEIGHT as f32) / 2.0 + pitch

    for index = 0, index < count, index++ {
        val billboard: ref Billboard = billboard_at(list as ref Billboard, index)
        val kind: i32 = billboard.kind
        val itemIndex: i32 = billboard.index
        val worldX: mut f32 = 0.0
        val worldY: mut f32 = 0.0
        val heightUnits: mut f32 = 1.0

        if kind == 1 {
            val enemy: ref Enemy = get_enemy(itemIndex)
            worldX = enemy.x + 4.0
            worldY = enemy.y + 4.0
            heightUnits = 1.05
        } elif kind == 2 {
            val tree: ref Tree = tree_at(itemIndex)
            worldX = tree.x
            worldY = tree.y
            heightUnits = 1.7 * tree.scale
        } elif kind == 3 {
            val pickup: ref HealthPickup = pickup_at(itemIndex)
            worldX = pickup.x
            worldY = pickup.y
            heightUnits = 0.42
        } elif kind == 4 || kind == 5 {
            val bullet: ref Bullet = get_bullet(itemIndex)
            worldX = bullet.x
            worldY = bullet.y
            heightUnits = 0.12
        }

        val dx: f32 = worldX - pCX
        val dy: f32 = worldY - pCY
        val tx: f32 = invDet * (player.dirY * dx - player.dirX * dy)
        val ty: f32 = invDet * (-player.planeY * dx + player.planeX * dy)

        if ty > 0.1 {
            val depth: f32 = ty / (TILE_SIZE as f32)
            val unit: f32 = (SCREEN_HEIGHT as f32) / depth
            val screenX: i32 = ((SCREEN_WIDTH as f32 / 2.0) * (1.0 + tx / ty)) as i32

            val srcX: mut i32 = 0
            val srcY: mut i32 = 0
            val srcW: mut i32 = 1
            val srcH: mut i32 = 1
            billboard_src(kind, @addr(srcX), @addr(srcY), @addr(srcW), @addr(srcH))
            if kind == 4 || kind == 5 {
                val bullet: ref Bullet = get_bullet(itemIndex)
                val frame: i32 = ((bullet.animTime * 8.0) as i32) % 4
                srcX = frame * (bulletTexW / 4)
            }

            val spriteH: i32 = (unit * heightUnits) as i32
            val spriteW: i32 = spriteH * srcW / srcH
            if spriteH > 0 && spriteW > 0 {
                val floorY: f32 = horizon + unit
                val bottomY: mut f32 = floorY
                if kind == 3 {
                    bottomY = floorY - unit * 0.10 - sinf(gameTime * 2.2 + (itemIndex as f32)) * 4.0
                } elif kind == 4 || kind == 5 {
                    bottomY = horizon + unit * 0.12
                }
                val topY: f32 = bottomY - (spriteH as f32)

                val clipTopF: mut f32 = topY
                val clipBottomF: mut f32 = bottomY
                if clipTopF < 0.0 {
                    clipTopF = 0.0
                }
                if clipBottomF > (SCREEN_HEIGHT as f32) {
                    clipBottomF = SCREEN_HEIGHT as f32
                }

                if clipBottomF > clipTopF {
                    val drawStartY: i32 = clipTopF as i32
                    val drawEndY: i32 = clipBottomF as i32
                    val visibleH: f32 = clipBottomF - clipTopF
                    val srcYAdjusted: i32 = srcY + ((srcH as f32) * ((clipTopF - topY) / (spriteH as f32))) as i32
                    val srcHAdjusted: mut i32 = ((srcH as f32) * (visibleH / (spriteH as f32))) as i32
                    if srcHAdjusted < 1 {
                        srcHAdjusted = 1
                    }

                    val drawStartX: mut i32 = screenX - spriteW / 2
                    val drawEndX: mut i32 = screenX + spriteW / 2
                    if drawStartX < 0 {
                        drawStartX = 0
                    }
                    if drawEndX >= SCREEN_WIDTH {
                        drawEndX = SCREEN_WIDTH - 1
                    }

                    val scaledDist: usize = (depth * 100000.0) as usize
                    val spriteLeft: i32 = screenX - spriteW / 2
                    val texture: ref void = billboard_texture(kind)

                    if texture != none {
                        val xi: mut i32 = drawStartX
                        for xi < drawEndX {
                            val zbufVal: usize = @load(@ptradd(zbuf, (xi as usize) * 8)) as usize
                            if scaledDist < zbufVal {
                                val texX: i32 = srcX + ((xi - spriteLeft) * srcW) / spriteW
                                if texX >= srcX && texX < srcX + srcW {
                                    g_src_rect.x = texX
                                    g_src_rect.y = srcYAdjusted
                                    g_src_rect.w = 1
                                    g_src_rect.h = srcHAdjusted
                                    g_dst_rect.x = xi
                                    g_dst_rect.y = drawStartY
                                    g_dst_rect.w = 1
                                    g_dst_rect.h = drawEndY - drawStartY
                                    SDL_RenderCopy(
                                        g_renderer,
                                        texture,
                                        g_src_rect as ref void,
                                        g_dst_rect as ref void
                                    )
                                }
                            }
                            xi++
                        }
                    }
                }
            }
        }
    }

    for index = 0, index < MAX_HEALTH_PICKUPS, index++ {
        val pickup: ref HealthPickup = pickup_at(index)
        if pickup.active != 0 {
            val dx: f32 = pickup.x - pCX
            val dy: f32 = pickup.y - pCY
            val tx: f32 = invDet * (player.dirY * dx - player.dirX * dy)
            val ty: f32 = invDet * (-player.planeY * dx + player.planeX * dy)
            if ty > 0.1 {
                val depth: f32 = ty / (TILE_SIZE as f32)
                val unit: f32 = (SCREEN_HEIGHT as f32) / depth
                val screenX: i32 = ((SCREEN_WIDTH as f32 / 2.0) * (1.0 + tx / ty)) as i32
                val centerY: i32 = (horizon + unit * 0.62) as i32
                val visible: mut bool = false
                if screenX >= 0 && screenX < SCREEN_WIDTH {
                    val wallDistance: usize = @load(@ptradd(zbuf, (screenX as usize) * 8)) as usize
                    val spriteDistance: usize = (depth * 100000.0) as usize
                    if spriteDistance < wallDistance {
                        visible = true
                    }
                }
                if visible {
                    draw_glow(
                        screenX,
                        centerY,
                        (unit * 0.16) as i32 + 6,
                        80 as u8,
                        255 as u8,
                        120 as u8,
                        34 as u8
                    )
                    SDL_SetRenderDrawBlendMode(g_renderer, 2 as i32)
                    for particle = 0, particle < 6, particle++ {
                        val raw: f32 = gameTime * 0.55 + (index as f32) * 0.19 + (particle as f32) * 0.166
                        val phase: f32 = raw - (raw as i32) as f32
                        val px: i32 = screenX + (sinf(gameTime * 1.7 + (particle as f32) * 1.9 + (index as f32)) * 22.0) as i32
                        val py: i32 = (horizon + unit * 0.95 - phase * unit * 0.85) as i32
                        val alpha: u8 = ((1.0 - phase) * 130.0) as u8
                        fill_circle(
                            px,
                            py,
                            2 + (particle % 2),
                            90 as u8,
                            255 as u8,
                            140 as u8,
                            alpha
                        )
                    }
                    SDL_SetRenderDrawBlendMode(g_renderer, 0 as i32)
                }
            }
        }
    }

    SDL_SetRenderDrawBlendMode(g_renderer, 0 as i32)
}

fn render_gun(bobX: i32, bobY: i32, showFlash: bool) void = {
    if g_gunTex == none {
        return
    }

    val gunW: i32 = SCREEN_WIDTH * 7 / 10
    val gunH: i32 = gunW * gunTexH / gunTexW
    val gunX: i32 = (SCREEN_WIDTH - gunW) / 2 + bobX
    val gunY: i32 = SCREEN_HEIGHT - gunH + bobY + 20

    g_dst_rect.x = gunX
    g_dst_rect.y = gunY
    g_dst_rect.w = gunW
    g_dst_rect.h = gunH
    trust SDL_RenderCopy(g_renderer, g_gunTex, none, g_dst_rect as ref void)

    if showFlash {
        val flashSize: i32 = 120
        val fX: i32 = gunX + gunW / 2 - flashSize / 2
        val fY: i32 = gunY - flashSize / 3
        trust SDL_SetRenderDrawColor(g_renderer, 255 as u8, 220 as u8, 50 as u8, 255 as u8)
        g_aux_rect.x = fX
        g_aux_rect.y = fY
        g_aux_rect.w = flashSize
        g_aux_rect.h = flashSize
        trust SDL_RenderFillRect(g_renderer, g_aux_rect)
        trust SDL_SetRenderDrawColor(g_renderer, 255 as u8, 255 as u8, 200 as u8, 255 as u8)
        g_aux_rect.x = fX + flashSize / 4
        g_aux_rect.y = fY + flashSize / 4
        g_aux_rect.w = flashSize / 2
        g_aux_rect.h = flashSize / 2
        trust SDL_RenderFillRect(g_renderer, g_aux_rect)

        draw_glow(
            fX + flashSize / 2,
            fY + flashSize / 2,
            96,
            255 as u8,
            185 as u8,
            65 as u8,
            95 as u8
        )
        draw_flare_chain(fX + flashSize / 2, fY + flashSize / 2, 0.32)
    }
}

fn render_damage() void = {
    if hitFlashTimer <= 0.0 {
        return
    }
    val alpha: u8 = ((hitFlashTimer * 280.0) as i32) as u8
    trust SDL_SetRenderDrawBlendMode(g_renderer, 1 as i32)
    trust SDL_SetRenderDrawColor(g_renderer, 175 as u8, 20 as u8, 20 as u8, alpha)
    g_aux_rect.x = 0
    g_aux_rect.y = 0
    g_aux_rect.w = SCREEN_WIDTH
    g_aux_rect.h = 22
    trust SDL_RenderFillRect(g_renderer, g_aux_rect)
    g_aux_rect.x = 0
    g_aux_rect.y = SCREEN_HEIGHT - 22
    g_aux_rect.w = SCREEN_WIDTH
    g_aux_rect.h = 22
    trust SDL_RenderFillRect(g_renderer, g_aux_rect)
    g_aux_rect.x = 0
    g_aux_rect.y = 0
    g_aux_rect.w = 22
    g_aux_rect.h = SCREEN_HEIGHT
    trust SDL_RenderFillRect(g_renderer, g_aux_rect)
    g_aux_rect.x = SCREEN_WIDTH - 22
    g_aux_rect.y = 0
    g_aux_rect.w = 22
    g_aux_rect.h = SCREEN_HEIGHT
    trust SDL_RenderFillRect(g_renderer, g_aux_rect)
    trust SDL_SetRenderDrawBlendMode(g_renderer, 0 as i32)
}

fn render_crosshair() void = {
    val centerX: i32 = SCREEN_WIDTH / 2
    val centerY: i32 = SCREEN_HEIGHT / 2
    trust SDL_SetRenderDrawBlendMode(g_renderer, 1 as i32)
    trust SDL_SetRenderDrawColor(g_renderer, 235 as u8, 245 as u8, 255 as u8, 165 as u8)
    g_aux_rect.x = centerX - 1
    g_aux_rect.y = centerY - 1
    g_aux_rect.w = 3
    g_aux_rect.h = 3
    trust SDL_RenderFillRect(g_renderer, g_aux_rect)
    g_aux_rect.x = centerX - 10
    g_aux_rect.y = centerY
    g_aux_rect.w = 6
    g_aux_rect.h = 1
    trust SDL_RenderFillRect(g_renderer, g_aux_rect)
    g_aux_rect.x = centerX + 5
    g_aux_rect.y = centerY
    g_aux_rect.w = 6
    g_aux_rect.h = 1
    trust SDL_RenderFillRect(g_renderer, g_aux_rect)
    g_aux_rect.x = centerX
    g_aux_rect.y = centerY - 10
    g_aux_rect.w = 1
    g_aux_rect.h = 6
    trust SDL_RenderFillRect(g_renderer, g_aux_rect)
    g_aux_rect.x = centerX
    g_aux_rect.y = centerY + 5
    g_aux_rect.w = 1
    g_aux_rect.h = 6
    trust SDL_RenderFillRect(g_renderer, g_aux_rect)
    trust SDL_SetRenderDrawBlendMode(g_renderer, 0 as i32)
}

fn render_minimap() void = {
    val scale: f32 = 0.075
    val cell: f32 = (TILE_SIZE as f32) * scale
    val mapSize: i32 = (MAP_SIZE as f32 * cell) as i32
    val originX: i32 = SCREEN_WIDTH - mapSize - 24
    val originY: i32 = 24

    trust SDL_SetRenderDrawBlendMode(g_renderer, 1 as i32)
    trust SDL_SetRenderDrawColor(g_renderer, 6 as u8, 8 as u8, 12 as u8, 125 as u8)
    g_aux_rect.x = originX - 8
    g_aux_rect.y = originY - 8
    g_aux_rect.w = mapSize + 16
    g_aux_rect.h = mapSize + 16
    trust SDL_RenderFillRect(g_renderer, g_aux_rect)

    for y = 0, y < MAP_SIZE, y++ {
        for x = 0, x < MAP_SIZE, x++ {
            val cellValue: i32 = map_at(x, y)
            if cellValue != 0 {
                val r: mut u8 = 70
                val g: mut u8 = 82
                val b: mut u8 = 96
                if cellValue == 2 {
                    r = 112
                    g = 96
                    b = 78
                } elif cellValue == 3 {
                    r = 92
                    g = 100
                    b = 112
                }
                trust SDL_SetRenderDrawColor(g_renderer, r, g, b, 105 as u8)
                g_aux_rect.x = originX + ((x as f32) * cell) as i32
                g_aux_rect.y = originY + ((y as f32) * cell) as i32
                g_aux_rect.w = cell as i32
                g_aux_rect.h = cell as i32
                trust SDL_RenderFillRect(g_renderer, g_aux_rect)
            }
        }
    }

    for index = 0, index < MAX_HEALTH_PICKUPS, index++ {
        val pickup: ref HealthPickup = pickup_at(index)
        if pickup.active != 0 {
            trust SDL_SetRenderDrawColor(g_renderer, 80 as u8, 235 as u8, 125 as u8, 210 as u8)
            g_aux_rect.x = originX + (pickup.x * scale) as i32 - 2
            g_aux_rect.y = originY + (pickup.y * scale) as i32 - 2
            g_aux_rect.w = 4
            g_aux_rect.h = 4
            trust SDL_RenderFillRect(g_renderer, g_aux_rect)
        }
    }

    for index = 0, index < MAX_ENEMIES, index++ {
        val enemy: ref Enemy = get_enemy(index)
        if enemy.alive != 0 {
            trust SDL_SetRenderDrawColor(g_renderer, 235 as u8, 70 as u8, 70 as u8, 205 as u8)
            g_aux_rect.x = originX + (enemy.x * scale) as i32 - 2
            g_aux_rect.y = originY + (enemy.y * scale) as i32 - 2
            g_aux_rect.w = 4
            g_aux_rect.h = 4
            trust SDL_RenderFillRect(g_renderer, g_aux_rect)
        }
    }

    trust SDL_SetRenderDrawColor(g_renderer, 120 as u8, 225 as u8, 255 as u8, 240 as u8)
    g_aux_rect.x = originX + (player.x * scale) as i32 - 2
    g_aux_rect.y = originY + (player.y * scale) as i32 - 2
    g_aux_rect.w = 5
    g_aux_rect.h = 5
    trust SDL_RenderFillRect(g_renderer, g_aux_rect)
    trust SDL_SetRenderDrawBlendMode(g_renderer, 0 as i32)
}

fn render_hud() void = {
    trust SDL_SetRenderDrawBlendMode(g_renderer, 1 as i32)

    trust SDL_SetRenderDrawColor(g_renderer, 8 as u8, 10 as u8, 14 as u8, 175 as u8)
    g_aux_rect.x = 24
    g_aux_rect.y = SCREEN_HEIGHT - 42
    g_aux_rect.w = 212
    g_aux_rect.h = 20
    trust SDL_RenderFillRect(g_renderer, g_aux_rect)

    val healthR: mut u8 = 72
    val healthG: mut u8 = 225
    val healthB: mut u8 = 132
    if playerHealth < 30 {
        healthR = 242
        healthG = 70
        healthB = 70
    } elif playerHealth < 60 {
        healthR = 242
        healthG = 184
        healthB = 72
    }

    trust SDL_SetRenderDrawColor(g_renderer, healthR, healthG, healthB, 235 as u8)
    g_aux_rect.x = 29
    g_aux_rect.y = SCREEN_HEIGHT - 37
    g_aux_rect.w = playerHealth * 202 / 100
    g_aux_rect.h = 10
    trust SDL_RenderFillRect(g_renderer, g_aux_rect)

    g_aux_rect.x = 15
    g_aux_rect.y = SCREEN_HEIGHT - 37
    g_aux_rect.w = 4
    g_aux_rect.h = 12
    trust SDL_RenderFillRect(g_renderer, g_aux_rect)
    g_aux_rect.x = 11
    g_aux_rect.y = SCREEN_HEIGHT - 33
    g_aux_rect.w = 12
    g_aux_rect.h = 4
    trust SDL_RenderFillRect(g_renderer, g_aux_rect)

    trust SDL_SetRenderDrawBlendMode(g_renderer, 0 as i32)
}

fn load_texture(renderer: ref void, path: ref u8) ref void = trust {
    val surface: ref void = IMG_Load(path)
    if surface == none {
        return none
    }
    val texture: ref void = SDL_CreateTextureFromSurface(renderer, surface)
    SDL_FreeSurface(surface)
    if texture != none {
        SDL_SetTextureBlendMode(texture, 1 as i32)
    }
    return texture
}

fn texture_size(texture: ref void) TextureSize = trust {
    val size: mut TextureSize = @zeroed
    SDL_QueryTexture(
        texture,
        none as ref void,
        none as ref void,
        @addr(size.w) as ref void,
        @addr(size.h) as ref void
    )
    if size.w < 1 {
        size.w = 1
    }
    if size.h < 1 {
        size.h = 1
    }
    return size
}

fn load_wall_texture(renderer: ref void, path: ref u8, index: i32) void = trust {
    val texture: ref void = load_texture(renderer, path)
    if texture == none {
        return
    }
    val wall: mut ref WallTexture = wall_texture(index)
    val size: TextureSize = texture_size(texture)
    wall.tex = texture
    wall.w = size.w
    wall.h = size.h
}

fn wall_texture_for(id: i32) mut ref WallTexture = {
    if id == 2 {
        return wall_texture(1)
    }
    if id == 3 {
        return wall_texture(2)
    }
    return wall_texture(0)
}

pub fn main() i32 = {
    if !trust load_map() {
        trust @print("cubedoom: could not load {s}\n", {MAP_PATH})
        return 1
    }

    trust SDL_Init(C.SDL_INIT_VIDEO | C.SDL_INIT_AUDIO)
    trust apply_spawn()

    val window: ref void = trust SDL_CreateWindow(
        "cubedoom",
        C.SDL_WINDOWPOS_CENTERED,
        C.SDL_WINDOWPOS_CENTERED,
        SCREEN_WIDTH,
        SCREEN_HEIGHT,
        0 as u32
    )

    val renderer: ref void = trust SDL_CreateRenderer(
        window,
        -1 as i32,
        C.SDL_RENDERER_ACCELERATED | C.SDL_RENDERER_PRESENTVSYNC
    )
    g_renderer = renderer
    trust SDL_SetRelativeMouseMode(1 as i32)

    trust Mix_OpenAudio(44100 as i32, C.AUDIO_S16SYS, 2 as i32, 1024 as i32)
    g_shootSound = trust Mix_LoadWAV("sounds/shoot.wav")
    g_enemyShootSound = trust Mix_LoadWAV("sounds/enemy_shoot.wav")
    g_hitSound = trust Mix_LoadWAV("sounds/hit.wav")
    g_hurtSound = trust Mix_LoadWAV("sounds/hurt.wav")
    g_pickupSound = trust Mix_LoadWAV("sounds/pickup.wav")
    g_footstepSound = trust Mix_LoadWAV("sounds/footstep.wav")
    if g_shootSound != none {
        trust Mix_VolumeChunk(g_shootSound, 55 as i32)
    }
    if g_enemyShootSound != none {
        trust Mix_VolumeChunk(g_enemyShootSound, 32 as i32)
    }
    if g_hitSound != none {
        trust Mix_VolumeChunk(g_hitSound, 48 as i32)
    }
    if g_hurtSound != none {
        trust Mix_VolumeChunk(g_hurtSound, 78 as i32)
    }
    if g_pickupSound != none {
        trust Mix_VolumeChunk(g_pickupSound, 62 as i32)
    }
    if g_footstepSound != none {
        trust Mix_VolumeChunk(g_footstepSound, 26 as i32)
    }

    zbuf = @alloc((SCREEN_WIDTH as usize) * 8)
    trust @memset(zbuf, 127, (SCREEN_WIDTH as usize) * 8)

    enemies_buf = @alloc((MAX_ENEMIES as usize) * @sizeof(Enemy))
    trust @memset(enemies_buf, 0, (MAX_ENEMIES as usize) * @sizeof(Enemy))
    trust init_enemies()

    bullets_buf = @alloc((MAX_BULLETS as usize) * @sizeof(Bullet))
    trust @memset(bullets_buf, 0, (MAX_BULLETS as usize) * @sizeof(Bullet))

    g_src_rect = @alloc(@sizeof(SDL_Rect)) as ref SDL_Rect
    g_dst_rect = @alloc(@sizeof(SDL_Rect)) as ref SDL_Rect
    g_aux_rect = @alloc(@sizeof(SDL_Rect)) as ref SDL_Rect

    trust load_wall_texture(renderer, "textures/QUAKE101/tech08_2.png", 0)
    trust load_wall_texture(renderer, "textures/QUAKE101/dung01_1.png", 1)
    trust load_wall_texture(renderer, "textures/QUAKE101/tech07_2.png", 2)

    g_enemyTex = trust load_texture(renderer, "sprites/enemy.gif")
    if g_enemyTex != none {
        val enemySize: TextureSize = trust texture_size(g_enemyTex)
        enemyTexW = enemySize.w
        enemyTexH = enemySize.h
    }

    g_gunTex = trust load_texture(renderer, "sprites/centre_gun.png")
    if g_gunTex != none {
        val gunSize: TextureSize = trust texture_size(g_gunTex)
        gunTexW = gunSize.w
        gunTexH = gunSize.h
    }

    g_bulletTex = trust load_texture(renderer, "sprites/bullet.png")
    if g_bulletTex != none {
        val bulletSize: TextureSize = trust texture_size(g_bulletTex)
        bulletTexW = bulletSize.w
        bulletTexH = bulletSize.h
    }

    g_treeTex = trust load_texture(renderer, "sprites/tree.png")
    g_healthTex = trust load_texture(renderer, "sprites/health.gif")

    rng = trust SDL_GetTicks()
    init_sky()
    init_trees()
    init_pickups()

    val quit: mut bool = false
    val evt: ref SDL_Event = @alloc(@sizeof(SDL_Event))
    val lastTime: mut u32 = trust SDL_GetTicks()

    for {
        if !quit {
            val currentTime: u32 = trust SDL_GetTicks()
            val deltaTime: f32 = ((currentTime - lastTime) as f32) / 1000.0
            lastTime = currentTime
            gameTime += deltaTime

            for {
                if trust SDL_PollEvent(evt) != 0 {
                    if evt.type_value == C.SDL_QUIT {
                        quit = true
                    }
                } else {
                    break
                }
            }

            val keys: ref u8 = trust SDL_GetKeyboardState(none as ref i32)
            val keyA: u8 = trust @load(@ptradd(keys, (C.SDL_SCANCODE_A) * @sizeof(u8)))
            val keyD: u8 = trust @load(@ptradd(keys, (C.SDL_SCANCODE_D) * @sizeof(u8)))
            val keyW: u8 = trust @load(@ptradd(keys, (C.SDL_SCANCODE_W) * @sizeof(u8)))
            val keyS: u8 = trust @load(@ptradd(keys, (C.SDL_SCANCODE_S) * @sizeof(u8)))
            val keyShiftLeft: u8 = trust @load(@ptradd(keys, (C.SDL_SCANCODE_LSHIFT) * @sizeof(u8)))
            val keyShiftRight: u8 = trust @load(@ptradd(
                    keys,
                    (C.SDL_SCANCODE_RSHIFT) * @sizeof(u8)
                ))
            val keyEscape: u8 = trust @load(@ptradd(keys, (C.SDL_SCANCODE_ESCAPE) * @sizeof(u8)))

            if keyEscape != 0 {
                quit = true
            }

            val mouseX: mut i32 = 0
            val mouseY: mut i32 = 0
            trust SDL_GetRelativeMouseState(@addr(mouseX), @addr(mouseY))
            if mouseX != 0 {
                trust rotate_player((mouseX as f32) * 0.0022)
            }

            val mouseScreenX: mut i32 = 0
            val mouseScreenY: mut i32 = 0
            val mouseButtons: u32 = trust SDL_GetMouseState(
                @addr(mouseScreenX),
                @addr(mouseScreenY)
            )
            if (mouseButtons & (C.SDL_BUTTON_LMASK as u32)) != 0 {
                player_shoot()
            }
            pitch = pitch - (mouseY as f32) * 1.1
            if pitch < -260.0 {
                pitch = -260.0
            }
            if pitch > 260.0 {
                pitch = 260.0
            }

            if shootCooldown > 0.0 {
                shootCooldown -= deltaTime
            }
            if muzzleFlashTimer > 0.0 {
                muzzleFlashTimer -= deltaTime
            }
            if hitFlashTimer > 0.0 {
                hitFlashTimer -= deltaTime
            }

            val sprinting: bool = keyShiftLeft != 0 || keyShiftRight != 0
            val isMoving: bool = keyW != 0 || keyS != 0 || keyA != 0 || keyD != 0
            val bobRate: mut f32 = 1.0
            if sprinting {
                bobRate = 1.35
            }
            if isMoving {
                walkTime += deltaTime * bobRate
                footstepTimer -= deltaTime
                if footstepTimer <= 0.0 {
                    play_sound(g_footstepSound)
                    if sprinting {
                        footstepTimer = 0.29
                    } else {
                        footstepTimer = 0.42
                    }
                }
            } else {
                walkTime = 0.0
                footstepTimer = 0.0
            }
            val bobY: i32 = (trust sinf(walkTime * 7.0) * 16.0) as i32
            val bobX: i32 = (trust sinf(walkTime * 3.5) * 24.0) as i32

            val movementSpeed: mut f32 = player.speed
            if sprinting {
                movementSpeed = player.speed * SPRINT_MULTIPLIER
            }

            if keyW != 0 || keyS != 0 {
                val moveDir: mut f32 = -1.0
                if keyW != 0 {
                    moveDir = 1.0
                }

                val stepX: f32 = player.dirX * movementSpeed * moveDir * deltaTime
                val stepY: f32 = player.dirY * movementSpeed * moveDir * deltaTime
                try_move_player(stepX, stepY)
            }

            if keyA != 0 || keyD != 0 {
                val strafeDir: mut f32 = 1.0
                if keyA != 0 {
                    strafeDir = -1.0
                }

                val stepX: f32 = -player.dirY * movementSpeed * strafeDir * deltaTime
                val stepY: f32 = player.dirX * movementSpeed * strafeDir * deltaTime
                try_move_player(stepX, stepY)
            }

            update_enemies(deltaTime)
            update_bullets(deltaTime)
            update_pickups(deltaTime)

            trust SDL_SetRenderDrawColor(renderer, 0 as u8, 0 as u8, 0 as u8, 255 as u8)
            trust SDL_RenderClear(renderer)

            val horizon: f32 = (SCREEN_HEIGHT as f32) / 2.0 + pitch
            draw_sky(horizon, gameTime)
            draw_ground(horizon)

            val pCX: f32 = player.x + 4.0
            val pCY: f32 = player.y + 4.0

            val i: mut i32 = 0
            for i < SCREEN_WIDTH {
                val cameraX: f32 = 2.0 * (i as f32) / (SCREEN_WIDTH as f32) - 1.0
                val rayDX: f32 = player.dirX + player.planeX * cameraX
                val rayDY: f32 = player.dirY + player.planeY * cameraX

                val mX: mut i32 = (pCX / (TILE_SIZE as f32)) as i32
                val mY: mut i32 = (pCY / (TILE_SIZE as f32)) as i32

                val dDX: mut f32 = trust fabsf(1.0 / rayDX)
                if rayDX == 0.0 {
                    dDX = 1e30
                }

                val dDY: mut f32 = trust fabsf(1.0 / rayDY)
                if rayDY == 0.0 {
                    dDY = 1e30
                }

                val sDX: mut f32 = 0.0
                val sDY: mut f32 = 0.0
                val stepX: mut i32 = 0
                val stepY: mut i32 = 0

                if rayDX < 0.0 {
                    stepX = -1
                    sDX = (pCX / (TILE_SIZE as f32) - (mX as f32)) * dDX
                } else {
                    stepX = 1
                    sDX = ((mX as f32) + 1.0 - pCX / (TILE_SIZE as f32)) * dDX
                }

                if rayDY < 0.0 {
                    stepY = -1
                    sDY = (pCY / (TILE_SIZE as f32) - (mY as f32)) * dDY
                } else {
                    stepY = 1
                    sDY = ((mY as f32) + 1.0 - pCY / (TILE_SIZE as f32)) * dDY
                }

                val hit: mut i32 = 0
                val side: mut i32 = 0

                for {
                    if hit == 0 {
                        if sDX < sDY {
                            sDX += dDX
                            mX += stepX
                            side = 0
                        } else {
                            sDY += dDY
                            mY += stepY
                            side = 1
                        }

                        if mX < 0 || mX >= MAP_SIZE || mY < 0 || mY >= MAP_SIZE {
                            break
                        }
                        if map_at(mX, mY) > 0 {
                            hit = 1
                        }
                    } else {
                        break
                    }
                }

                val pWD: mut f32 = sDY - dDY
                if side == 0 {
                    pWD = sDX - dDX
                }
                if pWD < 0.1 {
                    pWD = 0.1
                }

                trust @store(@ptradd(zbuf, (i as usize) * 8), (pWD * 100000.0) as usize)

                val unitH: f32 = (SCREEN_HEIGHT as f32) / pWD
                val wallH: f32 = unitH * (WALL_UNITS / (TILE_SIZE as f32))
                val wallTop: f32 = horizon - wallH * 0.5
                val intensity: f32 = 0.42 + 0.58 / (1.0 + pWD * pWD * 0.02)
                val r: mut u8 = (255.0 * intensity) as u8
                if side == 1 {
                    r = ((r as f32) * 0.7) as u8
                }

                val hitX: f32 = pCX + rayDX * pWD * (TILE_SIZE as f32)
                val hitY: f32 = pCY + rayDY * pWD * (TILE_SIZE as f32)

                val wallPos: mut f32 = hitY - ((mY as f32) * (TILE_SIZE as f32))
                if side == 1 {
                    wallPos = hitX - ((mX as f32) * (TILE_SIZE as f32))
                }
                wallPos = wallPos - (wallPos as i32) as f32
                if wallPos < 0.0 {
                    wallPos += 1.0
                }

                val cellId: i32 = map_at(mX, mY)
                val wall: ref WallTexture = wall_texture_for(cellId)
                if wall.tex != none {
                    val texX: i32 = ((wallPos * CELL_TEX_REPEATS * (wall.w as f32)) as i32) % wall.w
                    if texX >= 0 && texX < wall.w {
                        trust SDL_SetTextureColorMod(wall.tex, r, r, r)
                        val segH: f32 = unitH * (TEX_WORLD_SIZE / (TILE_SIZE as f32))
                        for segment = 0, segment < WALL_TEX_REPEATS, segment++ {
                            val segTop: f32 = wallTop + segH * (segment as f32)
                            val segBottom: f32 = segTop + segH
                            val clipTop: mut f32 = segTop
                            val clipBottom: mut f32 = segBottom
                            if clipTop < 0.0 {
                                clipTop = 0.0
                            }
                            if clipBottom > (SCREEN_HEIGHT as f32) {
                                clipBottom = SCREEN_HEIGHT as f32
                            }
                            if clipBottom > clipTop {
                                val srcTop: i32 = ((clipTop - segTop) / segH * (wall.h as f32)) as i32
                                val srcHeight: mut i32 = ((clipBottom - clipTop) / segH * (wall.h as f32)) as i32
                                if srcHeight < 1 {
                                    srcHeight = 1
                                }
                                g_src_rect.x = texX
                                g_src_rect.y = srcTop
                                g_src_rect.w = 1
                                g_src_rect.h = srcHeight
                                g_dst_rect.x = i
                                g_dst_rect.y = clipTop as i32
                                g_dst_rect.w = 1
                                g_dst_rect.h = (clipBottom - clipTop) as i32
                                trust SDL_RenderCopy(
                                    g_renderer,
                                    wall.tex,
                                    g_src_rect as ref void,
                                    g_dst_rect as ref void
                                )
                            }
                        }
                    }
                } else {
                    trust SDL_SetRenderDrawColor(renderer, r, 0 as u8, 0 as u8, 255 as u8)
                    val clipTop: mut f32 = wallTop
                    val clipBottom: mut f32 = wallTop + wallH
                    if clipTop < 0.0 {
                        clipTop = 0.0
                    }
                    if clipBottom > (SCREEN_HEIGHT as f32) {
                        clipBottom = SCREEN_HEIGHT as f32
                    }
                    if clipBottom > clipTop {
                        g_aux_rect.x = i
                        g_aux_rect.y = clipTop as i32
                        g_aux_rect.w = 1
                        g_aux_rect.h = (clipBottom - clipTop) as i32
                        trust SDL_RenderFillRect(renderer, g_aux_rect)
                    }
                }

                i++
            }

            trust render_billboards()
            render_gun(bobX, bobY, muzzleFlashTimer > 0.0)
            render_crosshair()
            render_damage()
            render_hud()
            render_minimap()
            trust SDL_RenderPresent(renderer)

        } else {
            break
        }
    }

    trust SDL_SetRelativeMouseMode(0 as i32)
    if g_shootSound != none {
        trust Mix_FreeChunk(g_shootSound)
    }
    if g_enemyShootSound != none {
        trust Mix_FreeChunk(g_enemyShootSound)
    }
    if g_hitSound != none {
        trust Mix_FreeChunk(g_hitSound)
    }
    if g_hurtSound != none {
        trust Mix_FreeChunk(g_hurtSound)
    }
    if g_pickupSound != none {
        trust Mix_FreeChunk(g_pickupSound)
    }
    if g_footstepSound != none {
        trust Mix_FreeChunk(g_footstepSound)
    }
    trust Mix_CloseAudio()
    trust SDL_DestroyRenderer(renderer)
    trust SDL_DestroyWindow(window)
    trust SDL_Quit()
    return 0
}
