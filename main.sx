val audio       = use("core/audio.sx")
val combat      = use("game/combat.sx")
val constants   = use("core/constants.sx")
val dead        = use("ui/dead.sx")
val entities    = use("world/entities.sx")
val hud         = use("render/hud.sx")
val mapmod      = use("world/map.sx")
val menu        = use("ui/menu.sx")
val movement    = use("game/player.sx")
val pause       = use("ui/pause.sx")
val platform    = use("core/platform.sx")
val progression = use("core/progression.sx")
val sdl         = use("core/sdl.sx")
val shopui      = use("ui/shop.sx")
val sky         = use("render/sky.sx")
val state       = use("core/state.sx")
val weapons     = use("game/weapons.sx")
val worldrender = use("render/world.sx")

pub fn main() i32 = {
    val st: mut ref state.Game = state.game()
    if !trust mapmod.load_map() {
        trust @print("cubedoom: could not load {s}\n", {constants.MAP_PATH})
        return 1
    }

    trust sdl.SDL_Init(C.SDL_INIT_VIDEO | C.SDL_INIT_AUDIO)
    trust mapmod.apply_spawn()

    val window: ref void = trust sdl.SDL_CreateWindow(
        "cubedoom",
        C.SDL_WINDOWPOS_CENTERED,
        C.SDL_WINDOWPOS_CENTERED,
        constants.SCREEN_WIDTH,
        constants.SCREEN_HEIGHT,
        0 as u32
    )

    val renderer: ref void = trust sdl.SDL_CreateRenderer(
        window,
        -1 as i32,
        C.SDL_RENDERER_ACCELERATED | C.SDL_RENDERER_PRESENTVSYNC
    )
    st.g_renderer = renderer
    trust sdl.SDL_SetHint("SDL_RENDER_SCALE_QUALITY", "1")

    trust sdl.Mix_OpenAudio(44100 as i32, C.AUDIO_S16SYS, 2 as i32, 1024 as i32)
    st.g_shootSound = trust audio.load_sound("sounds/shoot_machinegun.wav", 55)
    st.g_shootShotgunSound = trust audio.load_sound("sounds/shoot_shotgun.wav", 70)
    st.g_shootPlasmaSound = trust audio.load_sound("sounds/shoot_plasma.wav", 56)
    st.g_enemyShootSound = trust audio.load_sound("sounds/enemy_shoot.wav", 32)
    st.g_hitSound = trust audio.load_sound("sounds/hit.wav", 48)
    st.g_hurtSound = trust audio.load_sound("sounds/hurt.wav", 78)
    st.g_pickupSound = trust audio.load_sound("sounds/pickup.wav", 62)
    st.g_footstepSound = trust audio.load_sound("sounds/footstep.wav", 26)
    st.g_switchMachineSound = trust audio.load_sound("sounds/weapon_machinegun.wav", 52)
    st.g_switchShotgunSound = trust audio.load_sound("sounds/weapon_shotgun.wav", 58)
    st.g_switchPlasmaSound = trust audio.load_sound("sounds/weapon_plasma.wav", 50)
    st.g_reloadShotgun1Sound = trust audio.load_sound("sounds/reload_shotgun_1.wav", 46)
    st.g_reloadShotgun2Sound = trust audio.load_sound("sounds/reload_shotgun_2.wav", 48)
    st.g_jumpSound = trust audio.load_sound("sounds/hup.wav", 58)
    st.g_xpSound = trust audio.load_sound("sounds/xp.wav", 46)
    st.g_buySound = trust audio.load_sound("sounds/buy.wav", 58)
    st.g_clickSound = trust audio.load_sound("sounds/click.wav", 38)
    st.g_waveSound = trust audio.load_sound("sounds/wave_start.wav", 56)
    st.g_deathSound = trust audio.load_sound("sounds/death.wav", 68)

    st.zbuf = @alloc((constants.SCREEN_WIDTH as usize) * 8)
    trust @memset(st.zbuf, 127, (constants.SCREEN_WIDTH as usize) * 8)

    st.enemies_buf = @alloc((constants.MAX_ENEMIES as usize) * @sizeof(state.Enemy))
    trust @memset(st.enemies_buf, 0, (constants.MAX_ENEMIES as usize) * @sizeof(state.Enemy))
    trust entities.init_enemies()

    st.bullets_buf = @alloc((constants.MAX_BULLETS as usize) * @sizeof(state.Bullet))
    trust @memset(st.bullets_buf, 0, (constants.MAX_BULLETS as usize) * @sizeof(state.Bullet))

    st.g_src_rect = @alloc(@sizeof(sdl.SDL_Rect)) as ref sdl.SDL_Rect
    st.g_dst_rect = @alloc(@sizeof(sdl.SDL_Rect)) as ref sdl.SDL_Rect
    st.g_aux_rect = @alloc(@sizeof(sdl.SDL_Rect)) as ref sdl.SDL_Rect
    st.g_columns = @alloc((constants.SCREEN_WIDTH as usize) * @sizeof(state.ColumnInfo))
    st.g_vertices = @alloc((constants.SCREEN_WIDTH as usize) * 2 * @sizeof(sdl.SDL_Vertex))
    st.g_indices = @alloc((constants.SCREEN_WIDTH as usize) * 6 * @sizeof(i32))

    trust worldrender.load_wall_texture(renderer, "textures/QUAKE101/tech08_2.png", 0)
    trust worldrender.load_wall_texture(renderer, "textures/QUAKE101/dung01_1.png", 1)
    trust worldrender.load_wall_texture(renderer, "textures/QUAKE101/tech07_2.png", 2)

    st.g_enemyTex = trust worldrender.load_texture(renderer, "sprites/enemy.gif")
    if st.g_enemyTex != none {
        val enemySize: state.TextureSize = trust worldrender.texture_size(st.g_enemyTex)
        st.enemyTexW = enemySize.w
        st.enemyTexH = enemySize.h
    }

    st.g_machineGunTex = trust worldrender.load_texture(renderer, "sprites/guns/machine_gun.png")
    if st.g_machineGunTex != none {
        val gunSize: state.TextureSize = trust worldrender.texture_size(st.g_machineGunTex)
        st.gunTexW = gunSize.w
        st.gunTexH = gunSize.h
    }
    st.g_shotgunTex = trust worldrender.load_texture(renderer, "sprites/guns/shotgun.png")
    st.g_shotgunReload1Tex = trust worldrender.load_texture(
        renderer,
        "sprites/guns/shotgun_reload_1.png"
    )
    st.g_shotgunReload2Tex = trust worldrender.load_texture(
        renderer,
        "sprites/guns/shotgun_reload_2.png"
    )
    st.g_plasmaTex = trust worldrender.load_texture(renderer, "sprites/guns/plasma_rifle.png")

    st.g_bulletTex = trust worldrender.load_texture(renderer, "sprites/bullet.png")
    if st.g_bulletTex != none {
        val bulletSize: state.TextureSize = trust worldrender.texture_size(st.g_bulletTex)
        st.bulletTexW = bulletSize.w
        st.bulletTexH = bulletSize.h
    }

    st.g_treeTex = trust worldrender.load_texture(renderer, "sprites/tree.png")
    st.g_healthTex = trust worldrender.load_texture(renderer, "sprites/health.gif")
    st.g_boothTex = trust worldrender.load_texture(renderer, "sprites/booth.png")
    if st.g_boothTex != none {
        val boothSize: state.TextureSize = trust worldrender.texture_size(st.g_boothTex)
        st.boothTexW = boothSize.w
        st.boothTexH = boothSize.h
    }

    st.rng = trust sdl.SDL_GetTicks()
    sky.init_sky()
    entities.init_trees()
    entities.init_pickups()
    entities.init_booth()
    trust progression.load_progress()
    st.playerHealth = progression.max_health()
    st.gameState = constants.STATE_MENU
    trust platform.set_relative_mouse(false)

    val evt: ref sdl.SDL_Event = @alloc(@sizeof(sdl.SDL_Event))
    val lastTime: mut u32 = trust sdl.SDL_GetTicks()

    for {
        val currentTime: u32 = trust sdl.SDL_GetTicks()
        val deltaTime: mut f32 = ((currentTime - lastTime) as f32) / 1000.0
        lastTime = currentTime
        if deltaTime > 0.06 {
            deltaTime = 0.06
        }
        st.gameTime += deltaTime

        for {
            if trust sdl.SDL_PollEvent(evt) != 0 {
                if evt.type_value == C.SDL_QUIT {
                    st.quitRequested = true
                }
            } else {
                break
            }
        }
        if st.quitRequested {
            break
        }

        val keys: ref u8 = trust sdl.SDL_GetKeyboardState(none as ref i32)
        val keyA: u8 = trust @load(@ptradd(keys, (C.SDL_SCANCODE_A) * @sizeof(u8)))
        val keyD: u8 = trust @load(@ptradd(keys, (C.SDL_SCANCODE_D) * @sizeof(u8)))
        val keyW: u8 = trust @load(@ptradd(keys, (C.SDL_SCANCODE_W) * @sizeof(u8)))
        val keyS: u8 = trust @load(@ptradd(keys, (C.SDL_SCANCODE_S) * @sizeof(u8)))
        val keyShiftLeft: u8 = trust @load(@ptradd(keys, (C.SDL_SCANCODE_LSHIFT) * @sizeof(u8)))
        val keyShiftRight: u8 = trust @load(@ptradd(
                keys,
                (C.SDL_SCANCODE_RSHIFT) * @sizeof(u8)
            ))
        val keyE: u8 = trust @load(@ptradd(keys, (C.SDL_SCANCODE_E) * @sizeof(u8)))
        val keyEscape: u8 = trust @load(@ptradd(keys, (C.SDL_SCANCODE_ESCAPE) * @sizeof(u8)))
        val keyEnter: u8 = trust @load(@ptradd(keys, (C.SDL_SCANCODE_RETURN) * @sizeof(u8)))
        val keySpace: u8 = trust @load(@ptradd(keys, (C.SDL_SCANCODE_SPACE) * @sizeof(u8)))
        val key1: u8 = trust @load(@ptradd(keys, (C.SDL_SCANCODE_1) * @sizeof(u8)))
        val key2: u8 = trust @load(@ptradd(keys, (C.SDL_SCANCODE_2) * @sizeof(u8)))
        val key3: u8 = trust @load(@ptradd(keys, (C.SDL_SCANCODE_3) * @sizeof(u8)))
        val key4: u8 = trust @load(@ptradd(keys, (C.SDL_SCANCODE_4) * @sizeof(u8)))
        val key5: u8 = trust @load(@ptradd(keys, (C.SDL_SCANCODE_5) * @sizeof(u8)))
        val key6: u8 = trust @load(@ptradd(keys, (C.SDL_SCANCODE_6) * @sizeof(u8)))
        val keyF12: u8 = trust @load(@ptradd(keys, (C.SDL_SCANCODE_F12) * @sizeof(u8)))

        st.inputEPressed = keyE != 0 && st.prevE == 0
        st.inputEscapePressed = keyEscape != 0 && st.prevEscape == 0
        st.inputEnterPressed = keyEnter != 0 && st.prevEnter == 0
        st.inputSpacePressed = keySpace != 0 && st.prevSpace == 0
        st.inputF12Pressed = keyF12 != 0 && st.prevF12 == 0
        st.inputNum1 = key1 != 0 && st.prevNum1 == 0
        st.inputNum2 = key2 != 0 && st.prevNum2 == 0
        st.inputNum3 = key3 != 0 && st.prevNum3 == 0
        st.inputNum4 = key4 != 0 && st.prevNum4 == 0
        st.inputNum5 = key5 != 0 && st.prevNum5 == 0
        st.inputNum6 = key6 != 0 && st.prevNum6 == 0

        val mouseScreenX: mut i32 = 0
        val mouseScreenY: mut i32 = 0
        val mouseButtons: u32 = trust sdl.SDL_GetMouseState(
            @addr(mouseScreenX),
            @addr(mouseScreenY)
        )
        val mouseDown: bool = (mouseButtons & (C.SDL_BUTTON_LMASK as u32)) != 0
        st.inputMouseX = mouseScreenX
        st.inputMouseY = mouseScreenY
        st.uiMouseX = mouseScreenX
        st.uiMouseY = mouseScreenY
        st.inputClick = mouseDown && !st.prevMouseDown

        if st.gameState == constants.STATE_MENU {
            trust platform.set_relative_mouse(false)
            trust menu.update_menu()
            trust menu.render_menu()
        } elif st.gameState == constants.STATE_PAUSED {
            trust platform.set_relative_mouse(false)
            trust pause.update_pause()
            trust pause.render_pause()
        } elif st.gameState == constants.STATE_SHOP {
            trust platform.set_relative_mouse(false)
            trust shopui.update_shop()
            trust shopui.render_shop()
        } elif st.gameState == constants.STATE_DEAD {
            trust platform.set_relative_mouse(false)
            trust dead.update_dead()
            trust dead.render_dead()
        } else {
            trust platform.set_relative_mouse(true)

            val mouseX: mut i32 = 0
            val mouseY: mut i32 = 0
            trust sdl.SDL_GetRelativeMouseState(@addr(mouseX), @addr(mouseY))
            if mouseX != 0 {
                trust movement.rotate_player((mouseX as f32) * 0.0022)
            }
            st.pitch = st.pitch - (mouseY as f32) * 1.1
            if st.pitch < -260.0 {
                st.pitch = -260.0
            }
            if st.pitch > 260.0 {
                st.pitch = 260.0
            }

            val nearBooth: bool = st.boothFound && (st.boothX - (st.player.x + 4.0)) * (st.boothX - (st.player.x + 4.0)) + (st.boothY - (st.player.y + 4.0)) * (st.boothY - (st.player.y + 4.0)) < 12000.0

            if st.inputEPressed && nearBooth {
                audio.play_sound(st.g_clickSound)
                st.gameState = constants.STATE_SHOP
                trust platform.set_relative_mouse(false)
                trust shopui.render_shop()
            } elif st.inputEscapePressed {
                audio.play_sound(st.g_clickSound)
                st.gameState = constants.STATE_PAUSED
                trust platform.set_relative_mouse(false)
                trust pause.render_pause()
            } else {
                if st.inputNum1 {
                    weapons.switch_weapon(constants.WEAPON_MACHINE_GUN)
                } elif st.inputNum2 {
                    weapons.switch_weapon(constants.WEAPON_SHOTGUN)
                } elif st.inputNum3 {
                    weapons.switch_weapon(constants.WEAPON_PLASMA)
                }

                if st.inputSpacePressed && st.onGround {
                    st.playerVZ = 330.0
                    st.onGround = false
                    audio.play_sound(st.g_jumpSound)
                }

                if mouseDown {
                    combat.player_shoot()
                }

                if st.shootCooldown > 0.0 {
                    st.shootCooldown -= deltaTime
                }
                if st.muzzleFlashTimer > 0.0 {
                    st.muzzleFlashTimer -= deltaTime
                }
                if st.hitFlashTimer > 0.0 {
                    st.hitFlashTimer -= deltaTime
                }

                if st.weaponEquip < 1.0 {
                    st.weaponEquip += deltaTime / 0.34
                    if st.weaponEquip > 1.0 {
                        st.weaponEquip = 1.0
                    }
                }

                if st.shotgunReloadTimer > 0.0 {
                    st.shotgunReloadTimer -= deltaTime
                    val stage: mut i32 = 0
                    if st.shotgunReloadTimer > 0.55 {
                        stage = 0
                    } elif st.shotgunReloadTimer > 0.35 {
                        stage = 1
                    } elif st.shotgunReloadTimer > 0.15 {
                        stage = 2
                    }
                    if stage != st.shotgunReloadStage {
                        if stage == 1 {
                            audio.play_sound(st.g_reloadShotgun1Sound)
                        } elif stage == 2 {
                            audio.play_sound(st.g_reloadShotgun2Sound)
                        }
                        st.shotgunReloadStage = stage
                    }
                    if st.shotgunReloadTimer <= 0.0 {
                        st.shotgunReloadTimer = 0.0
                        st.shotgunReloadStage = 0
                    }
                }

                if !st.onGround {
                    st.playerVZ -= 1050.0 * deltaTime
                    st.playerZ += st.playerVZ * deltaTime
                    if st.playerZ <= 0.0 {
                        st.playerZ = 0.0
                        st.playerVZ = 0.0
                        st.onGround = true
                    }
                }

                val sprinting: bool = keyShiftLeft != 0 || keyShiftRight != 0
                val isMoving: bool = keyW != 0 || keyS != 0 || keyA != 0 || keyD != 0
                val bobRate: mut f32 = 1.0
                if sprinting {
                    bobRate = 1.35
                }
                if isMoving {
                    st.walkTime += deltaTime * bobRate
                    st.footstepTimer -= deltaTime
                    if st.footstepTimer <= 0.0 {
                        audio.play_sound(st.g_footstepSound)
                        if sprinting {
                            st.footstepTimer = 0.29
                        } else {
                            st.footstepTimer = 0.42
                        }
                    }
                } else {
                    st.walkTime = 0.0
                    st.footstepTimer = 0.0
                }
                val bobY: i32 = (trust sdl.sinf(st.walkTime * 7.0) * 16.0) as i32
                val bobX: i32 = (trust sdl.sinf(st.walkTime * 3.5) * 24.0) as i32

                val speedBonus: f32 = 1.0 + (st.progress.speedLevel as f32) * 0.08
                val movementSpeed: mut f32 = st.player.speed * speedBonus
                if sprinting {
                    movementSpeed = st.player.speed * speedBonus * constants.SPRINT_MULTIPLIER
                }

                if keyW != 0 || keyS != 0 {
                    val moveDir: mut f32 = -1.0
                    if keyW != 0 {
                        moveDir = 1.0
                    }

                    val stepX: f32 = st.player.dirX * movementSpeed * moveDir * deltaTime
                    val stepY: f32 = st.player.dirY * movementSpeed * moveDir * deltaTime
                    movement.try_move_player(stepX, stepY)
                }

                if keyA != 0 || keyD != 0 {
                    val strafeDir: mut f32 = 1.0
                    if keyA != 0 {
                        strafeDir = -1.0
                    }

                    val stepX: f32 = -st.player.dirY * movementSpeed * strafeDir * deltaTime
                    val stepY: f32 = st.player.dirX * movementSpeed * strafeDir * deltaTime
                    movement.try_move_player(stepX, stepY)
                }

                combat.update_enemies(deltaTime)
                combat.update_bullets(deltaTime)
                entities.update_pickups(deltaTime)
                combat.update_xp_orbs()
                combat.update_wave(deltaTime)

                if st.playerHealth <= 0 {
                    trust dead.enter_death()
                    trust dead.render_dead()
                } else {
                    trust sdl.SDL_SetRenderDrawColor(renderer, 0 as u8, 0 as u8, 0 as u8, 255 as u8)
                    trust sdl.SDL_RenderClear(renderer)

                    val horizon: f32 = (constants.SCREEN_HEIGHT as f32) / 2.0 + st.pitch + st.playerZ
                    sky.draw_sky(horizon, st.gameTime)
                    sky.draw_ground(horizon)

                    val pCX: f32 = st.player.x + 4.0
                    val pCY: f32 = st.player.y + 4.0
                    val span: mut state.WallSpan = @zeroed

                    val i: mut i32 = 0
                    for i < constants.SCREEN_WIDTH {
                        val cameraX: f32 = 2.0 * (i as f32) / (constants.SCREEN_WIDTH as f32) - 1.0
                        val rayDX: f32 = st.player.dirX + st.player.planeX * cameraX
                        val rayDY: f32 = st.player.dirY + st.player.planeY * cameraX

                        val mX: mut i32 = (pCX / (constants.TILE_SIZE as f32)) as i32
                        val mY: mut i32 = (pCY / (constants.TILE_SIZE as f32)) as i32

                        val dDX: mut f32 = trust sdl.fabsf(1.0 / rayDX)
                        if rayDX == 0.0 {
                            dDX = 1e30
                        }

                        val dDY: mut f32 = trust sdl.fabsf(1.0 / rayDY)
                        if rayDY == 0.0 {
                            dDY = 1e30
                        }

                        val sDX: mut f32 = 0.0
                        val sDY: mut f32 = 0.0
                        val stepX: mut i32 = 0
                        val stepY: mut i32 = 0

                        if rayDX < 0.0 {
                            stepX = -1
                            sDX = (pCX / (constants.TILE_SIZE as f32) - (mX as f32)) * dDX
                        } else {
                            stepX = 1
                            sDX = ((mX as f32) + 1.0 - pCX / (constants.TILE_SIZE as f32)) * dDX
                        }

                        if rayDY < 0.0 {
                            stepY = -1
                            sDY = (pCY / (constants.TILE_SIZE as f32) - (mY as f32)) * dDY
                        } else {
                            stepY = 1
                            sDY = ((mY as f32) + 1.0 - pCY / (constants.TILE_SIZE as f32)) * dDY
                        }

                        val hit: mut i32 = 0
                        val side: mut i32 = 0

                        for {
                            if hit == 0 {
                                if sDX < sDY {
                                    sDX += dDX
                                    mX += stepX
                                    side = 0
                                } else {
                                    sDY += dDY
                                    mY += stepY
                                    side = 1
                                }

                                if mX < 0 || mX >= constants.MAP_SIZE || mY < 0 || mY >= constants.MAP_SIZE {
                                    break
                                }
                                if mapmod.map_at(mX, mY) > 0 {
                                    hit = 1
                                }
                            } else {
                                break
                            }
                        }

                        val pWD: mut f32 = sDY - dDY
                        if side == 0 {
                            pWD = sDX - dDX
                        }
                        if pWD < 0.1 {
                            pWD = 0.1
                        }

                        trust @store(@ptradd(st.zbuf, (i as usize) * 8), (pWD * 100000.0) as usize)

                        val unitH: f32 = (constants.SCREEN_HEIGHT as f32) / pWD
                        val wallH: f32 = unitH * (constants.WALL_UNITS / (constants.TILE_SIZE as f32))
                        val wallTop: f32 = horizon - wallH * 0.5
                        val intensity: f32 = 0.42 + 0.58 / (1.0 + pWD * pWD * 0.02)
                        val r: mut u8 = (255.0 * intensity) as u8
                        if side == 1 {
                            r = ((r as f32) * 0.7) as u8
                        }

                        val hitX: f32 = pCX + rayDX * pWD * (constants.TILE_SIZE as f32)
                        val hitY: f32 = pCY + rayDY * pWD * (constants.TILE_SIZE as f32)

                        val wallPos: mut f32 = hitY / (constants.TILE_SIZE as f32) - (mY as f32)
                        if side == 1 {
                            wallPos = hitX / (constants.TILE_SIZE as f32) - (mX as f32)
                        }
                        wallPos = wallPos - (wallPos as i32) as f32
                        if wallPos < 0.0 {
                            wallPos += 1.0
                        }

                        val faceSign: mut i32 = stepY
                        if side == 0 {
                            faceSign = stepX
                        }
                        val sameWall: bool = span.active != 0 && span.cell_x == mX && span.cell_y == mY && span.side == side && span.face_sign == faceSign
                        if !sameWall {
                            trust worldrender.wall_span_flush(@addr(span))
                            span.active = 1
                            span.start_x = i
                            span.cell_x = mX
                            span.cell_y = mY
                            span.side = side
                            span.face_sign = faceSign
                        }
                        span.end_x = i

                        val column: mut ref state.ColumnInfo = state.column_info(i)
                        column.top = wallTop
                        column.bottom = wallTop + wallH
                        column.tex = wallPos
                        column.shade = r

                        i++
                    }

                    trust worldrender.wall_span_flush(@addr(span))
                    trust worldrender.render_billboards()
                    trust hud.render_gun(bobX, bobY, st.muzzleFlashTimer > 0.0)
                    hud.render_crosshair()
                    hud.render_damage()
                    trust hud.render_hud()
                    hud.render_minimap()
                }
            }
        }

        st.prevE = keyE
        st.prevEscape = keyEscape
        st.prevEnter = keyEnter
        st.prevSpace = keySpace
        st.prevF12 = keyF12
        st.prevNum1 = key1
        st.prevNum2 = key2
        st.prevNum3 = key3
        st.prevNum4 = key4
        st.prevNum5 = key5
        st.prevNum6 = key6
        st.prevMouseDown = mouseDown

        if st.inputF12Pressed {
            trust platform.take_screenshot()
        }
        trust sdl.SDL_RenderPresent(renderer)
        if st.quitRequested {
            break
        }
    }

    trust platform.set_relative_mouse(false)
    if st.g_shootSound != none {
        trust sdl.Mix_FreeChunk(st.g_shootSound)
    }
    if st.g_shootShotgunSound != none {
        trust sdl.Mix_FreeChunk(st.g_shootShotgunSound)
    }
    if st.g_shootPlasmaSound != none {
        trust sdl.Mix_FreeChunk(st.g_shootPlasmaSound)
    }
    if st.g_enemyShootSound != none {
        trust sdl.Mix_FreeChunk(st.g_enemyShootSound)
    }
    if st.g_hitSound != none {
        trust sdl.Mix_FreeChunk(st.g_hitSound)
    }
    if st.g_hurtSound != none {
        trust sdl.Mix_FreeChunk(st.g_hurtSound)
    }
    if st.g_pickupSound != none {
        trust sdl.Mix_FreeChunk(st.g_pickupSound)
    }
    if st.g_footstepSound != none {
        trust sdl.Mix_FreeChunk(st.g_footstepSound)
    }
    if st.g_switchMachineSound != none {
        trust sdl.Mix_FreeChunk(st.g_switchMachineSound)
    }
    if st.g_switchShotgunSound != none {
        trust sdl.Mix_FreeChunk(st.g_switchShotgunSound)
    }
    if st.g_switchPlasmaSound != none {
        trust sdl.Mix_FreeChunk(st.g_switchPlasmaSound)
    }
    if st.g_reloadShotgun1Sound != none {
        trust sdl.Mix_FreeChunk(st.g_reloadShotgun1Sound)
    }
    if st.g_reloadShotgun2Sound != none {
        trust sdl.Mix_FreeChunk(st.g_reloadShotgun2Sound)
    }
    if st.g_jumpSound != none {
        trust sdl.Mix_FreeChunk(st.g_jumpSound)
    }
    if st.g_xpSound != none {
        trust sdl.Mix_FreeChunk(st.g_xpSound)
    }
    if st.g_buySound != none {
        trust sdl.Mix_FreeChunk(st.g_buySound)
    }
    if st.g_clickSound != none {
        trust sdl.Mix_FreeChunk(st.g_clickSound)
    }
    if st.g_waveSound != none {
        trust sdl.Mix_FreeChunk(st.g_waveSound)
    }
    if st.g_deathSound != none {
        trust sdl.Mix_FreeChunk(st.g_deathSound)
    }
    trust sdl.Mix_CloseAudio()
    trust sdl.SDL_DestroyRenderer(renderer)
    trust sdl.SDL_DestroyWindow(window)
    trust sdl.SDL_Quit()
    return 0
}
