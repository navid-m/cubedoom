extern "SDL.h"
extern "SDL_image.h"

link "-lSDL2"
link "-lSDL2_image"
link "-lm"

val fs  = use("std/fs")
val str = use("std/string")
val fmt = use("std/fmt")

val MAP_SIZE: i32 = 32
val TILE_SIZE: i32 = 64
val MAP_PATH: ref u8 = "maps/cubedoom.map"
val SCREEN_WIDTH: i32 = 1280
val SCREEN_HEIGHT: i32 = 960
val MAX_ENEMIES: i32 = 6
val MAX_BULLETS: i32 = 32
val ENEMY_SPEED: f32 = 50.0
val BULLET_SPEED: f32 = 250.0
val SHOOT_COOLDOWN_VAL: f32 = 0.4
val ENEMY_SHOOT_INTERVAL: f32 = 2.0
val PI: f32 = 3.14159265

extern type SDL_Rect = {
    x: mut i32
    y: mut i32
    w: mut i32
    h: mut i32
}

extern type SDL_Event = {
    type_value: mut u32
    padding: mut [52]u8
}

extern type Player = {
    x: mut f32
    y: mut f32
    dirX: mut f32
    dirY: mut f32
    planeX: mut f32
    planeY: mut f32
    w: mut f32
    h: mut f32
    speed: mut f32
    rotSpeed: mut f32
}

extern type Enemy = {
    x: mut f32
    y: mut f32
    health: mut i32
    alive: mut i32
    shootTimer: mut f32
}

extern type Bullet = {
    x: mut f32
    y: mut f32
    dx: mut f32
    dy: mut f32
    alive: mut i32
    isPlayer: mut i32
    animTime: mut f32
}

type WallTexture = {
    tex: mut ref void
    w: mut i32
    h: mut i32
}

type TextureSize = {
    w: mut i32
    h: mut i32
}

type SpawnPoint = {
    x: mut f32
    y: mut f32
}

type BrushBounds = {
    minX: mut f32
    minY: mut f32
    minZ: mut f32
    maxX: mut f32
    maxY: mut f32
    maxZ: mut f32
    hasFace: mut bool
    texture: [128]u8
}

