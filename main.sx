fn render_minimap() void = {
    val scale: f32 = 0.075
    val cell: f32 = (TILE_SIZE as f32) * scale
    val mapSize: i32 = (MAP_SIZE as f32 * cell) as i32
    val originX: i32 = SCREEN_WIDTH - mapSize - 24
    val originY: i32 = 24

    trust SDL_SetRenderDrawBlendMode(g_renderer, 1 as i32)
    trust SDL_SetRenderDrawColor(g_renderer, 6 as u8, 8 as u8, 12 as u8, 125 as u8)
    g_aux_rect.x = originX - 8
    g_aux_rect.y = originY - 8
    g_aux_rect.w = mapSize + 16
    g_aux_rect.h = mapSize + 16
    trust SDL_RenderFillRect(g_renderer, g_aux_rect)

    for y = 0, y < MAP_SIZE, y++ {
        for x = 0, x < MAP_SIZE, x++ {
            val cellValue: i32 = map_at(x, y)
            if cellValue != 0 {
                val r: mut u8 = 70
                val g: mut u8 = 82
                val b: mut u8 = 96
                if cellValue == 2 {
                    r = 112
                    g = 96
                    b = 78
                } elif cellValue == 3 {
                    r = 92
                    g = 100
                    b = 112
                }
                trust SDL_SetRenderDrawColor(g_renderer, r, g, b, 105 as u8)
                g_aux_rect.x = originX + ((x as f32) * cell) as i32
                g_aux_rect.y = originY + ((y as f32) * cell) as i32
                g_aux_rect.w = cell as i32
                g_aux_rect.h = cell as i32
                trust SDL_RenderFillRect(g_renderer, g_aux_rect)
            }
        }
    }

    for index = 0, index < MAX_HEALTH_PICKUPS, index++ {
        val pickup: ref HealthPickup = pickup_at(index)
        if pickup.active != 0 {
            trust SDL_SetRenderDrawColor(g_renderer, 80 as u8, 235 as u8, 125 as u8, 210 as u8)
            g_aux_rect.x = originX + (pickup.x * scale) as i32 - 2
            g_aux_rect.y = originY + (pickup.y * scale) as i32 - 2
            g_aux_rect.w = 4
            g_aux_rect.h = 4
            trust SDL_RenderFillRect(g_renderer, g_aux_rect)
        }
    }

    for index = 0, index < MAX_ENEMIES, index++ {
        val enemy: ref Enemy = get_enemy(index)
        if enemy.alive != 0 {
            trust SDL_SetRenderDrawColor(g_renderer, 235 as u8, 70 as u8, 70 as u8, 205 as u8)
            g_aux_rect.x = originX + (enemy.x * scale) as i32 - 2
            g_aux_rect.y = originY + (enemy.y * scale) as i32 - 2
            g_aux_rect.w = 4
            g_aux_rect.h = 4
            trust SDL_RenderFillRect(g_renderer, g_aux_rect)
        }
    }

    trust SDL_SetRenderDrawColor(g_renderer, 120 as u8, 225 as u8, 255 as u8, 240 as u8)
    g_aux_rect.x = originX + (player.x * scale) as i32 - 2
    g_aux_rect.y = originY + (player.y * scale) as i32 - 2
    g_aux_rect.w = 5
    g_aux_rect.h = 5
    trust SDL_RenderFillRect(g_renderer, g_aux_rect)
    trust SDL_SetRenderDrawBlendMode(g_renderer, 0 as i32)
}

fn render_hud() void = trust {
    SDL_SetRenderDrawBlendMode(g_renderer, 1 as i32)

    SDL_SetRenderDrawColor(g_renderer, 8 as u8, 10 as u8, 14 as u8, 175 as u8)
    g_aux_rect.x = 24
    g_aux_rect.y = SCREEN_HEIGHT - 42
    g_aux_rect.w = 212
    g_aux_rect.h = 20
    SDL_RenderFillRect(g_renderer, g_aux_rect)

    val healthR: mut u8 = 72
    val healthG: mut u8 = 225
    val healthB: mut u8 = 132
    if playerHealth < 30 {
        healthR = 242
        healthG = 70
        healthB = 70
    } elif playerHealth < 60 {
        healthR = 242
        healthG = 184
        healthB = 72
    }

    SDL_SetRenderDrawColor(g_renderer, healthR, healthG, healthB, 235 as u8)
    g_aux_rect.x = 29
    g_aux_rect.y = SCREEN_HEIGHT - 37
    g_aux_rect.w = playerHealth * 202 / max_health()
    g_aux_rect.h = 10
    SDL_RenderFillRect(g_renderer, g_aux_rect)

    g_aux_rect.x = 15
    g_aux_rect.y = SCREEN_HEIGHT - 37
    g_aux_rect.w = 4
    g_aux_rect.h = 12
    SDL_RenderFillRect(g_renderer, g_aux_rect)
    g_aux_rect.x = 11
    g_aux_rect.y = SCREEN_HEIGHT - 33
    g_aux_rect.w = 12
    g_aux_rect.h = 4
    SDL_RenderFillRect(g_renderer, g_aux_rect)

    SDL_SetRenderDrawBlendMode(g_renderer, 0 as i32)

    draw_text(28, 24, "WAVE", 3, 255 as u8, 196 as u8, 72 as u8, 255 as u8)
    draw_int(112, 20, wave, 4, 255 as u8, 236 as u8, 154 as u8, 255 as u8)
    draw_text(28, 70, "LEFT", 2, 150 as u8, 165 as u8, 180 as u8, 255 as u8)
    val left: mut i32 = waveTarget - waveKilled
    if left < 0 {
        left = 0
    }
    draw_int(84, 66, left, 3, 220 as u8, 228 as u8, 238 as u8, 255 as u8)
    draw_text(28, 112, "XP", 2, 255 as u8, 196 as u8, 72 as u8, 255 as u8)
    draw_int(66, 106, progress.xp, 3, 255 as u8, 218 as u8, 110 as u8, 255 as u8)

    val wname: ref u8 = weapon_name(currentWeapon)
    val wnameWidth: i32 = text_width(wname, 3)
    draw_text(
        SCREEN_WIDTH - 28 - wnameWidth,
        SCREEN_HEIGHT - 58,
        wname,
        3,
        220 as u8,
        228 as u8,
        238 as u8,
        255 as u8
    )
    draw_text(
        SCREEN_WIDTH - 28 - text_width("1 2 3 SWITCH", 2),
        SCREEN_HEIGHT - 92,
        "1 2 3 SWITCH",
        2,
        120 as u8,
        132 as u8,
        146 as u8,
        255 as u8
    )

    if boothFound {
        val bdx: f32 = boothX - (player.x + 4.0)
        val bdy: f32 = boothY - (player.y + 4.0)
        if bdx * bdx + bdy * bdy < 12000.0 {
            draw_glow(
                SCREEN_WIDTH / 2,
                SCREEN_HEIGHT - 170,
                120,
                255 as u8,
                190 as u8,
                64 as u8,
                34 as u8
            )
            draw_text_centered(
                SCREEN_WIDTH / 2,
                SCREEN_HEIGHT - 184,
                "PRESS E TO OPEN UPGRADES",
                3,
                255 as u8,
                222 as u8,
                128 as u8,
                255 as u8
            )
        }
    }

    if waveIntermission > 0.0 {
        draw_text_centered(
            SCREEN_WIDTH / 2,
            190,
            "WAVE CLEARED",
            6,
            255 as u8,
            214 as u8,
            92 as u8,
            255 as u8
        )
    }
}

fn load_texture(renderer: ref void, path: ref u8) ref void = trust {
    val surface: ref void = IMG_Load(path)
    if surface == none {
        return none
    }
    val texture: ref void = SDL_CreateTextureFromSurface(renderer, surface)
    SDL_FreeSurface(surface)
    if texture != none {
        SDL_SetTextureBlendMode(texture, 1 as i32)
    }
    return texture
}

fn texture_size(texture: ref void) TextureSize = trust {
    val size: mut TextureSize = @zeroed
    SDL_QueryTexture(
        texture,
        none as ref void,
        none as ref void,
        @addr(size.w) as ref void,
        @addr(size.h) as ref void
    )
    if size.w < 1 {
        size.w = 1
    }
    if size.h < 1 {
        size.h = 1
    }
    return size
}

fn load_wall_texture(renderer: ref void, path: ref u8, index: i32) void = trust {
    val texture: ref void = load_texture(renderer, path)
    if texture == none {
        return
    }
    val wall: mut ref WallTexture = wall_texture(index)
    val size: TextureSize = texture_size(texture)
    wall.tex = texture
    wall.w = size.w
    wall.h = size.h
}

fn wall_texture_for(id: i32) mut ref WallTexture = {
    if id == 2 {
        return wall_texture(1)
    }
    if id == 3 {
        return wall_texture(2)
    }
    return wall_texture(0)
}

fn wall_span_flush(span: mut ref WallSpan) void = trust {
    if span.active == 0 {
        return
    }
    span.active = 0

    val spanWidth: i32 = span.end_x - span.start_x + 1
    if spanWidth <= 0 {
        return
    }

    val cellId: i32 = map_at(span.cell_x, span.cell_y)
    val wall: ref WallTexture = wall_texture_for(cellId)

    if wall.tex == none {
        val column: ref ColumnInfo = column_info(span.start_x)
        val clipTop: mut f32 = column.top
        val clipBottom: mut f32 = column.bottom
        if clipTop < 0.0 {
            clipTop = 0.0
        }
        if clipBottom > (SCREEN_HEIGHT as f32) {
            clipBottom = SCREEN_HEIGHT as f32
        }
        if clipBottom > clipTop {
            SDL_SetRenderDrawColor(g_renderer, 255, 0, 0, 255)
            g_aux_rect.x = span.start_x
            g_aux_rect.y = clipTop as i32
            g_aux_rect.w = spanWidth
            g_aux_rect.h = (clipBottom - clipTop) as i32
            SDL_RenderFillRect(g_renderer, g_aux_rect)
        }
        return
    }

    if spanWidth == 1 {
        val column: ref ColumnInfo = column_info(span.start_x)
        val wallHeight: f32 = column.bottom - column.top
        val segHeight: f32 = wallHeight / (WALL_TEX_REPEATS as f32)
        val uRaw: f32 = column.tex * CELL_TEX_REPEATS
        val u: f32 = uRaw - (uRaw as i32) as f32

        for segment = 0, segment < WALL_TEX_REPEATS, segment++ {
            val segTop: f32 = column.top + segHeight * (segment as f32)
            val segBottom: f32 = segTop + segHeight
            val clipTop: mut f32 = segTop
            val clipBottom: mut f32 = segBottom
            if clipTop < 0.0 {
                clipTop = 0.0
            }
            if clipBottom > (SCREEN_HEIGHT as f32) {
                clipBottom = SCREEN_HEIGHT as f32
            }
            if clipBottom > clipTop {
                val vTop: f32 = (clipTop - segTop) / segHeight
                val vBottom: f32 = (clipBottom - segTop) / segHeight
                val srcX: i32 = (u * (wall.w as f32)) as i32
                val srcY: i32 = (vTop * (wall.h as f32)) as i32
                val srcH: mut i32 = ((vBottom - vTop) * (wall.h as f32)) as i32
                if srcH < 1 {
                    srcH = 1
                }
                SDL_SetTextureColorMod(wall.tex, column.shade, column.shade, column.shade)
                g_src_rect.x = srcX
                g_src_rect.y = srcY
                g_src_rect.w = 1
                g_src_rect.h = srcH
                g_dst_rect.x = span.start_x
                g_dst_rect.y = clipTop as i32
                g_dst_rect.w = 1
                g_dst_rect.h = (clipBottom - clipTop) as i32
                SDL_RenderCopy(
                    g_renderer,
                    wall.tex,
                    g_src_rect as ref void,
                    g_dst_rect as ref void
                )
            }
        }
        return
    }

    SDL_SetTextureColorMod(wall.tex, 255, 255, 255)

    for segment = 0, segment < WALL_TEX_REPEATS, segment++ {
        val vertexCount: mut i32 = 0
        val indexCount: mut i32 = 0
        val prevTop: mut i32 = 0
        val prevBottom: mut i32 = 0

        for x = span.start_x, x <= span.end_x, x++ {
            val column: ref ColumnInfo = column_info(x)
            val wallHeight: f32 = column.bottom - column.top
            val segHeight: f32 = wallHeight / (WALL_TEX_REPEATS as f32)
            val segTop: f32 = column.top + segHeight * (segment as f32)
            val segBottom: f32 = segTop + segHeight

            val clipTop: mut f32 = segTop
            val clipBottom: mut f32 = segBottom
            if clipTop < 0.0 {
                clipTop = 0.0
            }
            if clipBottom > (SCREEN_HEIGHT as f32) {
                clipBottom = SCREEN_HEIGHT as f32
            }
            if clipBottom < clipTop {
                clipBottom = clipTop
            }

            val vTop: mut f32 = (clipTop - segTop) / segHeight
            val vBottom: mut f32 = (clipBottom - segTop) / segHeight
            if vTop < 0.0 {
                vTop = 0.0
            }
            if vTop > 1.0 {
                vTop = 1.0
            }
            if vBottom < 0.0 {
                vBottom = 0.0
            }
            if vBottom > 1.0 {
                vBottom = 1.0
            }

            val uRaw: f32 = column.tex * CELL_TEX_REPEATS
            val u: f32 = uRaw - (uRaw as i32) as f32

            val topVertex: mut ref SDL_Vertex = vertex_at(vertexCount)
            topVertex.position.x = x as f32
            topVertex.position.y = clipTop
            topVertex.color.r = column.shade
            topVertex.color.g = column.shade
            topVertex.color.b = column.shade
            topVertex.color.a = 255
            topVertex.tex_coord.x = u
            topVertex.tex_coord.y = vTop
            vertexCount++

            val bottomVertex: mut ref SDL_Vertex = vertex_at(vertexCount)
            bottomVertex.position.x = x as f32
            bottomVertex.position.y = clipBottom
            bottomVertex.color.r = column.shade
            bottomVertex.color.g = column.shade
            bottomVertex.color.b = column.shade
            bottomVertex.color.a = 255
            bottomVertex.tex_coord.x = u
            bottomVertex.tex_coord.y = vBottom
            vertexCount++

            if x > span.start_x {
                write_index(indexCount, prevTop)
                indexCount++
                write_index(indexCount, prevBottom)
                indexCount++
                write_index(indexCount, vertexCount - 2)
                indexCount++
                write_index(indexCount, vertexCount - 2)
                indexCount++
                write_index(indexCount, prevBottom)
                indexCount++
                write_index(indexCount, vertexCount - 1)
                indexCount++
            }

            prevTop = vertexCount - 2
            prevBottom = vertexCount - 1
        }

        if indexCount > 0 {
            SDL_RenderGeometry(
                g_renderer,
                wall.tex,
                g_vertices as ref SDL_Vertex,
                vertexCount,
                g_indices as ref i32,
                indexCount
            )
        }
    }
}

pub fn main() i32 = {
    if !trust load_map() {
        trust @print("cubedoom: could not load {s}\n", {MAP_PATH})
        return 1
    }

    trust SDL_Init(C.SDL_INIT_VIDEO | C.SDL_INIT_AUDIO)
    trust apply_spawn()

    val window: ref void = trust SDL_CreateWindow(
        "cubedoom",
        C.SDL_WINDOWPOS_CENTERED,
        C.SDL_WINDOWPOS_CENTERED,
        SCREEN_WIDTH,
        SCREEN_HEIGHT,
        0 as u32
    )

    val renderer: ref void = trust SDL_CreateRenderer(
        window,
        -1 as i32,
        C.SDL_RENDERER_ACCELERATED | C.SDL_RENDERER_PRESENTVSYNC
    )
    g_renderer = renderer
    trust SDL_SetHint("SDL_RENDER_SCALE_QUALITY", "1")

    trust Mix_OpenAudio(44100 as i32, C.AUDIO_S16SYS, 2 as i32, 1024 as i32)
    g_shootSound = trust load_sound("sounds/shoot_machinegun.wav", 55)
    g_shootShotgunSound = trust load_sound("sounds/shoot_shotgun.wav", 70)
    g_shootPlasmaSound = trust load_sound("sounds/shoot_plasma.wav", 56)
    g_enemyShootSound = trust load_sound("sounds/enemy_shoot.wav", 32)
    g_hitSound = trust load_sound("sounds/hit.wav", 48)
    g_hurtSound = trust load_sound("sounds/hurt.wav", 78)
    g_pickupSound = trust load_sound("sounds/pickup.wav", 62)
    g_footstepSound = trust load_sound("sounds/footstep.wav", 26)
    g_switchMachineSound = trust load_sound("sounds/weapon_machinegun.wav", 52)
    g_switchShotgunSound = trust load_sound("sounds/weapon_shotgun.wav", 58)
    g_switchPlasmaSound = trust load_sound("sounds/weapon_plasma.wav", 50)
    g_reloadShotgun1Sound = trust load_sound("sounds/reload_shotgun_1.wav", 46)
    g_reloadShotgun2Sound = trust load_sound("sounds/reload_shotgun_2.wav", 48)
    g_jumpSound = trust load_sound("sounds/hup.wav", 58)
    g_xpSound = trust load_sound("sounds/xp.wav", 46)
    g_buySound = trust load_sound("sounds/buy.wav", 58)
    g_clickSound = trust load_sound("sounds/click.wav", 38)
    g_waveSound = trust load_sound("sounds/wave_start.wav", 56)
    g_deathSound = trust load_sound("sounds/death.wav", 68)

    zbuf = @alloc((SCREEN_WIDTH as usize) * 8)
    trust @memset(zbuf, 127, (SCREEN_WIDTH as usize) * 8)

    enemies_buf = @alloc((MAX_ENEMIES as usize) * @sizeof(Enemy))
    trust @memset(enemies_buf, 0, (MAX_ENEMIES as usize) * @sizeof(Enemy))
    trust init_enemies()

    bullets_buf = @alloc((MAX_BULLETS as usize) * @sizeof(Bullet))
    trust @memset(bullets_buf, 0, (MAX_BULLETS as usize) * @sizeof(Bullet))

    g_src_rect = @alloc(@sizeof(SDL_Rect)) as ref SDL_Rect
    g_dst_rect = @alloc(@sizeof(SDL_Rect)) as ref SDL_Rect
    g_aux_rect = @alloc(@sizeof(SDL_Rect)) as ref SDL_Rect
    g_columns = @alloc((SCREEN_WIDTH as usize) * @sizeof(ColumnInfo))
    g_vertices = @alloc((SCREEN_WIDTH as usize) * 2 * @sizeof(SDL_Vertex))
    g_indices = @alloc((SCREEN_WIDTH as usize) * 6 * @sizeof(i32))

    trust load_wall_texture(renderer, "textures/QUAKE101/tech08_2.png", 0)
    trust load_wall_texture(renderer, "textures/QUAKE101/dung01_1.png", 1)
    trust load_wall_texture(renderer, "textures/QUAKE101/tech07_2.png", 2)

    g_enemyTex = trust load_texture(renderer, "sprites/enemy.gif")
    if g_enemyTex != none {
        val enemySize: TextureSize = trust texture_size(g_enemyTex)
        enemyTexW = enemySize.w
        enemyTexH = enemySize.h
    }

    g_machineGunTex = trust load_texture(renderer, "sprites/guns/machine_gun.png")
    if g_machineGunTex != none {
        val gunSize: TextureSize = trust texture_size(g_machineGunTex)
        gunTexW = gunSize.w
        gunTexH = gunSize.h
    }
    g_shotgunTex = trust load_texture(renderer, "sprites/guns/shotgun.png")
    g_shotgunReload1Tex = trust load_texture(renderer, "sprites/guns/shotgun_reload_1.png")
    g_shotgunReload2Tex = trust load_texture(renderer, "sprites/guns/shotgun_reload_2.png")
    g_plasmaTex = trust load_texture(renderer, "sprites/guns/plasma_rifle.png")

    g_bulletTex = trust load_texture(renderer, "sprites/bullet.png")
    if g_bulletTex != none {
        val bulletSize: TextureSize = trust texture_size(g_bulletTex)
        bulletTexW = bulletSize.w
        bulletTexH = bulletSize.h
    }

    g_treeTex = trust load_texture(renderer, "sprites/tree.png")
    g_healthTex = trust load_texture(renderer, "sprites/health.gif")
    g_boothTex = trust load_texture(renderer, "sprites/booth.png")
    if g_boothTex != none {
        val boothSize: TextureSize = trust texture_size(g_boothTex)
        boothTexW = boothSize.w
        boothTexH = boothSize.h
    }

    rng = trust SDL_GetTicks()
    init_sky()
    init_trees()
    init_pickups()
    init_booth()
    trust load_progress()
    playerHealth = max_health()
    gameState = STATE_MENU
    trust set_relative_mouse(false)

    val evt: ref SDL_Event = @alloc(@sizeof(SDL_Event))
    val lastTime: mut u32 = trust SDL_GetTicks()

    for {
        val currentTime: u32 = trust SDL_GetTicks()
        val deltaTime: mut f32 = ((currentTime - lastTime) as f32) / 1000.0
        lastTime = currentTime
        if deltaTime > 0.06 {
            deltaTime = 0.06
        }
        gameTime += deltaTime

        for {
            if trust SDL_PollEvent(evt) != 0 {
                if evt.type_value == C.SDL_QUIT {
                    quitRequested = true
                }
            } else {
                break
            }
        }
        if quitRequested {
            break
        }

        val keys: ref u8 = trust SDL_GetKeyboardState(none as ref i32)
        val keyA: u8 = trust @load(@ptradd(keys, (C.SDL_SCANCODE_A) * @sizeof(u8)))
        val keyD: u8 = trust @load(@ptradd(keys, (C.SDL_SCANCODE_D) * @sizeof(u8)))
        val keyW: u8 = trust @load(@ptradd(keys, (C.SDL_SCANCODE_W) * @sizeof(u8)))
        val keyS: u8 = trust @load(@ptradd(keys, (C.SDL_SCANCODE_S) * @sizeof(u8)))
        val keyShiftLeft: u8 = trust @load(@ptradd(keys, (C.SDL_SCANCODE_LSHIFT) * @sizeof(u8)))
        val keyShiftRight: u8 = trust @load(@ptradd(
                keys,
                (C.SDL_SCANCODE_RSHIFT) * @sizeof(u8)
            ))
        val keyE: u8 = trust @load(@ptradd(keys, (C.SDL_SCANCODE_E) * @sizeof(u8)))
        val keyEscape: u8 = trust @load(@ptradd(keys, (C.SDL_SCANCODE_ESCAPE) * @sizeof(u8)))
        val keyEnter: u8 = trust @load(@ptradd(keys, (C.SDL_SCANCODE_RETURN) * @sizeof(u8)))
        val keySpace: u8 = trust @load(@ptradd(keys, (C.SDL_SCANCODE_SPACE) * @sizeof(u8)))
        val key1: u8 = trust @load(@ptradd(keys, (C.SDL_SCANCODE_1) * @sizeof(u8)))
        val key2: u8 = trust @load(@ptradd(keys, (C.SDL_SCANCODE_2) * @sizeof(u8)))
        val key3: u8 = trust @load(@ptradd(keys, (C.SDL_SCANCODE_3) * @sizeof(u8)))
        val key4: u8 = trust @load(@ptradd(keys, (C.SDL_SCANCODE_4) * @sizeof(u8)))
        val key5: u8 = trust @load(@ptradd(keys, (C.SDL_SCANCODE_5) * @sizeof(u8)))
        val key6: u8 = trust @load(@ptradd(keys, (C.SDL_SCANCODE_6) * @sizeof(u8)))

        inputEPressed = keyE != 0 && prevE == 0
        inputEscapePressed = keyEscape != 0 && prevEscape == 0
        inputEnterPressed = keyEnter != 0 && prevEnter == 0
        inputSpacePressed = keySpace != 0 && prevSpace == 0
        inputNum1 = key1 != 0 && prevNum1 == 0
        inputNum2 = key2 != 0 && prevNum2 == 0
        inputNum3 = key3 != 0 && prevNum3 == 0
        inputNum4 = key4 != 0 && prevNum4 == 0
        inputNum5 = key5 != 0 && prevNum5 == 0
        inputNum6 = key6 != 0 && prevNum6 == 0

        val mouseScreenX: mut i32 = 0
        val mouseScreenY: mut i32 = 0
        val mouseButtons: u32 = trust SDL_GetMouseState(
            @addr(mouseScreenX),
            @addr(mouseScreenY)
        )
        val mouseDown: bool = (mouseButtons & (C.SDL_BUTTON_LMASK as u32)) != 0
        inputMouseX = mouseScreenX
        inputMouseY = mouseScreenY
        uiMouseX = mouseScreenX
        uiMouseY = mouseScreenY
        inputClick = mouseDown && !prevMouseDown

        if gameState == STATE_MENU {
            trust set_relative_mouse(false)
            trust update_menu()
            trust render_menu()
        } elif gameState == STATE_SHOP {
            trust set_relative_mouse(false)
            trust update_shop()
            trust render_shop()
        } elif gameState == STATE_DEAD {
            trust set_relative_mouse(false)
            trust update_dead()
            trust render_dead()
        } else {
            trust set_relative_mouse(true)

            val mouseX: mut i32 = 0
            val mouseY: mut i32 = 0
            trust SDL_GetRelativeMouseState(@addr(mouseX), @addr(mouseY))
            if mouseX != 0 {
                trust rotate_player((mouseX as f32) * 0.0022)
            }
            pitch = pitch - (mouseY as f32) * 1.1
            if pitch < -260.0 {
                pitch = -260.0
            }
            if pitch > 260.0 {
                pitch = 260.0
            }

            val nearBooth: bool = boothFound && (boothX - (player.x + 4.0)) * (boothX - (player.x + 4.0)) + (boothY - (player.y + 4.0)) * (boothY - (player.y + 4.0)) < 12000.0

            if inputEPressed && nearBooth {
                play_sound(g_clickSound)
                gameState = STATE_SHOP
                trust set_relative_mouse(false)
                trust render_shop()
            } elif inputEscapePressed {
                trust save_progress()
                gameState = STATE_MENU
                trust set_relative_mouse(false)
                trust render_menu()
            } else {
                if inputNum1 {
                    switch_weapon(WEAPON_MACHINE_GUN)
                } elif inputNum2 {
                    switch_weapon(WEAPON_SHOTGUN)
                } elif inputNum3 {
                    switch_weapon(WEAPON_PLASMA)
                }

                if inputSpacePressed && onGround {
                    playerVZ = 330.0
                    onGround = false
                    play_sound(g_jumpSound)
                }

                if mouseDown {
                    player_shoot()
                }

                if shootCooldown > 0.0 {
                    shootCooldown -= deltaTime
                }
                if muzzleFlashTimer > 0.0 {
                    muzzleFlashTimer -= deltaTime
                }
                if hitFlashTimer > 0.0 {
                    hitFlashTimer -= deltaTime
                }

                if weaponEquip < 1.0 {
                    weaponEquip += deltaTime / 0.34
                    if weaponEquip > 1.0 {
                        weaponEquip = 1.0
                    }
                }

                if shotgunReloadTimer > 0.0 {
                    shotgunReloadTimer -= deltaTime
                    val stage: mut i32 = 0
                    if shotgunReloadTimer > 0.55 {
                        stage = 0
                    } elif shotgunReloadTimer > 0.35 {
                        stage = 1
                    } elif shotgunReloadTimer > 0.15 {
                        stage = 2
                    }
                    if stage != shotgunReloadStage {
                        if stage == 1 {
                            play_sound(g_reloadShotgun1Sound)
                        } elif stage == 2 {
                            play_sound(g_reloadShotgun2Sound)
                        }
                        shotgunReloadStage = stage
                    }
                    if shotgunReloadTimer <= 0.0 {
                        shotgunReloadTimer = 0.0
                        shotgunReloadStage = 0
                    }
                }

                if !onGround {
                    playerVZ -= 1050.0 * deltaTime
                    playerZ += playerVZ * deltaTime
                    if playerZ <= 0.0 {
                        playerZ = 0.0
                        playerVZ = 0.0
                        onGround = true
                    }
                }

                val sprinting: bool = keyShiftLeft != 0 || keyShiftRight != 0
                val isMoving: bool = keyW != 0 || keyS != 0 || keyA != 0 || keyD != 0
                val bobRate: mut f32 = 1.0
                if sprinting {
                    bobRate = 1.35
                }
                if isMoving {
                    walkTime += deltaTime * bobRate
                    footstepTimer -= deltaTime
                    if footstepTimer <= 0.0 {
                        play_sound(g_footstepSound)
                        if sprinting {
                            footstepTimer = 0.29
                        } else {
                            footstepTimer = 0.42
                        }
                    }
                } else {
                    walkTime = 0.0
                    footstepTimer = 0.0
                }
                val bobY: i32 = (trust sinf(walkTime * 7.0) * 16.0) as i32
                val bobX: i32 = (trust sinf(walkTime * 3.5) * 24.0) as i32

                val speedBonus: f32 = 1.0 + (progress.speedLevel as f32) * 0.08
                val movementSpeed: mut f32 = player.speed * speedBonus
                if sprinting {
                    movementSpeed = player.speed * speedBonus * SPRINT_MULTIPLIER
                }

                if keyW != 0 || keyS != 0 {
                    val moveDir: mut f32 = -1.0
                    if keyW != 0 {
                        moveDir = 1.0
                    }

                    val stepX: f32 = player.dirX * movementSpeed * moveDir * deltaTime
                    val stepY: f32 = player.dirY * movementSpeed * moveDir * deltaTime
                    try_move_player(stepX, stepY)
                }

                if keyA != 0 || keyD != 0 {
                    val strafeDir: mut f32 = 1.0
                    if keyA != 0 {
                        strafeDir = -1.0
                    }

                    val stepX: f32 = -player.dirY * movementSpeed * strafeDir * deltaTime
                    val stepY: f32 = player.dirX * movementSpeed * strafeDir * deltaTime
                    try_move_player(stepX, stepY)
                }

                update_enemies(deltaTime)
                update_bullets(deltaTime)
                update_pickups(deltaTime)
                update_xp_orbs()
                update_wave(deltaTime)

                if playerHealth <= 0 {
                    trust enter_death()
                    trust render_dead()
                } else {
                    trust SDL_SetRenderDrawColor(renderer, 0 as u8, 0 as u8, 0 as u8, 255 as u8)
                    trust SDL_RenderClear(renderer)

                    val horizon: f32 = (SCREEN_HEIGHT as f32) / 2.0 + pitch + playerZ
                    draw_sky(horizon, gameTime)
                    draw_ground(horizon)

                    val pCX: f32 = player.x + 4.0
                    val pCY: f32 = player.y + 4.0
                    val span: mut WallSpan = @zeroed

                    val i: mut i32 = 0
                    for i < SCREEN_WIDTH {
                        val cameraX: f32 = 2.0 * (i as f32) / (SCREEN_WIDTH as f32) - 1.0
                        val rayDX: f32 = player.dirX + player.planeX * cameraX
                        val rayDY: f32 = player.dirY + player.planeY * cameraX

                        val mX: mut i32 = (pCX / (TILE_SIZE as f32)) as i32
                        val mY: mut i32 = (pCY / (TILE_SIZE as f32)) as i32

                        val dDX: mut f32 = trust fabsf(1.0 / rayDX)
                        if rayDX == 0.0 {
                            dDX = 1e30
                        }

                        val dDY: mut f32 = trust fabsf(1.0 / rayDY)
                        if rayDY == 0.0 {
                            dDY = 1e30
                        }

                        val sDX: mut f32 = 0.0
                        val sDY: mut f32 = 0.0
                        val stepX: mut i32 = 0
                        val stepY: mut i32 = 0

                        if rayDX < 0.0 {
                            stepX = -1
                            sDX = (pCX / (TILE_SIZE as f32) - (mX as f32)) * dDX
                        } else {
                            stepX = 1
                            sDX = ((mX as f32) + 1.0 - pCX / (TILE_SIZE as f32)) * dDX
                        }

                        if rayDY < 0.0 {
                            stepY = -1
                            sDY = (pCY / (TILE_SIZE as f32) - (mY as f32)) * dDY
                        } else {
                            stepY = 1
                            sDY = ((mY as f32) + 1.0 - pCY / (TILE_SIZE as f32)) * dDY
                        }

                        val hit: mut i32 = 0
                        val side: mut i32 = 0

                        for {
                            if hit == 0 {
                                if sDX < sDY {
                                    sDX += dDX
                                    mX += stepX
                                    side = 0
                                } else {
                                    sDY += dDY
                                    mY += stepY
                                    side = 1
                                }

                                if mX < 0 || mX >= MAP_SIZE || mY < 0 || mY >= MAP_SIZE {
                                    break
                                }
                                if map_at(mX, mY) > 0 {
                                    hit = 1
                                }
                            } else {
                                break
                            }
                        }

                        val pWD: mut f32 = sDY - dDY
                        if side == 0 {
                            pWD = sDX - dDX
                        }
                        if pWD < 0.1 {
                            pWD = 0.1
                        }

                        trust @store(@ptradd(zbuf, (i as usize) * 8), (pWD * 100000.0) as usize)

                        val unitH: f32 = (SCREEN_HEIGHT as f32) / pWD
                        val wallH: f32 = unitH * (WALL_UNITS / (TILE_SIZE as f32))
                        val wallTop: f32 = horizon - wallH * 0.5
                        val intensity: f32 = 0.42 + 0.58 / (1.0 + pWD * pWD * 0.02)
                        val r: mut u8 = (255.0 * intensity) as u8
                        if side == 1 {
                            r = ((r as f32) * 0.7) as u8
                        }

                        val hitX: f32 = pCX + rayDX * pWD * (TILE_SIZE as f32)
                        val hitY: f32 = pCY + rayDY * pWD * (TILE_SIZE as f32)

                        val wallPos: mut f32 = hitY / (TILE_SIZE as f32) - (mY as f32)
                        if side == 1 {
                            wallPos = hitX / (TILE_SIZE as f32) - (mX as f32)
                        }
                        wallPos = wallPos - (wallPos as i32) as f32
                        if wallPos < 0.0 {
                            wallPos += 1.0
                        }

                        val faceSign: mut i32 = stepY
                        if side == 0 {
                            faceSign = stepX
                        }
                        val sameWall: bool = span.active != 0 && span.cell_x == mX && span.cell_y == mY && span.side == side && span.face_sign == faceSign
                        if !sameWall {
                            trust wall_span_flush(@addr(span))
                            span.active = 1
                            span.start_x = i
                            span.cell_x = mX
                            span.cell_y = mY
                            span.side = side
                            span.face_sign = faceSign
                        }
                        span.end_x = i

                        val column: mut ref ColumnInfo = column_info(i)
                        column.top = wallTop
                        column.bottom = wallTop + wallH
                        column.tex = wallPos
                        column.shade = r

                        i++
                    }

                    trust wall_span_flush(@addr(span))
                    trust render_billboards()
                    trust render_gun(bobX, bobY, muzzleFlashTimer > 0.0)
                    render_crosshair()
                    render_damage()
                    trust render_hud()
                    render_minimap()
                }
            }
        }

        prevE = keyE
        prevEscape = keyEscape
        prevEnter = keyEnter
        prevSpace = keySpace
        prevNum1 = key1
        prevNum2 = key2
        prevNum3 = key3
        prevNum4 = key4
        prevNum5 = key5
        prevNum6 = key6
        prevMouseDown = mouseDown

        trust SDL_RenderPresent(renderer)
        if quitRequested {
            break
        }
    }

    trust set_relative_mouse(false)
    if g_shootSound != none {
        trust Mix_FreeChunk(g_shootSound)
    }
    if g_shootShotgunSound != none {
        trust Mix_FreeChunk(g_shootShotgunSound)
    }
    if g_shootPlasmaSound != none {
        trust Mix_FreeChunk(g_shootPlasmaSound)
    }
    if g_enemyShootSound != none {
        trust Mix_FreeChunk(g_enemyShootSound)
    }
    if g_hitSound != none {
        trust Mix_FreeChunk(g_hitSound)
    }
    if g_hurtSound != none {
        trust Mix_FreeChunk(g_hurtSound)
    }
    if g_pickupSound != none {
        trust Mix_FreeChunk(g_pickupSound)
    }
    if g_footstepSound != none {
        trust Mix_FreeChunk(g_footstepSound)
    }
    if g_switchMachineSound != none {
        trust Mix_FreeChunk(g_switchMachineSound)
    }
    if g_switchShotgunSound != none {
        trust Mix_FreeChunk(g_switchShotgunSound)
    }
    if g_switchPlasmaSound != none {
        trust Mix_FreeChunk(g_switchPlasmaSound)
    }
    if g_reloadShotgun1Sound != none {
        trust Mix_FreeChunk(g_reloadShotgun1Sound)
    }
    if g_reloadShotgun2Sound != none {
        trust Mix_FreeChunk(g_reloadShotgun2Sound)
    }
    if g_jumpSound != none {
        trust Mix_FreeChunk(g_jumpSound)
    }
    if g_xpSound != none {
        trust Mix_FreeChunk(g_xpSound)
    }
    if g_buySound != none {
        trust Mix_FreeChunk(g_buySound)
    }
    if g_clickSound != none {
        trust Mix_FreeChunk(g_clickSound)
    }
    if g_waveSound != none {
        trust Mix_FreeChunk(g_waveSound)
    }
    if g_deathSound != none {
        trust Mix_FreeChunk(g_deathSound)
    }
    trust Mix_CloseAudio()
    trust SDL_DestroyRenderer(renderer)
    trust SDL_DestroyWindow(window)
    trust SDL_Quit()
    return 0
}
