fn rotate_player(angle: f32) void = trust {
    val oldDirX: f32 = player.dirX
    player.dirX = player.dirX * cosf(angle) - player.dirY * sinf(angle)
    player.dirY = oldDirX * sinf(angle) + player.dirY * cosf(angle)

    val oldPlaneX: f32 = player.planeX
    player.planeX = player.planeX * cosf(angle) - player.planeY * sinf(angle)
    player.planeY = oldPlaneX * sinf(angle) + player.planeY * cosf(angle)
}

fn try_move_player(dx: f32, dy: f32) void = {
    val moveY0: i32 = ((player.y + 4.0) / (TILE_SIZE as f32)) as i32
    val moveX0: i32 = ((player.x + 4.0 + dx) / (TILE_SIZE as f32)) as i32
    if map_at(moveX0, moveY0) == 0 {
        player.x += dx
    }

    val moveY1: i32 = ((player.y + 4.0 + dy) / (TILE_SIZE as f32)) as i32
    val moveX1: i32 = ((player.x + 4.0) / (TILE_SIZE as f32)) as i32
    if map_at(moveX1, moveY1) == 0 {
        player.y += dy
    }
}

fn map_at(x: i32, y: i32) i32 = {
    if x < 0 || x >= MAP_SIZE || y < 0 || y >= MAP_SIZE {
        return 1
    }
    return trust @load32(@ptradd(
            map as ref i32,
            ((y * MAP_SIZE + x) as usize) * @sizeof(i32)
        ) as ref u32) as i32
}

fn map_set(x: i32, y: i32, value: i32) void = {
    if x < 0 || x >= MAP_SIZE || y < 0 || y >= MAP_SIZE {
        return
    }
    trust @store32(
        @ptradd(map as ref i32, ((y * MAP_SIZE + x) as usize) * @sizeof(i32)) as ref u32,
        value as u32
    )
}

fn is_space(c: u8) bool = {
    return c == 32 || c == 9 || c == 10 || c == 13
}

fn first_non_space(line: ref u8) i64 = trust {
    val i: mut i64 = 0
    for {
        val c: u8 = @load8(@ptradd(line, i as usize))
        if c == 0 || !is_space(c) {
            return i
        }
        i++
    }
    return i
}

fn skip_spaces(line: ref u8, pos: i64) i64 = trust {
    val i: mut i64 = pos
    for {
        val c: u8 = @load8(@ptradd(line, i as usize))
        if c == 0 || !is_space(c) {
            break
        }
        i++
    }
    return i
}

fn read_number(line: ref u8, pos: mut ref i64) f32 = trust {
    val i: mut i64 = @deref(pos)
    for {
        val c: u8 = @load8(@ptradd(line, i as usize))
        if c == 0 {
            break
        }
        if c == 45 || c == 43 || (c >= 48 && c <= 57) {
            break
        }
        i++
    }

    val start: i64 = i
    val first: u8 = @load8(@ptradd(line, i as usize))
    if first == 45 || first == 43 {
        i++
    }
    for {
        val c: u8 = @load8(@ptradd(line, i as usize))
        if (c >= 48 && c <= 57) || c == 46 {
            i++
        } else {
            break
        }
    }

    @deref(pos) = i
    val length: i64 = i - start
    if length <= 0 {
        return 0.0
    }

    val buffer: mut [64]u8 = @zeroed
    @memcpy(buffer as ref void, @ptradd(line, start as usize), length as usize)
    @store8(@ptradd(buffer as ref u8, length as usize), 0)

    match fmt.string_to_f64(buffer as ref u8) {
        ok value => {
            return value as f32
        }
        err _ => {
            return 0.0
        }
    }
}

fn read_quoted(line: ref u8, pos: mut ref i64, out: ref u8, capacity: i64) bool = trust {
    val i: mut i64 = skip_spaces(line, @deref(pos))
    if @load8(@ptradd(line, i as usize)) != 34 {
        return false
    }
    i++
    val start: i64 = i
    for {
        val c: u8 = @load8(@ptradd(line, i as usize))
        if c == 0 || c == 34 {
            break
        }
        i++
    }

    val length: i64 = i - start
    val count: mut i64 = length
    if count > capacity - 1 {
        count = capacity - 1
    }
    if count > 0 {
        @memcpy(out as ref void, @ptradd(line, start as usize), count as usize)
    }
    @store8(@ptradd(out, count as usize), 0)
    @deref(pos) = i
    if @load8(@ptradd(line, i as usize)) == 34 {
        @deref(pos) = i + 1
    }
    return true
}

fn read_token(line: ref u8, pos: mut ref i64, out: ref u8, capacity: i64) bool = trust {
    val i: mut i64 = skip_spaces(line, @deref(pos))
    val start: i64 = i
    for {
        val c: u8 = @load8(@ptradd(line, i as usize))
        if c == 0 || is_space(c) {
            break
        }
        i++
    }

    val length: i64 = i - start
    val count: mut i64 = length
    if count > capacity - 1 {
        count = capacity - 1
    }
    if count > 0 {
        @memcpy(out as ref void, @ptradd(line, start as usize), count as usize)
    }
    @store8(@ptradd(out, count as usize), 0)
    @deref(pos) = i
    return true
}

fn copy_text(dst: ref u8, capacity: i64, src: ref u8) void = trust {
    val length: i64 = str.len_raw(src)
    val count: mut i64 = length
    if count > capacity - 1 {
        count = capacity - 1
    }
    if count > 0 {
        @memcpy(dst as ref void, src as ref void, count as usize)
    }
    @store8(@ptradd(dst, count as usize), 0)
}

fn after_third_close_paren(line: ref u8) i64 = trust {
    val closeCount: mut i32 = 0
    val i: mut i64 = 0
    for {
        val c: u8 = @load8(@ptradd(line, i as usize))
        if c == 0 {
            return i
        }
        if c == 41 {
            closeCount++
            if closeCount == 3 {
                return i + 1
            }
        }
        i++
    }
    return i
}

fn texture_id(name: ref u8) i32 = {
    if str.str_eql(name, "quake/tech08_2") {
        return 1
    }
    if str.str_eql(name, "quake/dung01_1") {
        return 2
    }
    if str.str_eql(name, "quake/tech07_2") {
        return 3
    }
    return 1
}

fn brush_reset(bounds: mut ref BrushBounds) void = trust {
    bounds.minX = 1.0e30
    bounds.minY = 1.0e30
    bounds.minZ = 1.0e30
    bounds.maxX = -1.0e30
    bounds.maxY = -1.0e30
    bounds.maxZ = -1.0e30
    bounds.hasFace = false
    @memset(@addr(bounds.texture) as ref void, 0, 128 as usize)
}

fn parse_face(line: ref u8, bounds: mut ref BrushBounds) void = trust {
    val pos: mut i64 = 0
    for point = 0, point < 3, point++ {
        val x: f32 = read_number(line, @addr(pos))
        val y: f32 = read_number(line, @addr(pos))
        val z: f32 = read_number(line, @addr(pos))

        if x < bounds.minX {
            bounds.minX = x
        }
        if y < bounds.minY {
            bounds.minY = y
        }
        if z < bounds.minZ {
            bounds.minZ = z
        }
        if x > bounds.maxX {
            bounds.maxX = x
        }
        if y > bounds.maxY {
            bounds.maxY = y
        }
        if z > bounds.maxZ {
            bounds.maxZ = z
        }
    }

    bounds.hasFace = true
    if @load8(bounds.texture as ref u8) == 0 {
        val texturePos: mut i64 = after_third_close_paren(line)
        read_token(line, @addr(texturePos), bounds.texture as ref u8, 128 as i64)
    }
}

fn finish_brush(bounds: ref BrushBounds) void = trust {
    if !bounds.hasFace {
        return
    }
    if bounds.minZ > 4.0 || bounds.maxZ < 96.0 {
        return
    }

    val id: i32 = texture_id(bounds.texture as ref u8)
    val x0: i32 = (bounds.minX / (TILE_SIZE as f32)) as i32
    val y0: i32 = (bounds.minY / (TILE_SIZE as f32)) as i32
    val x1: i32 = (bounds.maxX / (TILE_SIZE as f32)) as i32
    val y1: i32 = (bounds.maxY / (TILE_SIZE as f32)) as i32

    for y = y0, y < y1, y++ {
        for x = x0, x < x1, x++ {
            map_set(x, y, id)
        }
    }
}

fn parse_property(
    line: ref u8,
    class_name: ref u8,
    originX: mut ref f32,
    originY: mut ref f32,
    originZ: mut ref f32,
    hasOrigin: mut ref bool,
    entityAngle: mut ref f32
) void = trust {
    val pos: mut i64 = 0
    val key: [64]u8 = @zeroed
    val value: [256]u8 = @zeroed

    if !read_quoted(line, @addr(pos), key as ref u8, 64 as i64) {
        return
    }
    if !read_quoted(line, @addr(pos), value as ref u8, 256 as i64) {
        return
    }

    if str.str_eql(key as ref u8, "classname") {
        copy_text(class_name, 64 as i64, value as ref u8)
    } elif str.str_eql(key as ref u8, "origin") {
        val valuePos: mut i64 = 0
        @deref(originX) = read_number(value as ref u8, @addr(valuePos))
        @deref(originY) = read_number(value as ref u8, @addr(valuePos))
        @deref(originZ) = read_number(value as ref u8, @addr(valuePos))
        @deref(hasOrigin) = true
    } elif str.str_eql(key as ref u8, "angle") {
        val valuePos: mut i64 = 0
        @deref(entityAngle) = read_number(value as ref u8, @addr(valuePos))
    }
}

fn finish_entity(
    class_name: ref u8,
    hasOrigin: bool,
    originX: f32,
    originY: f32,
    entityAngle: f32
) void = trust {
    if !hasOrigin {
        return
    }

    if str.str_eql(class_name, "info_player_start") {
        spawnX = originX
        spawnY = originY
        spawnAngle = entityAngle
        spawnFound = true
    } elif str.raw_starts_with(class_name, "monster_") {
        if enemySpawnCount < MAX_ENEMIES {
            val spawn: mut ref SpawnPoint = enemy_spawn(enemySpawnCount)
            spawn.x = originX
            spawn.y = originY
            enemySpawnCount++
        }
    }
}

fn find_spawn() void = trust {
    for y = 1, y < MAP_SIZE - 1, y++ {
        for x = 1, x < MAP_SIZE - 1, x++ {
            if map_at(x, y) == 0 {
                spawnX = (x as f32) * (TILE_SIZE as f32) + (TILE_SIZE as f32) * 0.5
                spawnY = (y as f32) * (TILE_SIZE as f32) + (TILE_SIZE as f32) * 0.5
                spawnFound = true
                return
            }
        }
    }
}

fn load_map() bool = trust {
    val handle = fs.open(MAP_PATH, "rb")
    match handle {
        none => {
            return false
        }
        some file => {
            val line: [2048]u8 = @zeroed
            val class_name: mut [64]u8 = @zeroed
            val bounds: mut BrushBounds = @zeroed
            val depth: mut i32 = 0
            val originX: mut f32 = 0.0
            val originY: mut f32 = 0.0
            val originZ: mut f32 = 0.0
            val entityAngle: mut f32 = 0.0
            val hasOrigin: mut bool = false

            spawnFound = false
            enemySpawnCount = 0

            for fs.read_line(file, line as ref u8, 2048 as i64) {
                val start: i64 = first_non_space(line as ref u8)
                val c: u8 = @load8(@ptradd(line as ref u8, start as usize))

                if c == 0 || c == 47 {
                    continue
                }

                if c == 123 {
                    depth++
                    if depth == 1 {
                        @memset(class_name as ref void, 0, 64 as usize)
                        originX = 0.0
                        originY = 0.0
                        originZ = 0.0
                        entityAngle = 0.0
                        hasOrigin = false
                    } elif depth == 2 {
                        brush_reset(@addr(bounds))
                    }
                } elif c == 125 {
                    if depth == 2 {
                        finish_brush(@addr(bounds))
                    } elif depth == 1 {
                        finish_entity(
                            class_name as ref u8,
                            hasOrigin,
                            originX,
                            originY,
                            entityAngle
                        )
                    }
                    if depth > 0 {
                        depth--
                    }
                } elif c == 40 {
                    if depth == 2 {
                        parse_face(line as ref u8, @addr(bounds))
                    }
                } elif c == 34 {
                    if depth == 1 {
                        parse_property(
                            line as ref u8,
                            class_name as ref u8,
                            @addr(originX),
                            @addr(originY),
                            @addr(originZ),
                            @addr(hasOrigin),
                            @addr(entityAngle)
                        )
                    }
                }
            }

            fs.close(file)
            if !spawnFound {
                find_spawn()
            }
            @print("cubedoom: loaded {s} with {d} enemy spawns\n", {MAP_PATH, enemySpawnCount})
            return true
        }
    }
}

fn apply_spawn() void = trust {
    player.x = spawnX - player.w * 0.5
    player.y = spawnY - player.h * 0.5

    val radians: f32 = spawnAngle * PI / 180.0
    player.dirX = cosf(radians)
    player.dirY = sinf(radians)
    player.planeX = -player.dirY * 0.66
    player.planeY = player.dirX * 0.66
}

fn init_enemies() void = trust {
    for i = 0, i < MAX_ENEMIES, i++ {
        val enemy: mut ref Enemy = get_enemy(i)
        enemy.x = 0.0
        enemy.y = 0.0
        enemy.health = 0
        enemy.alive = 0
        enemy.shootTimer = 0.0
    }
}

fn spawn_player_bullet(angleOffset: f32, damage: i32, speed: f32) void = {
    val cs: f32 = trust cosf(angleOffset)
    val sn: f32 = trust sinf(angleOffset)
    val dirX: f32 = player.dirX * cs - player.dirY * sn
    val dirY: f32 = player.dirX * sn + player.dirY * cs
    val pCX: f32 = player.x + 4.0
    val pCY: f32 = player.y + 4.0

    val bi: mut i32 = 0
    for bi < MAX_BULLETS {
        val blt: mut ref Bullet = get_bullet(bi)
        if blt.alive == 0 {
            blt.x = pCX
            blt.y = pCY
            blt.dx = dirX * speed
            blt.dy = dirY * speed
            blt.alive = 1
            blt.isPlayer = 1
            blt.animTime = 0.0
            blt.damage = damage
            blt.weapon = currentWeapon
            break
        }
        bi++
    }
}

fn player_shoot() void = {
    if shootCooldown > 0.0 || weaponEquip < 0.55 {
        return
    }
    shootCooldown = weapon_cooldown(currentWeapon)
    muzzleFlashTimer = 0.12
    play_sound(weapon_shoot_sound(currentWeapon))

    if currentWeapon == WEAPON_SHOTGUN {
        for pellet = 0, pellet < 8, pellet++ {
            val offset: f32 = ((pellet as f32) - 3.5) * 0.045
            spawn_player_bullet(offset, 1 + progress.damageLevel, BULLET_SPEED * 1.05)
        }
        shotgunReloadTimer = 0.90
        shotgunReloadStage = 0
    } elif currentWeapon == WEAPON_PLASMA {
        spawn_player_bullet(0.0, 2 + progress.damageLevel, BULLET_SPEED * 1.45)
    } else {
        spawn_player_bullet(0.0, 1 + progress.damageLevel, BULLET_SPEED * 1.15)
    }
}

fn update_enemies(dt: f32) void = {
    val pCX: f32 = player.x + 4.0
    val pCY: f32 = player.y + 4.0

    val ei: mut i32 = 0
    for ei < MAX_ENEMIES {
        val e: mut ref Enemy = get_enemy(ei)
        if e.alive != 0 {
            val dx: f32 = pCX - (e.x + 4.0)
            val dy: f32 = pCY - (e.y + 4.0)
            val dist: f32 = trust sqrtf(dx * dx + dy * dy)

            if dist > 80.0 && dist < 2000.0 {
                val nx: f32 = dx / dist
                val ny: f32 = dy / dist
                val newX: f32 = e.x + nx * ENEMY_SPEED * dt
                val newY: f32 = e.y + ny * ENEMY_SPEED * dt

                val tx: i32 = ((newX + 4.0) / (TILE_SIZE as f32)) as i32
                val ty: i32 = ((e.y + 4.0) / (TILE_SIZE as f32)) as i32
                if map_at(tx, ty) == 0 {
                    e.x = newX
                }

                val tx2: i32 = ((e.x + 4.0) / (TILE_SIZE as f32)) as i32
                val ty2: i32 = ((newY + 4.0) / (TILE_SIZE as f32)) as i32
                if map_at(tx2, ty2) == 0 {
                    e.y = newY
                }
            }

            e.shootTimer -= dt
            if e.shootTimer <= 0.0 {
                e.shootTimer = ENEMY_SHOOT_INTERVAL + (ei as f32) * 0.3

                val bi: mut i32 = 0
                for bi < MAX_BULLETS {
                    val blt: mut ref Bullet = get_bullet(bi)
                    if blt.alive == 0 {
                        val bdx: f32 = pCX - (e.x + 4.0)
                        val bdy: f32 = pCY - (e.y + 4.0)
                        val bdist: f32 = trust sqrtf(bdx * bdx + bdy * bdy)
                        if bdist > 0.0 {
                            blt.x = e.x + 4.0
                            blt.y = e.y + 4.0
                            blt.dx = (bdx / bdist) * BULLET_SPEED
                            blt.dy = (bdy / bdist) * BULLET_SPEED
                            blt.alive = 1
                            blt.isPlayer = 0
                            blt.animTime = 0.0
                            blt.damage = 10
                            blt.weapon = 9
                            play_sound(g_enemyShootSound)
                        }
                        break
                    }
                    bi++
                }
            }
        }
        ei++
    }
}

fn update_bullets(dt: f32) void = {
    val pCX: f32 = player.x + 4.0
    val pCY: f32 = player.y + 4.0
    val bi: mut i32 = 0

    for bi < MAX_BULLETS {
        val blt: mut ref Bullet = get_bullet(bi)
        if blt.alive != 0 {
            blt.x += blt.dx * dt
            blt.y += blt.dy * dt
            blt.animTime += dt

            val tx: i32 = (blt.x / (TILE_SIZE as f32)) as i32
            val ty: i32 = (blt.y / (TILE_SIZE as f32)) as i32
            val hitWall: mut i32 = 0
            if map_at(tx, ty) != 0 {
                hitWall = 1
            }

            if hitWall != 0 {
                blt.alive = 0
            } elif blt.isPlayer == 0 {
                val pdx: f32 = blt.x - pCX
                val pdy: f32 = blt.y - pCY
                if pdx * pdx + pdy * pdy < 400.0 {
                    playerHealth -= blt.damage
                    blt.alive = 0
                    if playerHealth < 0 {
                        playerHealth = 0
                    }
                    hitFlashTimer = 0.2
                    play_sound(g_hurtSound)
                }
            } else {
                val ei: mut i32 = 0
                for ei < MAX_ENEMIES {
                    val e: mut ref Enemy = get_enemy(ei)
                    if e.alive != 0 {
                        val edx: f32 = (e.x + 4.0) - blt.x
                        val edy: f32 = (e.y + 4.0) - blt.y
                        val edist: f32 = trust sqrtf(edx * edx + edy * edy)
                        if edist < 20.0 {
                            e.health -= blt.damage
                            if e.health <= 0 {
                                e.alive = 0
                                on_enemy_killed(e.x + 4.0, e.y + 4.0)
                            }
                            blt.alive = 0
                            play_sound(g_hitSound)
                            break
                        }
                    }
                    ei++
                }
            }
        }
        bi++
    }
}

fn billboard_texture(kind: i32) ref void = {
    if kind == 2 {
        return g_treeTex
    }
    if kind == 3 {
        return g_healthTex
    }
    if kind == 4 || kind == 5 {
        return g_bulletTex
    }
    if kind == 6 {
        return g_boothTex
    }
    return g_enemyTex
}

fn billboard_src(
    kind: i32,
    x: mut ref i32,
    y: mut ref i32,
    w: mut ref i32,
    h: mut ref i32
) void = trust {
    if kind == 2 {
        @deref(x) = 187
        @deref(y) = 4
        @deref(w) = 222
        @deref(h) = 319
    } elif kind == 3 {
        @deref(x) = 50
        @deref(y) = 30
        @deref(w) = 240
        @deref(h) = 280
    } elif kind == 4 || kind == 5 {
        @deref(x) = 0
        @deref(y) = 0
        @deref(w) = bulletTexW / 4
        @deref(h) = bulletTexH
    } elif kind == 6 {
        @deref(x) = 0
        @deref(y) = 0
        @deref(w) = boothTexW
        @deref(h) = boothTexH
    } else {
        @deref(x) = 55
        @deref(y) = 40
        @deref(w) = 180
        @deref(h) = 275
    }
}

fn fill_circle(cx: i32, cy: i32, radius: i32, r: u8, g: u8, b: u8, a: u8) void = {
    if radius < 1 {
        return
    }
    trust SDL_SetRenderDrawColor(g_renderer, r, g, b, a)
    for dy = -radius, dy <= radius, dy++ {
        val inner: f32 = (radius * radius - dy * dy) as f32
        val dx: i32 = (trust sqrtf(inner)) as i32
        g_aux_rect.x = cx - dx
        g_aux_rect.y = cy + dy
        g_aux_rect.w = dx * 2 + 1
        g_aux_rect.h = 1
        trust SDL_RenderFillRect(g_renderer, g_aux_rect)
    }
}

fn draw_glow(cx: i32, cy: i32, radius: i32, r: u8, g: u8, b: u8, alpha: u8) void = {
    if radius < 1 {
        return
    }
    trust SDL_SetRenderDrawBlendMode(g_renderer, 2 as i32)
    for layer = 0, layer < 4, layer++ {
        val layerRadius: i32 = radius - (radius * layer) / 5
        val layerAlpha: u8 = ((alpha as i32) * (4 - layer) / 4) as u8
        fill_circle(cx, cy, layerRadius, r, g, b, layerAlpha)
    }
    trust SDL_SetRenderDrawBlendMode(g_renderer, 1 as i32)
}

fn draw_flare_chain(x: i32, y: i32, strength: f32) void = {
    val centerX: i32 = SCREEN_WIDTH / 2
    val centerY: i32 = SCREEN_HEIGHT / 2
    val dx: i32 = centerX - x
    val dy: i32 = centerY - y

    for step = 0, step < 4, step++ {
        val factor: f32 = 0.22 + (step as f32) * 0.27
        val fx: i32 = x + ((dx as f32) * factor) as i32
        val fy: i32 = y + ((dy as f32) * factor) as i32
        val radius: i32 = 17 - step * 3
        val alpha: u8 = ((strength * (68.0 - (step as f32) * 11.0)) as i32) as u8
        draw_glow(fx, fy, radius, 255 as u8, 190 as u8, 105 as u8, alpha)
    }
}

fn normalize_angle(angle: f32) f32 = {
    val value: mut f32 = angle
    for {
        if value > PI {
            value -= 2.0 * PI
        } elif value < -PI {
            value += 2.0 * PI
        } else {
            break
        }
    }
    return value
}

fn draw_sky(horizon: f32, time: f32) void = {
    val bottom: mut i32 = horizon as i32
    if bottom < 0 {
        bottom = 0
    }
    if bottom > SCREEN_HEIGHT {
        bottom = SCREEN_HEIGHT
    }

    if bottom > 0 {
        for band = 0, band < 20, band++ {
            val t: f32 = (band as f32) / 19.0
            val r: u8 = (7.0 + 24.0 * t) as u8
            val g: u8 = (9.0 + 17.0 * t) as u8
            val b: u8 = (26.0 + 28.0 * t) as u8
            trust SDL_SetRenderDrawColor(g_renderer, r, g, b, 255 as u8)
            val y0: i32 = bottom * band / 20
            val y1: i32 = bottom * (band + 1) / 20
            g_aux_rect.x = 0
            g_aux_rect.y = y0
            g_aux_rect.w = SCREEN_WIDTH
            g_aux_rect.h = y1 - y0
            trust SDL_RenderFillRect(g_renderer, g_aux_rect)
        }
    }

    val yaw: f32 = trust atan2f(player.dirY, player.dirX)
    trust SDL_SetRenderDrawBlendMode(g_renderer, 1 as i32)
    for index = 0, index < starCount, index++ {
        val star: ref Star = star_at(index)
        val relative: f32 = normalize_angle(star.angle - yaw)
        if trust fabsf(relative) < FOV_HALF + 0.12 {
            val sx: i32 = SCREEN_WIDTH / 2 + ((relative / FOV_HALF) * (SCREEN_WIDTH as f32 / 2.0)) as i32
            val sy: i32 = bottom - ((star.altitude * (bottom as f32)) as i32)
            val twinkle: f32 = 0.62 + 0.38 * trust sinf(time * 2.0 + star.phase)
            val brightness: u8 = (star.brightness * twinkle) as u8
            val size: mut i32 = 1
            if star.brightness > 205.0 {
                size = 2
            }
            trust SDL_SetRenderDrawColor(g_renderer, brightness, brightness, 255 as u8, 220 as u8)
            g_aux_rect.x = sx
            g_aux_rect.y = sy
            g_aux_rect.w = size
            g_aux_rect.h = size
            trust SDL_RenderFillRect(g_renderer, g_aux_rect)
        }
    }

    val sunAngle: f32 = 2.15
    val sunAltitude: f32 = 0.76
    val sunRelative: f32 = normalize_angle(sunAngle - yaw)
    if trust fabsf(sunRelative) < FOV_HALF + 0.25 {
        val sunX: i32 = SCREEN_WIDTH / 2 + ((sunRelative / FOV_HALF) * (SCREEN_WIDTH as f32 / 2.0)) as i32
        val sunY: i32 = bottom - ((sunAltitude * (bottom as f32)) as i32)
        draw_glow(sunX, sunY, 48, 255 as u8, 210 as u8, 140 as u8, 70 as u8)
        draw_glow(sunX, sunY, 18, 255 as u8, 245 as u8, 210 as u8, 150 as u8)
        draw_flare_chain(sunX, sunY, 0.65)
    }

    trust SDL_SetRenderDrawBlendMode(g_renderer, 0 as i32)
}

fn draw_ground(horizon: f32) void = {
    val top: mut i32 = horizon as i32
    if top < 0 {
        top = 0
    }
    if top >= SCREEN_HEIGHT {
        return
    }

    for band = 0, band < 18, band++ {
        val t: f32 = (band as f32) / 17.0
        val r: u8 = (48.0 - 32.0 * t) as u8
        val g: u8 = (44.0 - 29.0 * t) as u8
        val b: u8 = (41.0 - 27.0 * t) as u8
        trust SDL_SetRenderDrawColor(g_renderer, r, g, b, 255 as u8)
        val y0: i32 = top + (SCREEN_HEIGHT - top) * band / 18
        val y1: i32 = top + (SCREEN_HEIGHT - top) * (band + 1) / 18
        g_aux_rect.x = 0
        g_aux_rect.y = y0
        g_aux_rect.w = SCREEN_WIDTH
        g_aux_rect.h = y1 - y0
        trust SDL_RenderFillRect(g_renderer, g_aux_rect)
    }
}

fn init_sky() void = {
    starCount = MAX_STARS
    for index = 0, index < MAX_STARS, index++ {
        val star: mut ref Star = star_at(index)
        star.angle = rand_unit() * 2.0 * PI
        star.altitude = 0.06 + rand_unit() * 0.88
        star.brightness = 90.0 + rand_unit() * 165.0
        star.phase = rand_unit() * 2.0 * PI
    }
}

fn cell_has_enemy(cx: i32, cy: i32) bool = {
    for index = 0, index < enemySpawnCount, index++ {
        val spawn: ref SpawnPoint = enemy_spawn(index)
        if ((spawn.x / (TILE_SIZE as f32)) as i32) == cx {
            if ((spawn.y / (TILE_SIZE as f32)) as i32) == cy {
                return true
            }
        }
    }
    return false
}

fn cell_near_spawn(cx: i32, cy: i32) bool = {
    val spawnCellX: i32 = (spawnX / (TILE_SIZE as f32)) as i32
    val spawnCellY: i32 = (spawnY / (TILE_SIZE as f32)) as i32
    val dx: i32 = cx - spawnCellX
    val dy: i32 = cy - spawnCellY
    return dx * dx + dy * dy < 25
}

fn cell_has_tree(cx: i32, cy: i32) bool = {
    for index = 0, index < treeCount, index++ {
        val tree: ref Tree = tree_at(index)
        if ((tree.x / (TILE_SIZE as f32)) as i32) == cx {
            if ((tree.y / (TILE_SIZE as f32)) as i32) == cy {
                return true
            }
        }
    }
    return false
}

fn cell_near_pickup(count: i32, cx: i32, cy: i32) bool = {
    for index = 0, index < count, index++ {
        val pickup: ref HealthPickup = pickup_at(index)
        val dx: i32 = cx - ((pickup.x / (TILE_SIZE as f32)) as i32)
        val dy: i32 = cy - ((pickup.y / (TILE_SIZE as f32)) as i32)
        if dx * dx + dy * dy < 16 {
            return true
        }
    }
    return false
}

fn init_trees() void = {
    treeCount = 0
    for y = 1, y < MAP_SIZE - 1, y++ {
        for x = 1, x < MAP_SIZE - 1, x++ {
            if treeCount >= MAX_TREES {
                return
            }
            if map_at(x, y) == 0 && !cell_near_spawn(x, y) && !cell_has_enemy(x, y) {
                if rand_next() % 100 < 7 {
                    val tree: mut ref Tree = tree_at(treeCount)
                    tree.x = (x as f32) * (TILE_SIZE as f32) + 32.0 + (rand_unit() * 20.0 - 10.0)
                    tree.y = (y as f32) * (TILE_SIZE as f32) + 32.0 + (rand_unit() * 20.0 - 10.0)
                    tree.scale = 0.8 + rand_unit() * 0.45
                    treeCount++
                }
            }
        }
    }
}

fn init_pickups() void = {
    for index = 0, index < MAX_HEALTH_PICKUPS, index++ {
        val pickup: mut ref HealthPickup = pickup_at(index)
        pickup.active = 0
        pickup.respawn = 0.0
        pickup.bob = rand_unit() * 2.0 * PI

        val attempts: mut i32 = 0
        for attempts < 400 {
            val x: i32 = (rand_next() % ((MAP_SIZE - 2) as u32)) as i32 + 1
            val y: i32 = (rand_next() % ((MAP_SIZE - 2) as u32)) as i32 + 1
            if map_at(
                x,
                y
            ) == 0 && !cell_near_spawn(
                x,
                y
            ) && !cell_has_enemy(x, y) && !cell_has_tree(x, y) && !cell_near_pickup(index, x, y) {
                pickup.x = (x as f32) * (TILE_SIZE as f32) + 32.0
                pickup.y = (y as f32) * (TILE_SIZE as f32) + 32.0
                pickup.active = 1
                break
            }
            attempts++
        }
    }
}

fn init_booth() void = {
    boothFound = false
    val spawnCellX: i32 = (spawnX / (TILE_SIZE as f32)) as i32
    val spawnCellY: i32 = (spawnY / (TILE_SIZE as f32)) as i32

    for radius = 2, radius < 12, radius++ {
        for y = spawnCellY - radius, y <= spawnCellY + radius, y++ {
            for x = spawnCellX - radius, x <= spawnCellX + radius, x++ {
                val dx: i32 = x - spawnCellX
                val dy: i32 = y - spawnCellY
                val adx: mut i32 = dx
                val ady: mut i32 = dy
                if adx < 0 {
                    adx = -adx
                }
                if ady < 0 {
                    ady = -ady
                }
                if adx != radius && ady != radius {
                    continue
                }
                if map_at(
                    x,
                    y
                ) == 0 && !cell_has_enemy(x, y) && !cell_has_tree(x, y) && !cell_near_pickup(
                    MAX_HEALTH_PICKUPS,
                    x,
                    y
                ) {
                    boothX = (x as f32) * (TILE_SIZE as f32) + 32.0
                    boothY = (y as f32) * (TILE_SIZE as f32) + 32.0
                    boothFound = true
                    return
                }
            }
        }
    }
}

fn update_pickups(dt: f32) void = {
    val pCX: f32 = player.x + 4.0
    val pCY: f32 = player.y + 4.0

    for index = 0, index < MAX_HEALTH_PICKUPS, index++ {
        val pickup: mut ref HealthPickup = pickup_at(index)
        if pickup.active != 0 {
            val dx: f32 = pickup.x - pCX
            val dy: f32 = pickup.y - pCY
            if dx * dx + dy * dy < 784.0 {
                playerHealth += 25
                if playerHealth > max_health() {
                    playerHealth = max_health()
                }
                pickup.active = 0
                pickup.respawn = 16.0
                play_sound(g_pickupSound)
            }
        } else {
            pickup.respawn -= dt
            if pickup.respawn <= 0.0 {
                pickup.active = 1
            }
        }
    }
}

fn add_billboard(
    list: ref Billboard,
    count: mut ref i32,
    kind: i32,
    index: i32,
    px: f32,
    py: f32
) void = trust {
    if @deref(count) >= MAX_BILLBOARDS {
        return
    }
    val billboard: mut ref Billboard = billboard_at(list, @deref(count))
    val dx: f32 = px - (player.x + 4.0)
    val dy: f32 = py - (player.y + 4.0)
    billboard.kind = kind
    billboard.index = index
    billboard.distance = dx * dx + dy * dy
    @deref(count) = @deref(count) + 1
}

fn render_billboards() void = trust {
    val list: mut [320]Billboard = @zeroed
    val count: mut i32 = 0

    for index = 0, index < MAX_ENEMIES, index++ {
        val enemy: ref Enemy = get_enemy(index)
        if enemy.alive != 0 {
            add_billboard(
                list as ref Billboard,
                @addr(count),
                1,
                index,
                enemy.x + 4.0,
                enemy.y + 4.0
            )
        }
    }

    for index = 0, index < treeCount, index++ {
        val tree: ref Tree = tree_at(index)
        add_billboard(list as ref Billboard, @addr(count), 2, index, tree.x, tree.y)
    }

    for index = 0, index < MAX_HEALTH_PICKUPS, index++ {
        val pickup: ref HealthPickup = pickup_at(index)
        if pickup.active != 0 {
            add_billboard(list as ref Billboard, @addr(count), 3, index, pickup.x, pickup.y)
        }
    }

    for index = 0, index < MAX_BULLETS, index++ {
        val bullet: ref Bullet = get_bullet(index)
        if bullet.alive != 0 {
            val kind: mut i32 = 4
            if bullet.isPlayer != 0 {
                kind = 5
            }
            add_billboard(list as ref Billboard, @addr(count), kind, index, bullet.x, bullet.y)
        }
    }

    if boothFound {
        add_billboard(list as ref Billboard, @addr(count), 6, 0, boothX, boothY)
    }

    for index = 0, index < MAX_XP_ORBS, index++ {
        val orb: ref XpOrb = xp_orb_at(index)
        if orb.active != 0 {
            add_billboard(list as ref Billboard, @addr(count), 7, index, orb.x, orb.y)
        }
    }

    for i = 0, i < count - 1, i++ {
        val farthest: mut i32 = i
        for j = i + 1, j < count, j++ {
            if billboard_at(
                list as ref Billboard,
                j
            ).distance > billboard_at(list as ref Billboard, farthest).distance {
                farthest = j
            }
        }
        if farthest != i {
            val a: mut ref Billboard = billboard_at(list as ref Billboard, i)
            val b: mut ref Billboard = billboard_at(list as ref Billboard, farthest)
            val aKind: i32 = a.kind
            val aIndex: i32 = a.index
            val aDistance: f32 = a.distance
            a.kind = b.kind
            a.index = b.index
            a.distance = b.distance
            b.kind = aKind
            b.index = aIndex
            b.distance = aDistance
        }
    }

    val pCX: f32 = player.x + 4.0
    val pCY: f32 = player.y + 4.0
    val det: f32 = player.planeX * player.dirY - player.dirX * player.planeY
    if det == 0.0 {
        return
    }
    val invDet: f32 = 1.0 / det
    val horizon: f32 = (SCREEN_HEIGHT as f32) / 2.0 + pitch + playerZ

    for index = 0, index < count, index++ {
        val billboard: ref Billboard = billboard_at(list as ref Billboard, index)
        val kind: i32 = billboard.kind
        val itemIndex: i32 = billboard.index
        val worldX: mut f32 = 0.0
        val worldY: mut f32 = 0.0
        val heightUnits: mut f32 = 1.0

        if kind == 1 {
            val enemy: ref Enemy = get_enemy(itemIndex)
            worldX = enemy.x + 4.0
            worldY = enemy.y + 4.0
            heightUnits = 1.05
        } elif kind == 2 {
            val tree: ref Tree = tree_at(itemIndex)
            worldX = tree.x
            worldY = tree.y
            heightUnits = 1.7 * tree.scale
        } elif kind == 3 {
            val pickup: ref HealthPickup = pickup_at(itemIndex)
            worldX = pickup.x
            worldY = pickup.y
            heightUnits = 0.42
        } elif kind == 4 || kind == 5 {
            val bullet: ref Bullet = get_bullet(itemIndex)
            worldX = bullet.x
            worldY = bullet.y
            heightUnits = 0.12
        } elif kind == 6 {
            worldX = boothX
            worldY = boothY
            heightUnits = 1.35
        } elif kind == 7 {
            val orb: ref XpOrb = xp_orb_at(itemIndex)
            worldX = orb.x
            worldY = orb.y
            heightUnits = 0.32
        }

        val dx: f32 = worldX - pCX
        val dy: f32 = worldY - pCY
        val tx: f32 = invDet * (player.dirY * dx - player.dirX * dy)
        val ty: f32 = invDet * (-player.planeY * dx + player.planeX * dy)

        if ty > 0.1 {
            val depth: f32 = ty / (TILE_SIZE as f32)
            val unit: f32 = (SCREEN_HEIGHT as f32) / depth
            val screenX: i32 = ((SCREEN_WIDTH as f32 / 2.0) * (1.0 + tx / ty)) as i32

            if kind == 7 {
                val orb: ref XpOrb = xp_orb_at(itemIndex)
                if screenX >= 0 && screenX < SCREEN_WIDTH {
                    val zVal: usize = @load(@ptradd(zbuf, (screenX as usize) * 8)) as usize
                    val orbDistance: usize = (depth * 100000.0) as usize
                    if orbDistance < zVal {
                        val bob: f32 = sinf(gameTime * 2.3 + orb.phase) * unit * 0.055
                        val centerY: i32 = (horizon + unit * 0.52 + bob) as i32
                        val symbolSize: i32 = (unit * 0.095) as i32 + 4
                        draw_xp_symbol(screenX, centerY, symbolSize, orb.phase)
                    }
                }
                continue
            }

            val srcX: mut i32 = 0
            val srcY: mut i32 = 0
            val srcW: mut i32 = 1
            val srcH: mut i32 = 1
            billboard_src(kind, @addr(srcX), @addr(srcY), @addr(srcW), @addr(srcH))
            if kind == 4 || kind == 5 {
                val bullet: ref Bullet = get_bullet(itemIndex)
                val frame: i32 = ((bullet.animTime * 8.0) as i32) % 4
                srcX = frame * (bulletTexW / 4)
            }

            val spriteH: i32 = (unit * heightUnits) as i32
            val spriteW: i32 = spriteH * srcW / srcH
            if spriteH > 0 && spriteW > 0 {
                val floorY: f32 = horizon + unit
                val bottomY: mut f32 = floorY
                if kind == 3 {
                    bottomY = floorY - unit * 0.10 - sinf(gameTime * 2.2 + (itemIndex as f32)) * 4.0
                } elif kind == 4 || kind == 5 {
                    bottomY = horizon + unit * 0.12
                }
                val topY: f32 = bottomY - (spriteH as f32)

                val clipTopF: mut f32 = topY
                val clipBottomF: mut f32 = bottomY
                if clipTopF < 0.0 {
                    clipTopF = 0.0
                }
                if clipBottomF > (SCREEN_HEIGHT as f32) {
                    clipBottomF = SCREEN_HEIGHT as f32
                }

                if clipBottomF > clipTopF {
                    val drawStartY: i32 = clipTopF as i32
                    val drawEndY: i32 = clipBottomF as i32
                    val visibleH: f32 = clipBottomF - clipTopF
                    val srcYAdjusted: i32 = srcY + ((srcH as f32) * ((clipTopF - topY) / (spriteH as f32))) as i32
                    val srcHAdjusted: mut i32 = ((srcH as f32) * (visibleH / (spriteH as f32))) as i32
                    if srcHAdjusted < 1 {
                        srcHAdjusted = 1
                    }

                    val drawStartX: mut i32 = screenX - spriteW / 2
                    val drawEndX: mut i32 = screenX + spriteW / 2
                    if drawStartX < 0 {
                        drawStartX = 0
                    }
                    if drawEndX >= SCREEN_WIDTH {
                        drawEndX = SCREEN_WIDTH - 1
                    }

                    val scaledDist: usize = (depth * 100000.0) as usize
                    val spriteLeft: i32 = screenX - spriteW / 2
                    val texture: ref void = billboard_texture(kind)

                    if texture != none {
                        if kind == 4 || kind == 5 {
                            val bullet: ref Bullet = get_bullet(itemIndex)
                            if bullet.weapon == 9 {
                                SDL_SetTextureColorMod(texture, 255 as u8, 92 as u8, 82 as u8)
                            } elif bullet.weapon == 2 {
                                SDL_SetTextureColorMod(texture, 92 as u8, 224 as u8, 255 as u8)
                            } elif bullet.weapon == 1 {
                                SDL_SetTextureColorMod(texture, 255 as u8, 196 as u8, 110 as u8)
                            } else {
                                SDL_SetTextureColorMod(texture, 255 as u8, 236 as u8, 168 as u8)
                            }
                            if bullet.weapon == 2 && screenX >= 0 && screenX < SCREEN_WIDTH {
                                draw_glow(
                                    screenX,
                                    (drawStartY + drawEndY) / 2,
                                    16,
                                    86 as u8,
                                    220 as u8,
                                    255 as u8,
                                    58 as u8
                                )
                            }
                        } else {
                            SDL_SetTextureColorMod(texture, 255 as u8, 255 as u8, 255 as u8)
                        }
                        val xi: mut i32 = drawStartX
                        for xi < drawEndX {
                            val zbufVal: usize = @load(@ptradd(zbuf, (xi as usize) * 8)) as usize
                            if scaledDist < zbufVal {
                                val texX: i32 = srcX + ((xi - spriteLeft) * srcW) / spriteW
                                if texX >= srcX && texX < srcX + srcW {
                                    g_src_rect.x = texX
                                    g_src_rect.y = srcYAdjusted
                                    g_src_rect.w = 1
                                    g_src_rect.h = srcHAdjusted
                                    g_dst_rect.x = xi
                                    g_dst_rect.y = drawStartY
                                    g_dst_rect.w = 1
                                    g_dst_rect.h = drawEndY - drawStartY
                                    SDL_RenderCopy(
                                        g_renderer,
                                        texture,
                                        g_src_rect as ref void,
                                        g_dst_rect as ref void
                                    )
                                }
                            }
                            xi++
                        }
                        if kind == 4 || kind == 5 {
                            SDL_SetTextureColorMod(texture, 255 as u8, 255 as u8, 255 as u8)
                        }
                    }
                }
            }
        }
    }

    for index = 0, index < MAX_HEALTH_PICKUPS, index++ {
        val pickup: ref HealthPickup = pickup_at(index)
        if pickup.active != 0 {
            val dx: f32 = pickup.x - pCX
            val dy: f32 = pickup.y - pCY
            val tx: f32 = invDet * (player.dirY * dx - player.dirX * dy)
            val ty: f32 = invDet * (-player.planeY * dx + player.planeX * dy)
            if ty > 0.1 {
                val depth: f32 = ty / (TILE_SIZE as f32)
                val unit: f32 = (SCREEN_HEIGHT as f32) / depth
                val screenX: i32 = ((SCREEN_WIDTH as f32 / 2.0) * (1.0 + tx / ty)) as i32
                val centerY: i32 = (horizon + unit * 0.62) as i32
                val visible: mut bool = false
                if screenX >= 0 && screenX < SCREEN_WIDTH {
                    val wallDistance: usize = @load(@ptradd(zbuf, (screenX as usize) * 8)) as usize
                    val spriteDistance: usize = (depth * 100000.0) as usize
                    if spriteDistance < wallDistance {
                        visible = true
                    }
                }
                if visible {
                    draw_glow(
                        screenX,
                        centerY,
                        (unit * 0.16) as i32 + 6,
                        80 as u8,
                        255 as u8,
                        120 as u8,
                        34 as u8
                    )
                    SDL_SetRenderDrawBlendMode(g_renderer, 2 as i32)
                    for particle = 0, particle < 6, particle++ {
                        val raw: f32 = gameTime * 0.55 + (index as f32) * 0.19 + (particle as f32) * 0.166
                        val phase: f32 = raw - (raw as i32) as f32
                        val px: i32 = screenX + (sinf(gameTime * 1.7 + (particle as f32) * 1.9 + (index as f32)) * 22.0) as i32
                        val py: i32 = (horizon + unit * 0.95 - phase * unit * 0.85) as i32
                        val alpha: u8 = ((1.0 - phase) * 130.0) as u8
                        fill_circle(
                            px,
                            py,
                            2 + (particle % 2),
                            90 as u8,
                            255 as u8,
                            140 as u8,
                            alpha
                        )
                    }
                    SDL_SetRenderDrawBlendMode(g_renderer, 0 as i32)
                }
            }
        }
    }

    SDL_SetRenderDrawBlendMode(g_renderer, 0 as i32)
}

fn render_gun(bobX: i32, bobY: i32, showFlash: bool) void = trust {
    val texture: ref void = current_gun_texture()
    if texture == none {
        return
    }

    val gunW: i32 = SCREEN_WIDTH * 7 / 10
    val gunH: i32 = gunW * gunTexH / gunTexW
    val equip: f32 = weaponEquip
    val lift: i32 = ((1.0 - equip) * (gunH as f32) * 0.92) as i32
    val sway: i32 = (sinf(gameTime * 8.0) * (1.0 - equip) * 34.0) as i32
    val gunX: i32 = (SCREEN_WIDTH - gunW) / 2 + bobX + sway
    val gunY: i32 = SCREEN_HEIGHT - gunH + bobY + 20 + lift

    g_dst_rect.x = gunX
    g_dst_rect.y = gunY
    g_dst_rect.w = gunW
    g_dst_rect.h = gunH
    SDL_RenderCopy(g_renderer, texture, none, g_dst_rect as ref void)

    if showFlash {
        val flashSize: i32 = 130
        val fX: i32 = gunX + gunW / 2 - flashSize / 2
        val fY: i32 = gunY - flashSize / 3
        val fr: u8 = 255
        val fg: mut u8 = 220
        val fb: mut u8 = 50
        if currentWeapon == WEAPON_SHOTGUN {
            fg = 168
            fb = 54
        } elif currentWeapon == WEAPON_PLASMA {
            fg = 210
            fb = 255
        }
        SDL_SetRenderDrawColor(g_renderer, fr, fg, fb, 255 as u8)
        g_aux_rect.x = fX
        g_aux_rect.y = fY
        g_aux_rect.w = flashSize
        g_aux_rect.h = flashSize
        SDL_RenderFillRect(g_renderer, g_aux_rect)
        SDL_SetRenderDrawColor(g_renderer, 255 as u8, 255 as u8, 220 as u8, 255 as u8)
        g_aux_rect.x = fX + flashSize / 4
        g_aux_rect.y = fY + flashSize / 4
        g_aux_rect.w = flashSize / 2
        g_aux_rect.h = flashSize / 2
        SDL_RenderFillRect(g_renderer, g_aux_rect)

        draw_glow(
            fX + flashSize / 2,
            fY + flashSize / 2,
            102,
            fr,
            fg,
            fb,
            105 as u8
        )
        draw_flare_chain(fX + flashSize / 2, fY + flashSize / 2, 0.36)
    }
}

fn render_damage() void = {
    if hitFlashTimer <= 0.0 {
        return
    }
    val alpha: u8 = ((hitFlashTimer * 280.0) as i32) as u8
    trust SDL_SetRenderDrawBlendMode(g_renderer, 1 as i32)
    trust SDL_SetRenderDrawColor(g_renderer, 175 as u8, 20 as u8, 20 as u8, alpha)
    g_aux_rect.x = 0
    g_aux_rect.y = 0
    g_aux_rect.w = SCREEN_WIDTH
    g_aux_rect.h = 22
    trust SDL_RenderFillRect(g_renderer, g_aux_rect)
    g_aux_rect.x = 0
    g_aux_rect.y = SCREEN_HEIGHT - 22
    g_aux_rect.w = SCREEN_WIDTH
    g_aux_rect.h = 22
    trust SDL_RenderFillRect(g_renderer, g_aux_rect)
    g_aux_rect.x = 0
    g_aux_rect.y = 0
    g_aux_rect.w = 22
    g_aux_rect.h = SCREEN_HEIGHT
    trust SDL_RenderFillRect(g_renderer, g_aux_rect)
    g_aux_rect.x = SCREEN_WIDTH - 22
    g_aux_rect.y = 0
    g_aux_rect.w = 22
    g_aux_rect.h = SCREEN_HEIGHT
    trust SDL_RenderFillRect(g_renderer, g_aux_rect)
    trust SDL_SetRenderDrawBlendMode(g_renderer, 0 as i32)
}

fn render_crosshair() void = {
