// 5x7 bitmap font, ASCII 32..126. Each glyph is seven rows of five bits,
// least-significant bit = leftmost column. Lowercase is folded to uppercase.
val FONT_GLYPHS: [95]u64 = [
    0, 134353028, 330, 217415040, 4777777604, 289881251, 1035966542, 132,
    138549380, 205656196, 145860, 139432064, 4429185024, 458752, 134217728, 2221019400,
    480623950, 1010962566, 505553167, 511981838, 301316492, 511981646, 480623694, 205664527,
    481638734, 210185582, 134221824, 4429189120, 25369344, 32537600, 3551328, 138555662,
    4227771840, 922040774, 532131183, 471926862, 515239279, 472320078, 69666894, 497912910,
    381136235, 474091662, 511975694, 918003179, 1008797762, 866123643, 385334635, 482209134,
    69692238, 9072143726, 918007151, 512104558, 138547359, 482209659, 216344955, 348126769,
    920852939, 138557787, 1042493727, 406982788, 8862701634, 205656196, 326, 0,
    6, 922040774, 532131183, 471926862, 515239279, 472320078, 69666894, 497912910,
    381136235, 474091662, 511975694, 918003179, 1008797762, 866123643, 385334635, 482209134,
    69692238, 9072143726, 918007151, 512104558, 138547359, 482209659, 216344955, 348126769,
    920852939, 138557787, 1042493727, 406984836, 4433514628, 205664388, 1015808,
]

fn get_enemy(i: i32) mut ref Enemy = {
    return trust @ptradd(enemies_buf, (i as usize) * @sizeof(Enemy)) as mut ref Enemy
}

fn get_bullet(i: i32) mut ref Bullet = {
    return trust @ptradd(bullets_buf, (i as usize) * @sizeof(Bullet)) as mut ref Bullet
}

fn wall_texture(index: i32) mut ref WallTexture = {
    return trust @ptradd(
        wallTextures as ref WallTexture,
        (index as usize) * @sizeof(WallTexture)
    ) as mut ref WallTexture
}

fn enemy_spawn(index: i32) mut ref SpawnPoint = {
    return trust @ptradd(
        enemySpawns as ref SpawnPoint,
        (index as usize) * @sizeof(SpawnPoint)
    ) as mut ref SpawnPoint
}

fn column_info(index: i32) mut ref ColumnInfo = {
    return trust @ptradd(
        g_columns,
        (index as usize) * @sizeof(ColumnInfo)
    ) as mut ref ColumnInfo
}

fn vertex_at(index: i32) mut ref SDL_Vertex = {
    return trust @ptradd(
        g_vertices,
        (index as usize) * @sizeof(SDL_Vertex)
    ) as mut ref SDL_Vertex
}

fn write_index(index: i32, value: i32) void = trust {
    @store32(
        @ptradd(g_indices, (index as usize) * @sizeof(i32)) as ref u32,
        value as u32
    )
}

fn tree_at(index: i32) mut ref Tree = {
    return trust @ptradd(trees as ref Tree, (index as usize) * @sizeof(Tree)) as mut ref Tree
}

fn pickup_at(index: i32) mut ref HealthPickup = {
    return trust @ptradd(
        healthPickups as ref HealthPickup,
        (index as usize) * @sizeof(HealthPickup)
    ) as mut ref HealthPickup
}

fn xp_orb_at(index: i32) mut ref XpOrb = {
    return trust @ptradd(
        xpOrbs as ref XpOrb,
        (index as usize) * @sizeof(XpOrb)
    ) as mut ref XpOrb
}

fn star_at(index: i32) mut ref Star = {
    return trust @ptradd(stars as ref Star, (index as usize) * @sizeof(Star)) as mut ref Star
}

fn billboard_at(list: ref Billboard, index: i32) mut ref Billboard = {
    return trust @ptradd(
        list as ref Billboard,
        (index as usize) * @sizeof(Billboard)
    ) as mut ref Billboard
}

fn rand_next() u32 = {
    rng = rng * 1664525 as u32 + 1013904223 as u32
    return rng
}

fn rand_unit() f32 = {
    return ((rand_next() % 10000) as f32) / 10000.0
}

fn play_sound(sound: ref void) void = {
    if sound != none {
        trust Mix_PlayChannel(-1 as i32, sound, 0 as i32)
    }
}

fn load_sound(path: ref u8, volume: i32) ref void = trust {
    val sound: ref void = Mix_LoadWAV(path)
    if sound != none {
        Mix_VolumeChunk(sound, volume)
    }
    return sound
}

fn font_glyph(c: u8) u64 = trust {
    val folded: mut i32 = c as i32
    if folded >= 97 && folded <= 122 {
        folded -= 32
    }
    val index: i32 = folded - 32
    if index < 0 || index >= 95 {
        return 0
    }
    return @load(@ptradd(FONT_GLYPHS as ref u64, (index as usize) * 8)) as u64
}

fn text_width(text: ref u8, scale: i32) i32 = trust {
    val count: i32 = @strlen(text) as i32
    if count <= 0 {
        return 0
    }
    return count * 6 * scale - scale
}

fn draw_text(
    x: i32,
    y: i32,
    text: ref u8,
    scale: i32,
    cr: u8,
    cg: u8,
    cb: u8,
    ca: u8
) void = trust {
    if scale < 1 {
        return
    }
    SDL_SetRenderDrawBlendMode(g_renderer, 1 as i32)
    SDL_SetRenderDrawColor(g_renderer, cr, cg, cb, ca)
    val penX: mut i32 = x
    val cursor: mut i64 = 0
    for {
        val c: u8 = @load8(@ptradd(text, cursor as usize))
        if c == 0 {
            break
        }
        val glyph: u64 = font_glyph(c)
        for row = 0, row < 7, row++ {
            val mask: u32 = ((glyph >> ((row * 5) as u64)) & 31 as u64) as u32
            val column: mut i32 = 0
            for column < 5 {
                val bitMask: u32 = 1 as u32 << (column as u32)
                if (mask & bitMask) == 0 {
                    column++
                } else {
                    val runStart: i32 = column
                    for {
                        column++
                        if column >= 5 {
                            break
                        }
                        val nextMask: u32 = 1 as u32 << (column as u32)
                        if (mask & nextMask) == 0 {
                            break
                        }
                    }
                    g_aux_rect.x = penX + runStart * scale
                    g_aux_rect.y = y + row * scale
                    g_aux_rect.w = (column - runStart) * scale
                    g_aux_rect.h = scale
                    SDL_RenderFillRect(g_renderer, g_aux_rect)
                }
            }
        }
        penX += 6 * scale
        cursor++
    }
    SDL_SetRenderDrawBlendMode(g_renderer, 0 as i32)
}

fn draw_text_centered(
    centerX: i32,
    y: i32,
    text: ref u8,
    scale: i32,
    cr: u8,
    cg: u8,
    cb: u8,
    ca: u8
) void = trust {
    val width: i32 = text_width(text, scale)
    draw_text(centerX - width / 2, y, text, scale, cr, cg, cb, ca)
}

fn draw_int(
    x: i32,
    y: i32,
    value: i32,
    scale: i32,
    cr: u8,
    cg: u8,
    cb: u8,
    ca: u8
) void = trust {
    val digits: mut [16]u8 = @zeroed
    val number: mut i32 = value
    val negative: bool = number < 0
    if negative {
        number = -number
    }

    val digitCount: mut i32 = 0
    if number == 0 {
        @store8(digits as ref u8, 48 as u8)
        digitCount = 1
    } else {
        for {
            if number <= 0 {
                break
            }
            val digit: i32 = number % 10
            @store8(@ptradd(digits as ref u8, digitCount as usize), (48 + digit) as u8)
            digitCount++
            number = number / 10
        }
    }

    val buffer: mut [24]u8 = @zeroed
    val position: mut i32 = 0
    if negative {
        @store8(buffer as ref u8, 45 as u8)
        position = 1
    }
    for i = 0, i < digitCount, i++ {
        val digit: u8 = @load8(@ptradd(
                digits as ref u8,
                (digitCount - 1 - i) as usize
            ))
        @store8(@ptradd(buffer as ref u8, (position + i) as usize), digit)
    }
    @store8(@ptradd(buffer as ref u8, (position + digitCount) as usize), 0 as u8)
    draw_text(x, y, buffer as ref u8, scale, cr, cg, cb, ca)
}

fn point_in(x: i32, y: i32, w: i32, h: i32, px: i32, py: i32) bool = {
    return px >= x && px < x + w && py >= y && py < y + h
}

fn draw_panel(x: i32, y: i32, w: i32, h: i32, cr: u8, cg: u8, cb: u8, ca: u8) void = trust {
    SDL_SetRenderDrawBlendMode(g_renderer, 1 as i32)
    SDL_SetRenderDrawColor(g_renderer, cr, cg, cb, ca)
    g_aux_rect.x = x
    g_aux_rect.y = y
    g_aux_rect.w = w
    g_aux_rect.h = h
    SDL_RenderFillRect(g_renderer, g_aux_rect)
    SDL_SetRenderDrawBlendMode(g_renderer, 0 as i32)
}

fn draw_border(
    x: i32,
    y: i32,
    w: i32,
    h: i32,
    thickness: i32,
    cr: u8,
    cg: u8,
    cb: u8,
    ca: u8
) void = trust {
    draw_panel(x, y, w, thickness, cr, cg, cb, ca)
    draw_panel(x, y + h - thickness, w, thickness, cr, cg, cb, ca)
    draw_panel(x, y, thickness, h, cr, cg, cb, ca)
    draw_panel(x + w - thickness, y, thickness, h, cr, cg, cb, ca)
}

fn draw_button(
    x: i32,
    y: i32,
    w: i32,
    h: i32,
    label: ref u8,
    hover: bool
) void = trust {
    if hover {
        draw_panel(x - 4, y - 4, w + 8, h + 8, 255 as u8, 190 as u8, 60 as u8, 105 as u8)
        draw_panel(x, y, w, h, 42 as u8, 34 as u8, 18 as u8, 245 as u8)
        draw_border(x, y, w, h, 3, 255 as u8, 205 as u8, 80 as u8, 255 as u8)
        draw_text_centered(
            x + w / 2,
            y + (h - 7 * 4) / 2,
            label,
            4,
            255 as u8,
            240 as u8,
            190 as u8,
            255 as u8
        )
    } else {
        draw_panel(x, y, w, h, 16 as u8, 20 as u8, 26 as u8, 230 as u8)
        draw_border(x, y, w, h, 2, 92 as u8, 112 as u8, 132 as u8, 255 as u8)
        draw_text_centered(
            x + w / 2,
            y + (h - 7 * 4) / 2,
            label,
            4,
            215 as u8,
            225 as u8,
            235 as u8,
            255 as u8
        )
    }
}

fn max_health() i32 = {
    return 100 + progress.healthLevel * 25
}

fn progress_checksum() u32 = {
    val hash: mut u32 = 2166136261 as u32
    hash = (hash ^ (progress.bestWave as u32)) * 16777619 as u32
    hash = (hash ^ (progress.xp as u32)) * 16777619 as u32
    hash = (hash ^ (progress.totalXp as u32)) * 16777619 as u32
    hash = (hash ^ (progress.shotgun as u32)) * 16777619 as u32
    hash = (hash ^ (progress.plasma as u32)) * 16777619 as u32
    hash = (hash ^ (progress.healthLevel as u32)) * 16777619 as u32
    hash = (hash ^ (progress.damageLevel as u32)) * 16777619 as u32
    hash = (hash ^ (progress.fireRateLevel as u32)) * 16777619 as u32
    hash = (hash ^ (progress.speedLevel as u32)) * 16777619 as u32
    return hash
}

fn progress_reset() void = {
    progress.magic = PROGRESS_MAGIC
    progress.version = PROGRESS_VERSION
    progress.checksum = 0
    progress.bestWave = 0
    progress.xp = 0
    progress.totalXp = 0
    progress.shotgun = 0
    progress.plasma = 0
    progress.healthLevel = 0
    progress.damageLevel = 0
    progress.fireRateLevel = 0
    progress.speedLevel = 0
}

fn save_progress() bool = trust {
    progress.magic = PROGRESS_MAGIC
    progress.version = PROGRESS_VERSION
    progress.checksum = progress_checksum()

    val size: i32 = @sizeof(Progress) as i32
    val raw: mut [64]u8 = @zeroed
    @memcpy(raw as ref void, @addr(progress) as ref void, size as usize)
    for i = 0, i < size, i++ {
        val mixed: u32 = (i as u32) * 73 as u32 + PROGRESS_XOR
        val key: u8 = (mixed & 255 as u32) as u8
        val b: u8 = @load8(@ptradd(raw as ref u8, i as usize))
        @store8(@ptradd(raw as ref u8, i as usize), b ^ key)
    }
    return fs.write_all_bytes(PROGRESS_PATH, raw as ref void, size as i64)
}

fn load_progress() void = trust {
    progress_reset()

    val size: mut i64 = 0
    match fs.file_size(PROGRESS_PATH) {
        none => {
            return
        }
        some found => {
            size = found
        }
    }
    if size < (@sizeof(Progress) as i64) {
        return
    }

    match fs.read_all_raw(PROGRESS_PATH) {
        none => {
            return
        }
        some data => {
            val count: i32 = @sizeof(Progress) as i32
            val raw: mut [64]u8 = @zeroed
            @memcpy(raw as ref void, data as ref void, count as usize)
            for i = 0, i < count, i++ {
                val mixed: u32 = (i as u32) * 73 as u32 + PROGRESS_XOR
                val key: u8 = (mixed & 255 as u32) as u8
                val b: u8 = @load8(@ptradd(raw as ref u8, i as usize))
                @store8(@ptradd(raw as ref u8, i as usize), b ^ key)
            }
            @memcpy(@addr(progress) as ref void, raw as ref void, count as usize)
            @free(data as ref void)
        }
    }

    if progress.magic != PROGRESS_MAGIC || progress.version != PROGRESS_VERSION || progress.checksum != progress_checksum() {
        progress_reset()
        return
    }

    if progress.bestWave < 0 {
        progress.bestWave = 0
    }
    if progress.xp < 0 {
        progress.xp = 0
    }
    if progress.healthLevel < 0 {
        progress.healthLevel = 0
    }
    if progress.healthLevel > MAX_HEALTH_LEVEL {
        progress.healthLevel = MAX_HEALTH_LEVEL
    }
    if progress.damageLevel < 0 {
        progress.damageLevel = 0
    }
    if progress.damageLevel > MAX_DAMAGE_LEVEL {
        progress.damageLevel = MAX_DAMAGE_LEVEL
    }
    if progress.fireRateLevel < 0 {
        progress.fireRateLevel = 0
    }
    if progress.fireRateLevel > MAX_FIRE_RATE_LEVEL {
        progress.fireRateLevel = MAX_FIRE_RATE_LEVEL
    }
    if progress.speedLevel < 0 {
        progress.speedLevel = 0
    }
    if progress.speedLevel > MAX_SPEED_LEVEL {
        progress.speedLevel = MAX_SPEED_LEVEL
    }
}

fn weapon_unlocked(index: i32) bool = {
    if index == WEAPON_MACHINE_GUN {
        return true
    }
    if index == WEAPON_SHOTGUN {
        return progress.shotgun != 0
    }
    if index == WEAPON_PLASMA {
        return progress.plasma != 0
    }
    return false
}

fn weapon_name(index: i32) ref u8 = {
    if index == WEAPON_SHOTGUN {
        return "SHOTGUN"
    }
    if index == WEAPON_PLASMA {
        return "PLASMA RIFLE"
    }
    return "MACHINE GUN"
}

fn weapon_shoot_sound(index: i32) ref void = {
    if index == WEAPON_SHOTGUN {
        return g_shootShotgunSound
    }
    if index == WEAPON_PLASMA {
        return g_shootPlasmaSound
    }
    return g_shootSound
}

fn weapon_switch_sound(index: i32) ref void = {
    if index == WEAPON_SHOTGUN {
        return g_switchShotgunSound
    }
    if index == WEAPON_PLASMA {
        return g_switchPlasmaSound
    }
    return g_switchMachineSound
}

fn weapon_cooldown(index: i32) f32 = {
    val multiplier: mut f32 = 1.0 - (progress.fireRateLevel as f32) * 0.08
    if multiplier < 0.60 {
        multiplier = 0.60
    }
    if index == WEAPON_SHOTGUN {
        return 0.88 * multiplier
    }
    if index == WEAPON_PLASMA {
        return 0.26 * multiplier
    }
    return 0.13 * multiplier
}

fn switch_weapon(index: i32) void = {
    if index < 0 || index > 2 {
        return
    }
    if !weapon_unlocked(index) {
        return
    }
    if index == currentWeapon && weaponEquip > 0.80 {
        return
    }
    currentWeapon = index
    weaponEquip = 0.0
    shotgunReloadTimer = 0.0
    shotgunReloadStage = 0
    play_sound(weapon_switch_sound(index))
}

fn current_gun_texture() ref void = {
    if currentWeapon == WEAPON_SHOTGUN {
        if shotgunReloadStage == 1 {
            return g_shotgunReload1Tex
        }
        if shotgunReloadStage == 2 {
            return g_shotgunReload2Tex
        }
        return g_shotgunTex
    }
    if currentWeapon == WEAPON_PLASMA {
        return g_plasmaTex
    }
    return g_machineGunTex
}

fn set_relative_mouse(enabled: bool) void = trust {
    val want: mut i32 = 0
    if enabled {
        want = 1
    }
    if relativeMouseMode != want {
        relativeMouseMode = want
        SDL_SetRelativeMouseMode(want)
    }
}

fn spawn_xp_orb(x: f32, y: f32, value: i32) void = {
    for i = 0, i < MAX_XP_ORBS, i++ {
        val orb: mut ref XpOrb = xp_orb_at(i)
        if orb.active == 0 {
            orb.x = x + (rand_unit() - 0.5) * 22.0
            orb.y = y + (rand_unit() - 0.5) * 22.0
            orb.value = value
            orb.phase = rand_unit() * 2.0 * PI
            orb.active = 1
            return
        }
    }
}

fn drop_enemy_xp(x: f32, y: f32) void = {
    val count: i32 = 2 + (rand_next() % 2) as i32
    val value: i32 = 3 + wave
    for i = 0, i < count, i++ {
        spawn_xp_orb(x, y, value)
    }
}

fn update_xp_orbs() void = {
    val pCX: f32 = player.x + 4.0
    val pCY: f32 = player.y + 4.0
    for i = 0, i < MAX_XP_ORBS, i++ {
        val orb: mut ref XpOrb = xp_orb_at(i)
        if orb.active != 0 {
            val dx: f32 = orb.x - pCX
            val dy: f32 = orb.y - pCY
            if dx * dx + dy * dy < 900.0 {
                orb.active = 0
                progress.xp += orb.value
                progress.totalXp += orb.value
                play_sound(g_xpSound)
            }
        }
    }
}

fn draw_diamond_geo(
    cx: i32,
    cy: i32,
    rx: i32,
    ry: i32,
    cr: u8,
    cg: u8,
    cb: u8,
    ca: u8
) void = trust {
    if rx < 1 || ry < 1 {
        return
    }
    SDL_SetRenderDrawBlendMode(g_renderer, 1 as i32)

    val top: mut ref SDL_Vertex = vertex_at(0)
    top.position.x = cx as f32
    top.position.y = (cy - ry) as f32
    top.color.r = cr
    top.color.g = cg
    top.color.b = cb
    top.color.a = ca
    top.tex_coord.x = 0.0
    top.tex_coord.y = 0.0

    val right: mut ref SDL_Vertex = vertex_at(1)
    right.position.x = (cx + rx) as f32
    right.position.y = cy as f32
    right.color.r = cr
    right.color.g = cg
    right.color.b = cb
    right.color.a = ca
    right.tex_coord.x = 0.0
    right.tex_coord.y = 0.0

    val bottom: mut ref SDL_Vertex = vertex_at(2)
    bottom.position.x = cx as f32
    bottom.position.y = (cy + ry) as f32
    bottom.color.r = cr
    bottom.color.g = cg
    bottom.color.b = cb
    bottom.color.a = ca
    bottom.tex_coord.x = 0.0
    bottom.tex_coord.y = 0.0

    val left: mut ref SDL_Vertex = vertex_at(3)
    left.position.x = (cx - rx) as f32
    left.position.y = cy as f32
    left.color.r = cr
    left.color.g = cg
    left.color.b = cb
    left.color.a = ca
    left.tex_coord.x = 0.0
    left.tex_coord.y = 0.0

    write_index(0, 0)
    write_index(1, 1)
    write_index(2, 2)
    write_index(3, 0)
    write_index(4, 2)
    write_index(5, 3)
    SDL_RenderGeometry(
        g_renderer,
        none as ref void,
        g_vertices as ref SDL_Vertex,
        4 as i32,
        g_indices as ref i32,
        6 as i32
    )
    SDL_SetRenderDrawBlendMode(g_renderer, 0 as i32)
}

fn draw_xp_symbol(cx: i32, cy: i32, size: i32, phase: f32) void = trust {
    val radius: mut i32 = size
    if radius < 3 {
        radius = 3
    }
    if radius > 74 {
        radius = 74
    }
    draw_glow(cx, cy, radius + 9, 255 as u8, 190 as u8, 54 as u8, 52 as u8)
    val spin: f32 = 0.28 + 0.72 * fabsf(cosf(gameTime * 3.7 + phase))
    val rx: i32 = ((radius as f32) * spin) as i32
    if rx > 0 {
        draw_diamond_geo(
            cx,
            cy,
            rx,
            radius,
            255 as u8,
            184 as u8,
            36 as u8,
            235 as u8
        )
        draw_diamond_geo(
            cx,
            cy,
            rx * 55 / 100,
            radius * 58 / 100,
            255 as u8,
            237 as u8,
            148 as u8,
            255 as u8
        )
    }
    for spark = 0, spark < 4, spark++ {
        val angle: f32 = gameTime * 2.4 + phase + (spark as f32) * (PI * 0.5)
        val distance: f32 = (radius as f32) * 0.94
        val sx: i32 = cx + (cosf(angle) * distance) as i32
        val sy: i32 = cy + (sinf(angle) * distance) as i32
        val twinkle: u8 = (110.0 + 145.0 * (0.5 + 0.5 * sinf(gameTime * 5.0 + phase + (spark as f32) * 1.7))) as u8
        fill_circle(sx, sy, 2, 255 as u8, 236 as u8, 150 as u8, twinkle)
    }
}

fn spawn_wave_enemy() bool = {
    for i = 0, i < MAX_ENEMIES, i++ {
        val enemy: mut ref Enemy = get_enemy(i)
        if enemy.alive == 0 {
            val spawnXVal: mut f32 = spawnX
            val spawnYVal: mut f32 = spawnY
            if enemySpawnCount > 0 {
                val pick: i32 = (rand_next() % (enemySpawnCount as u32)) as i32
                val spawn: ref SpawnPoint = enemy_spawn(pick)
                spawnXVal = spawn.x
                spawnYVal = spawn.y
            } else {
                val attempts: mut i32 = 0
                for attempts < 200 {
                    val cellX: i32 = (rand_next() % ((MAP_SIZE - 2) as u32)) as i32 + 1
                    val cellY: i32 = (rand_next() % ((MAP_SIZE - 2) as u32)) as i32 + 1
                    if map_at(cellX, cellY) == 0 {
                        val testX: f32 = (cellX as f32) * (TILE_SIZE as f32) + 32.0
                        val testY: f32 = (cellY as f32) * (TILE_SIZE as f32) + 32.0
                        val dx: f32 = testX - (player.x + 4.0)
                        val dy: f32 = testY - (player.y + 4.0)
                        if dx * dx + dy * dy > 16000.0 {
                            spawnXVal = testX
                            spawnYVal = testY
                            break
                        }
                    }
                    attempts++
                }
            }
            enemy.x = spawnXVal - 4.0
            enemy.y = spawnYVal - 4.0
            enemy.health = 3 + wave / 2 + wave / 5
            enemy.alive = 1
            enemy.shootTimer = 1.1 + rand_unit() * 1.6
            waveSpawned++
            return true
        }
    }
    return false
}

fn start_wave() void = trust {
    waveTarget = 4 + wave * 2
    waveKilled = 0
    waveSpawned = 0
    waveIntermission = 0.0
    for i = 0, i < MAX_ENEMIES, i++ {
        get_enemy(i).alive = 0
    }
    if wave > 1 {
        playerHealth += 15
        if playerHealth > max_health() {
            playerHealth = max_health()
        }
    }
    if progress.bestWave < wave {
        progress.bestWave = wave
    }
    save_progress()
    play_sound(g_waveSound)

    val initial: mut i32 = MAX_ENEMIES
    if waveTarget < initial {
        initial = waveTarget
    }
    for i = 0, i < initial, i++ {
        spawn_wave_enemy()
    }
}

fn start_game() void = trust {
    gameState = STATE_PLAYING
    set_relative_mouse(true)
    playerHealth = max_health()
    apply_spawn()
    playerZ = 0.0
    playerVZ = 0.0
    onGround = true
    wave = 1
    waveIntermission = 0.0
    currentWeapon = WEAPON_MACHINE_GUN
    weaponEquip = 0.0
    shotgunReloadTimer = 0.0
    shotgunReloadStage = 0
    for i = 0, i < MAX_BULLETS, i++ {
        get_bullet(i).alive = 0
    }
    for i = 0, i < MAX_XP_ORBS, i++ {
        xp_orb_at(i).active = 0
    }
    init_pickups()
    play_sound(g_switchMachineSound)
    start_wave()
}

fn on_enemy_killed(x: f32, y: f32) void = {
    waveKilled++
    drop_enemy_xp(x, y)
    if waveKilled >= waveTarget {
        waveIntermission = 3.0
    }
}

fn update_wave(dt: f32) void = {
    if waveIntermission > 0.0 {
        waveIntermission -= dt
        if waveIntermission <= 0.0 {
            wave++
            trust start_wave()
        }
        return
    }

    val alive: mut i32 = 0
    for i = 0, i < MAX_ENEMIES, i++ {
        if get_enemy(i).alive != 0 {
            alive++
        }
    }
    val remaining: i32 = waveTarget - waveSpawned
    val slots: i32 = MAX_ENEMIES - alive
    if remaining > 0 && slots > 0 {
        val count: mut i32 = remaining
        if slots < count {
            count = slots
        }
        for i = 0, i < count, i++ {
            spawn_wave_enemy()
        }
    }
}

fn shop_cost(item: i32) i32 = {
    if item == 0 {
        return 150
    }
    if item == 1 {
        return 400
    }
    if item == 2 {
        return 80 + progress.healthLevel * 60
    }
    if item == 3 {
        return 120 + progress.damageLevel * 80
    }
    if item == 4 {
        return 180 + progress.fireRateLevel * 120
    }
    if item == 5 {
        return 140 + progress.speedLevel * 100
    }
    return 0
}

fn shop_maxed(item: i32) bool = {
    if item == 2 {
        return progress.healthLevel >= MAX_HEALTH_LEVEL
    }
    if item == 3 {
        return progress.damageLevel >= MAX_DAMAGE_LEVEL
    }
    if item == 4 {
        return progress.fireRateLevel >= MAX_FIRE_RATE_LEVEL
    }
    if item == 5 {
        return progress.speedLevel >= MAX_SPEED_LEVEL
    }
    return false
}

fn shop_owned(item: i32) bool = {
    if item == 0 {
        return progress.shotgun != 0
    }
    if item == 1 {
        return progress.plasma != 0
    }
    return false
}

fn try_buy(item: i32) void = trust {
    if item < 0 || item > 5 {
        return
    }
    if shop_owned(item) || item > 1 && shop_maxed(item) {
        play_sound(g_clickSound)
        return
    }
    val cost: i32 = shop_cost(item)
    if progress.xp < cost {
        play_sound(g_clickSound)
        return
    }
    progress.xp -= cost
    if item == 0 {
        progress.shotgun = 1
    } elif item == 1 {
        progress.plasma = 1
    } elif item == 2 {
        progress.healthLevel++
        playerHealth += 25
        if playerHealth > max_health() {
            playerHealth = max_health()
        }
    } elif item == 3 {
        progress.damageLevel++
    } elif item == 4 {
        progress.fireRateLevel++
    } elif item == 5 {
        progress.speedLevel++
    }
    save_progress()
    play_sound(g_buySound)
}

fn menu_play_x() i32 = {
    return SCREEN_WIDTH / 2 - 190
}

fn menu_play_y() i32 = {
    return 520
}

fn menu_exit_y() i32 = {
    return 620
}

fn shop_row_x() i32 = {
    return 260
}

fn shop_row_y(index: i32) i32 = {
    return 250 + index * 98
}

fn shop_row_h() i32 = {
    return 86
}

fn shop_row_w() i32 = {
    return 760
}

fn update_menu() void = trust {
    if inputClick {
        if point_in(menu_play_x(), menu_play_y(), 380, 76, inputMouseX, inputMouseY) {
            play_sound(g_clickSound)
            start_game()
            return
        }
        if point_in(menu_play_x(), menu_exit_y(), 380, 76, inputMouseX, inputMouseY) {
            play_sound(g_clickSound)
            quitRequested = true
            return
        }
    }
    if inputEnterPressed {
        play_sound(g_clickSound)
        start_game()
        return
    }
    if inputEscapePressed {
        quitRequested = true
    }
}

fn update_shop() void = trust {
    if inputEPressed || inputEscapePressed {
        play_sound(g_clickSound)
        gameState = STATE_PLAYING
        set_relative_mouse(true)
        return
    }
    if inputNum1 {
        try_buy(0)
    } elif inputNum2 {
        try_buy(1)
    } elif inputNum3 {
        try_buy(2)
    } elif inputNum4 {
        try_buy(3)
    } elif inputNum5 {
        try_buy(4)
    } elif inputNum6 {
        try_buy(5)
    }
    if inputClick {
        for i = 0, i < 6, i++ {
            if point_in(
                shop_row_x(),
                shop_row_y(i),
                shop_row_w(),
                shop_row_h(),
                inputMouseX,
                inputMouseY
            ) {
                try_buy(i)
                break
            }
        }
    }
}

fn update_dead() void = trust {
    if inputClick || inputEnterPressed || inputEPressed || inputEscapePressed {
        play_sound(g_clickSound)
        gameState = STATE_MENU
        set_relative_mouse(false)
    }
}

fn enter_death() void = trust {
    gameState = STATE_DEAD
    set_relative_mouse(false)
    save_progress()
    play_sound(g_deathSound)
}

fn render_menu() void = trust {
    SDL_SetRenderDrawColor(g_renderer, 3 as u8, 4 as u8, 7 as u8, 255 as u8)
    SDL_RenderClear(g_renderer)

    for band = 0, band < 16, band++ {
        val t: f32 = (band as f32) / 15.0
        val cr: u8 = (5.0 + 10.0 * t) as u8
        val cg: u8 = (6.0 + 13.0 * t) as u8
        val cb: u8 = (14.0 + 24.0 * t) as u8
        SDL_SetRenderDrawColor(g_renderer, cr, cg, cb, 255 as u8)
        g_aux_rect.x = 0
        g_aux_rect.y = band * SCREEN_HEIGHT / 16
        g_aux_rect.w = SCREEN_WIDTH
        g_aux_rect.h = SCREEN_HEIGHT / 16 + 1
        SDL_RenderFillRect(g_renderer, g_aux_rect)
    }

    for i = 0, i < 96, i++ {
        val sx: i32 = (i * 173 + 37) % SCREEN_WIDTH
        val sy: i32 = (i * 97 + 23) % 470
        val twinkle: f32 = 0.35 + 0.65 * (0.5 + 0.5 * sinf(gameTime * 1.4 + (i as f32) * 0.7))
        val bright: u8 = (70.0 + 150.0 * twinkle) as u8
        SDL_SetRenderDrawColor(g_renderer, bright, bright, 255 as u8, 180 as u8)
        g_aux_rect.x = sx
        g_aux_rect.y = sy
        g_aux_rect.w = 2
        g_aux_rect.h = 2
        SDL_RenderFillRect(g_renderer, g_aux_rect)
    }

    draw_glow(SCREEN_WIDTH / 2, 215, 220, 126 as u8, 255 as u8, 198 as u8, 42 as u8)
    draw_text_centered(
        SCREEN_WIDTH / 2 + 5,
        170,
        "CUBEDOOM",
        12,
        8 as u8,
        10 as u8,
        14 as u8,
        255 as u8
    )
    draw_text_centered(
        SCREEN_WIDTH / 2,
        160,
        "CUBEDOOM",
        12,
        246 as u8,
        206 as u8,
        84 as u8,
        255 as u8
    )
    draw_text_centered(
        SCREEN_WIDTH / 2,
        300,
        "ARENA SURVIVAL",
        4,
        96 as u8,
        214 as u8,
        255 as u8,
        255 as u8
    )
    draw_text_centered(
        SCREEN_WIDTH / 2,
        370,
        "KILL WAVES. COLLECT XP. BUY GEAR.",
        2,
        150 as u8,
        163 as u8,
        178 as u8,
        255 as u8
    )

    val hoverPlay: bool = point_in(
        menu_play_x(),
        menu_play_y(),
        380,
        76,
        uiMouseX,
        uiMouseY
    )
    val hoverExit: bool = point_in(
        menu_play_x(),
        menu_exit_y(),
        380,
        76,
        uiMouseX,
        uiMouseY
    )
    draw_button(menu_play_x(), menu_play_y(), 380, 76, "PLAY GAME", hoverPlay)
    draw_button(menu_play_x(), menu_exit_y(), 380, 76, "EXIT", hoverExit)

    draw_text_centered(
        SCREEN_WIDTH / 2,
        780,
        "BEST WAVE",
        3,
        255 as u8,
        196 as u8,
        72 as u8,
        255 as u8
    )
    val bestWidth: i32 = text_width("BEST WAVE", 3)
    draw_int(
        SCREEN_WIDTH / 2 + bestWidth / 2 + 24,
        780,
        progress.bestWave,
        3,
        255 as u8,
        236 as u8,
        154 as u8,
        255 as u8
    )
    draw_text_centered(
        SCREEN_WIDTH / 2,
        840,
        "XP BANK",
        2,
        120 as u8,
        132 as u8,
        146 as u8,
        255 as u8
    )
    val xpWidth: i32 = text_width("XP BANK", 2)
    draw_int(
        SCREEN_WIDTH / 2 + xpWidth / 2 + 18,
        840,
        progress.xp,
        2,
        255 as u8,
        206 as u8,
        92 as u8,
        255 as u8
    )
}

